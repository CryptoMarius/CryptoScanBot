<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/avalonia"
        xmlns:vm="using:CryptoScanner.Visualisation.ViewModels"
        xmlns:views="using:CryptoScanner.Visualisation.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="950"
        Width="1300" Height="1000"
        x:DataType="vm:VisualisationViewModel"
        x:Class="CryptoScanner.Visualisation.Views.VisualisationWindow"
        Title="{Binding WindowTitle}">

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">
        
        <!-- Left Panel - Controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Width="220">
            <StackPanel Margin="8" Spacing="2">
                
                <!-- Symbol Selector -->
                <views:SymbolSelectorView DataContext="{Binding SymbolSelector}"/>

                <!-- Trend Settings -->
                <HeaderedContentControl Classes="groupbox" Header="Trend">
                    <StackPanel Margin="4" >
                        <ComboBox SelectedIndex="{Binding TrendSettings.TrendType, Mode=TwoWay}"
                                  FontSize="12">
                            <ComboBoxItem Content="Primary trend"/>
                            <ComboBoxItem Content="Secondary trend"/>
                        </ComboBox>
                        <CheckBox IsChecked="{Binding TrendSettings.ShowZigZag, Mode=TwoWay}"
                                  Content="Show zigzag"
                                  FontSize="12"/>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- FIB Settings -->
                <HeaderedContentControl Classes="groupbox" Header="FIB">
                    <StackPanel Margin="4" >
                        <ComboBox SelectedIndex="{Binding FibSettings.FibTrend, Mode=TwoWay}"
                                  FontSize="12">
                            <ComboBoxItem Content="Primary trend"/>
                            <ComboBoxItem Content="Secondary trend"/>
                        </ComboBox>
                        <CheckBox IsChecked="{Binding FibSettings.ShowFib, Mode=TwoWay}"
                                  Content="Show fib retracement"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding FibSettings.ShowZigZag, Mode=TwoWay}"
                                  Content="Show zigzag"
                                  FontSize="12"/>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Playback Controls -->
                <StackPanel Spacing="4">
                    <Panel Height="30">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="-" Width="30" 
                                    Command="{Binding PlaybackControls.ZoomInCommand}"/>
                            <Button Content="+" Width="30" 
                                    Command="{Binding PlaybackControls.ZoomOutCommand}"/>
                            <TextBlock Text="{Binding PlaybackControls.CurrentIntervalDisplay}" 
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>
                    </Panel>

                    <Panel Height="30">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="&lt;" Width="30" 
                                    Command="{Binding PlaybackControls.NavigateLeftCommand}"/>
                            <Button Content="&gt;" Width="30" 
                                    Command="{Binding PlaybackControls.NavigateRightCommand}"/>
                            <TextBlock Text="{Binding PlaybackControls.MaxTimeDisplay}" 
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>
                    </Panel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Spacing="4">
                    <Button Content="Refresh screen" 
                            Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="Calculate zones" 
                            Command="{Binding CalculateCommand}"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="Zoom last" 
                            Command="{Binding ZoomLastCommand}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Display Options -->
                <HeaderedContentControl Classes="groupbox" Header="Display">
                    <StackPanel Margin="4" Spacing="-10">
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowSmaLinesSbm, Mode=TwoWay}"
                                  Content="SBM SMA lines"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowNadarayaWatsonEnvelope, Mode=TwoWay}"
                                  Content="Nadaraya Watson Envelope"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowNadarayaWatsonEnvelopeRepainting, Mode=TwoWay}"
                                  Content="NWE Repainting"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowBollingerBand, Mode=TwoWay}"
                                  Content="Bollinger Band"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowDlzZones, Mode=TwoWay}"
                                  Content="DLZ Zones"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowFvgZones, Mode=TwoWay}"
                                  Content="FVG Zones"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowDtb, Mode=TwoWay}"
                                  Content="DTB"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowSignals, Mode=TwoWay}"
                                  Content="Signals"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowPivots, Mode=TwoWay}"
                                  Content="Pivots"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.Transparent, Mode=TwoWay}"
                                  Content="Transparent"
                                  FontSize="12"/>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Open Trading App -->
                <Button Content="Open trading app" 
                        Command="{Binding OpenTradingAppCommand}"
                        HorizontalAlignment="Stretch"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel - Chart -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" Margin="8">
            <oxy:PlotView Model="{Binding PlotModel}"/>
        </Border>

    </Grid>

</Window>
