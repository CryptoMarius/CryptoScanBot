<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="480"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:StrategySbmSettingsViewModel"
             x:Class="CryptoScanner.Settings.Views.StrategySbmSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="20">
            
            <!-- SBM1 Section -->
            <Grid ColumnDefinitions="200,80" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="SBM1" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Candle lookback:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sbm1CandlesLookbackCount, Mode=TwoWay}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" IsChecked="{Binding UseLowHigh, Mode=TwoWay}"
                      Content="Use low/high instead of open/close" FontSize="12"/>
            </Grid>
            

            <!-- SBM2 Section -->
            <Grid ColumnDefinitions="200,80" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="SBM2" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
    
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Percentage in relation to BB bands:" VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sbm2BbPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Candle lookback:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Sbm2CandlesLookbackCount, Mode=TwoWay}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
    
                <CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding Sbm2UseLowHigh, Mode=TwoWay}" Content="Use low/high instead of open/close" FontSize="12"/>
            </Grid>
            

            <!-- SBM3 Section -->
            <Grid ColumnDefinitions="200,80" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="SBM3" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Percentage BB stretching:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Sbm3CandlesBbRecoveryPercentage, Mode=TwoWay}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Candle lookback:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Sbm3CandlesLookbackCount, Mode=TwoWay}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
