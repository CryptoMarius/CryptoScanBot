<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:TraderStopLossViewModel"
             x:Class="CryptoScanner.Settings.Views.TraderStopLossView">

    <HeaderedContentControl Classes="groupbox" Header="Stop loss (not working)">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- Stop Loss Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Stop loss %:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" 
                         Text="{Binding StopLossPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <!-- Stop Loss Limit Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Stop loss limit %:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" 
                         Text="{Binding StopLossLimitPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12" />
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
