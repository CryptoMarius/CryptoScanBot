<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="80"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:BollingerBandViewModel"
             x:Class="CryptoScanner.Settings.Views.BollingerBandView">
<Grid ColumnDefinitions="Auto,60,*" RowDefinitions="Auto,Auto" Margin="5" RowSpacing="5">
        
        <!-- Length -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Length:" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox Grid.Row="0" Grid.Column="1"  Text="{Binding Length, Mode=TwoWay, TargetNullValue='14', FallbackValue='14'}" 
                 Width="60" Height="22" MinHeight="24" Watermark="14"
                 FontSize="12" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"/>

        <!-- Deviation -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Deviation:" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding Deviation, Mode=TwoWay, TargetNullValue='2.0', FallbackValue='2.0'}" 
                 Width="60" Height="22" MinHeight="24" Watermark="70"
                 FontSize="12" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"/>

    </Grid>

</UserControl>
