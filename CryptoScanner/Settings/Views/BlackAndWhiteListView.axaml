<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200" 
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:BlackAndWhiteListViewModel"
             x:Class="CryptoScanner.Settings.Views.BlackAndWhiteListView">

        <Grid RowDefinitions="30,*">
            <TextBlock Grid.Row="0" Text="(1 symbol per line with optional comments)" 
                    VerticalAlignment="Center" 
                    Margin="10,10,10,0"/>
            
            <TextBox Grid.Row="1" Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True"
                    Watermark="COINUSDT Put your comments behind it if needed" CornerRadius="4"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="0" MinWidth="0" Margin="10"/>
        </Grid>

</UserControl>
