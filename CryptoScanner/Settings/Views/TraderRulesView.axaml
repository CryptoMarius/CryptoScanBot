<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:TraderRulesViewModel"
             x:Class="CryptoScanner.Settings.Views.TraderRulesView">

    <HeaderedContentControl Classes="groupbox" Header="Trading rules">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- Add/Remove Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Add rule" 
                        Command="{Binding AddRuleCommand}"
                        Width="130"
                        FontSize="12"/>
                <Button Content="Remove rule" 
                        Command="{Binding RemoveRuleCommand}"
                        Width="130"
                        FontSize="12"/>
            </StackPanel>

            <!-- Trading Rules List -->
            <ScrollViewer MinHeight="400" MinWidth="400" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TraderRuleItemViewModel">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Header}" 
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    
                                    <!-- Symbol -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Symbol:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding Symbol, Mode=TwoWay}" 
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>

                                    <!-- Candles -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Candles:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding Candles, Mode=TwoWay}" 
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>

                                    <!-- Interval -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Interval:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <ComboBox Grid.Column="2" 
                                                  ItemsSource="{Binding IntervalList}"
                                                  SelectedValue="{Binding Interval, Mode=TwoWay}"
                                                  DisplayMemberBinding="{Binding Key}"
                                                  SelectedValueBinding="{Binding Value}"
                                                  FontSize="12"/>
                                    </Grid>

                                    <!-- Percentage -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Percentage:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding Percentage, Mode=TwoWay, StringFormat=N2}" 
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>

                                    <!-- Cooldown -->
                                    <Grid ColumnDefinitions="Auto,*,130,Auto" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Cooldown:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding CoolDown, Mode=TwoWay}" 
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="Minuten" 
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
