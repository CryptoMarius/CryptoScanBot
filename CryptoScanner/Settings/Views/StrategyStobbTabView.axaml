<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             xmlns:settings="using:CryptoScanner.Settings.Views"
             x:DataType="vm:StrategyStobbTabViewModel"
             x:Class="CryptoScanner.Settings.Views.StrategyStobbTabView">

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
        <settings:SoundAndColorsView Grid.Row="0" DataContext="{Binding SoundAndColorsViewModel}" />
        <settings:StrategyStobbSettingsView Grid.Row="1" DataContext="{Binding StrategyStobbSettingsViewModel}" />
    </Grid>

</UserControl>
