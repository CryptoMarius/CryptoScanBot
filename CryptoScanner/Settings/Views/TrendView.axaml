<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="90"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:TrendViewModel"
             x:Class="CryptoScanner.Settings.Views.TrendView">
<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="5" RowSpacing="5">
        
        <!-- Length -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Use primary trend:" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <CheckBox Grid.Row="0" Grid.Column="1"  IsChecked="{Binding UsePrimaryTrend, Mode=TwoWay}" 
                 Width="60" Height="22" MinHeight="26" 
                 FontSize="12" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"/>

        <!-- %D -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Use high/low:" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <CheckBox Grid.Row="1" Grid.Column="1" 
                 IsChecked="{Binding UseHighLow, Mode=TwoWay}" 
                 Width="60" Height="22" MinHeight="26" 
                 FontSize="12" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"/>

    </Grid>

</UserControl>
