<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:controls="using:Avalonia.Controls"
             xmlns:settings="using:CryptoScanner.Settings.Views"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:AnalyzerTabViewModel"
             x:Class="CryptoScanner.Settings.Views.AnalyzerTabView">

    <TabControl Grid.Row="2" Margin="0" >
		<TabItem Header="Analyze common" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" >
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                <settings:AnalyzerCommonView DataContext="{Binding AnalyzerCommonViewModel}" />
                </WrapPanel>
            </ScrollViewer>
		</TabItem>
		<TabItem Header="Analyze long" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="4">
                    <settings:StrategyView Grid.Column="0" DataContext="{Binding AnalyzerStrategyLongViewModel}" />
                    <settings:TrendIntervalFilterView Grid.Column="1" DataContext="{Binding AnalyzerTrendIntervalFilterShortViewModel}" />
                    <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">
                        <settings:BarometerFilterView DataContext="{Binding AnalyzerBarometerFilterLongViewModel}" />
                        <settings:IntervalView DataContext="{Binding AnalyzerIntervalLongViewModel}" />
                    </StackPanel>
                    <settings:MarketTrendFilterView Grid.Column="3" VerticalAlignment="Top" DataContext="{Binding AnalyzerMarketTrendFilterLongViewModel}" />
                </Grid>
            </ScrollViewer>
		</TabItem>
		<TabItem Header="Analyze short" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="4">
                    <settings:StrategyView Grid.Column="0" DataContext="{Binding AnalyzerStrategyShortViewModel}" />
                    <settings:TrendIntervalFilterView Grid.Column="1" DataContext="{Binding AnalyzerTrendIntervalFilterShortViewModel}" />
                    <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">
                        <settings:BarometerFilterView DataContext="{Binding AnalyzerBarometerFilterShortViewModel}" />
                        <settings:IntervalView DataContext="{Binding AnalyzerIntervalShortViewModel}" />
                    </StackPanel>
                    <settings:MarketTrendFilterView Grid.Column="3" VerticalAlignment="Top" DataContext="{Binding AnalyzerMarketTrendFilterShortViewModel}" />
                </Grid>
            </ScrollViewer>
		</TabItem>
    </TabControl>				

</UserControl>
