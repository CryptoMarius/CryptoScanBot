<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             xmlns:settings="using:CryptoScanner.Settings.Views"
             x:DataType="vm:StrategyStorsiTabViewModel"
             x:Class="CryptoScanner.Settings.Views.StrategyStorsiTabView">

    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="5">
        <settings:SoundAndColorsView Grid.Row="0" DataContext="{Binding SoundAndColorsViewModel}" />
        <settings:StrategyStorsiSettingsView Grid.Row="1" DataContext="{Binding StrategyStorsiSettingsViewModel}" />
    </Grid>

</UserControl>
