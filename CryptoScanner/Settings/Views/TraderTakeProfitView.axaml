<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             xmlns:vm="using:CryptoScanner.Settings.ViewModels"
             x:DataType="vm:TraderTakeProfitViewModel"
             x:Class="CryptoScanner.Settings.Views.TraderTakeProfitView">

    <HeaderedContentControl Classes="groupbox" Header="Take profit">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- Order Type -->
            <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Order Type:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding OrderTypeList}"
                          SelectedValue="{Binding TakeProfitOrderType, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Key}"
                          SelectedValueBinding="{Binding Value}"
                          FontSize="12"/>
            </Grid>

            <!-- Strategy -->
            <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Strategy:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding StrategyList}"
                          SelectedValue="{Binding TakeProfitStrategy, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Key}"
                          SelectedValueBinding="{Binding Value}"
                          FontSize="12"/>
            </Grid>

            <!-- Profit Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Profit %:" VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" 
                         Text="{Binding ProfitPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%"  VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <!-- Add Dust to TP -->
            <CheckBox IsChecked="{Binding AddDustToTp, Mode=TwoWay}"
                      Content="Add dust to TP"
                      FontSize="12"/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
