<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CryptoScanner.BrowserView.Views.BrowserView">

    <DockPanel>
        <!-- KeyDown="OnAddressTextBoxKeyDown" -->
        <TextBox x:Name="addressTextBox" DockPanel.Dock="Top"  />
        <Decorator x:Name="browserWrapper"/>
    </DockPanel>
</UserControl>