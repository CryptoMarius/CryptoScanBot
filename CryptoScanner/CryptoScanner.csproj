<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageIcon>FacIcon1.jpg</PackageIcon>
		<TargetFramework>net8.0</TargetFramework>
		<RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;linux-x64</RuntimeIdentifiers>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
		<ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Single file basis -->
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<!-- Belangrijk: schakel default content uit om duplicaten te voorkomen -->
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		
		<!-- Assembly Version Info -->
		<AssemblyVersion>2.5.5.0</AssemblyVersion>
		<FileVersion>2.5.5.0</FileVersion>
		<Version>2.5.5</Version>

		<!-- Product Info -->
		<Product>CryptoScanBot</Product>
		<Company>Marius</Company>
		<Copyright>Copyright © 2026 Marius</Copyright>
		<Description>Crypto scanner and trading bot</Description>

		<!-- Optional -->
		<Authors>Marius</Authors>
		<PackageProjectUrl>https://github.com/CryptoMarius/CryptoScanBot</PackageProjectUrl>
		<Configurations>Debug;Release</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<!-- Alles wat je als "Content" hebt ingesteld in VS komt naast de .exe te staan -->
		<!-- We specificeren expliciet de mappen die je wilt -->
		<Content Update="Help\**\*.*">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>

		<Content Update="Sounds\**\*.*">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<PropertyGroup>
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
		<AssemblyName>CryptoScanBot</AssemblyName>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.17" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.0.726401" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
		<PackageReference Include="Oxyplot.Avalonia" Version="2.1.0-avalonia11" />
		<PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.8" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.8" />
		<PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
		<PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
	</ItemGroup>

