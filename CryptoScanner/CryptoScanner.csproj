<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageIcon>FacIcon1.jpg</PackageIcon>
		<TargetFramework>net8.0</TargetFramework>
		<RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;linux-x64</RuntimeIdentifiers>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
		<ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Single file basis -->
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<!-- Belangrijk: schakel default content uit om duplicaten te voorkomen -->
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		
		<!-- Version / Company / Copyright / Authors are shared via Directory.Build.props -->

		<!-- Product Info (project specific) -->
		<Product>CryptoScanBot</Product>
		<Description>Crypto scanner and trading bot</Description>
		<PackageProjectUrl>https://github.com/CryptoMarius/CryptoScanBot</PackageProjectUrl>
		<Configurations>Debug;Release</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<!-- Alles wat je als "Content" hebt ingesteld in VS komt naast de .exe te staan -->
		<!-- We specificeren expliciet de mappen die je wilt -->
		<Content Update="Help\**\*.*">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>

		<Content Update="Sounds\**\*.*">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>

	<PropertyGroup>
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
		<AssemblyName>CryptoScanBot</AssemblyName>
	</PropertyGroup>


