<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageIcon>FacIcon1.jpg</PackageIcon>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Assembly Version Info -->
		<AssemblyVersion>3.1.9.0</AssemblyVersion>
		<FileVersion>3.1.9.0</FileVersion>
		<Version>3.1.9</Version>

		<!-- Product Info -->
		<Product>CryptoScanBot</Product>
		<Company>Marius</Company>
		<Copyright>Copyright © 2026 Marius</Copyright>
		<Description>Cryptoscanner and trading bot</Description>

		<!-- Optional -->
		<Authors>Marius</Authors>
		<PackageProjectUrl>https://github.com/CryptoMarius/CryptoScanBot</PackageProjectUrl>
	</PropertyGroup>

	
	<PropertyGroup>
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
	</PropertyGroup>
	
	<ItemGroup>
	  <Compile Remove="Signal\Common\ExtendedColumnDefinitionInfo.cs" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<DefineConstants>$(DefineConstants);MACOS</DefineConstants>
	</PropertyGroup>


