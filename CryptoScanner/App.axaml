<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CryptoScanner.App"
             xmlns:helper="using:CryptoScanner.Helpers"
             xmlns:converter="using:CryptoScanner.Converters"
             RequestedThemeVariant="Default">
    
    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Light theme resources -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LowVolumeBrush">#E61A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="NormalVolumeBrush">#202020</SolidColorBrush>
                    
                    <!-- Price change colors -->
                    <SolidColorBrush x:Key="PriceUpBrush">#439982</SolidColorBrush>
                    <SolidColorBrush x:Key="PriceDownBrush">#c95b5c</SolidColorBrush>
                    <SolidColorBrush x:Key="PriceNeutralBrush">#202020</SolidColorBrush>

                    <SolidColorBrush x:Key="AlternatingBrushColor" Color="#FBFBFB"/>
                </ResourceDictionary>
                
                <!-- Dark theme resources -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LowVolumeBrush">#FF4444</SolidColorBrush>
                    <SolidColorBrush x:Key="NormalVolumeBrush">#E0E0E0</SolidColorBrush>
                    
                    <!-- Price change colors (aangepast voor dark mode) -->
                    <SolidColorBrush x:Key="PriceNeutralBrush">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="PriceUpBrush">#45c173</SolidColorBrush>
                    <SolidColorBrush x:Key="PriceDownBrush">#cd4040</SolidColorBrush>

                    <SolidColorBrush x:Key="AlternatingBrushColor" Color="#121212"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
    

    <Application.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://OxyPlot.Avalonia/Themes/Default.axaml"/>

        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Light mode: kies een lichtere accentkleur -->
                <ColorPaletteResources x:Key="Light" Accent="#FF60A0FF" />  <!-- Lichtere blauw, pas aan naar wens (bijv. #FFA0C0FF voor nog lichter) -->

                <!-- Dark mode: behoud standaard of pas aan -->
                <ColorPaletteResources x:Key="Dark" Accent="#FF0078D7" />  <!-- Standaard blauw, of donkerder -->
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- ============================================ -->
        <!-- Common theming -->
        <!-- ============================================ -->
        
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <!-- Title bar theme-aware styling -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        </Style>


        <!-- Globale style voor TextBlock -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Optioneel: Voor andere controls zoals Button, Label, etc. -->
        <Style Selector="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="Label">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBox:not(:multiline)">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============================================ -->
        <!-- Dashboard theming -->
        <!-- ============================================ -->
        
        <!-- Alle TextBlocks in dashboard krijgen margin en vertical alignment -->
        <Style Selector="TextBlock.dashboard">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        <!-- Labels (kolom 0) -->
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="2" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        
        <!-- Values (kolom 1) -->
        <Style Selector="TextBlock.value">
            <Setter Property="Margin" Value="2" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- ============================================ -->
        <!-- WINFORMS-STYLE GROUPBOX (HeaderedContentControl) -->
        <!-- ============================================ -->
        
        <Style Selector="HeaderedContentControl.groupbox">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="4,10,4,4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <!-- Main border (with gap at top for header) -->
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,8,0,0">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                        
                        <!-- Header text positioned over the border -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                Padding="5,0"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding Header}" FontSize="12"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>


    </Application.Styles>
</Application>