<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:CryptoScanner.ViewModels"
		mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
		x:Class="CryptoScanner.Views.AssetWindow"
		x:DataType="vm:AssetWindowViewModel"
		x:CompileBindings="False"
		Title="Paper assets"
		Width="720" Height="440" MinWidth="600" MinHeight="320"
		WindowStartupLocation="CenterOwner" CanResize="True" ShowInTaskbar="False">

	<!-- Border around entire content -->
	<Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
	<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10" RowSpacing="8">

		<TextBlock Grid.Row="0" Text="{Binding Summary}" Foreground="Gray" FontSize="11"
				   VerticalAlignment="Center"/>

		<!-- The balances. Only Total is editable: Locked follows from the orders that are open
			 right now and Free follows from Total minus Locked. -->
		<Border Grid.Row="1" BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
			<DataGrid ItemsSource="{Binding Assets}"
					  AutoGenerateColumns="False"
					  CanUserReorderColumns="False"
					  CanUserResizeColumns="True"
					  CanUserSortColumns="False"
					  GridLinesVisibility="Horizontal"
					  HeadersVisibility="Column">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Asset" Binding="{Binding Name}" IsReadOnly="True" Width="120"/>

					<!-- Template columns because amounts belong on the right, and a DataGridTextColumn
						 cannot align its contents. Total shows the rounded text and is edited as text,
						 so what is typed is what the cell showed. -->
					<!-- What a reset hands out for this coin: the default paper assets, edited here and saved
						 in the settings of the exchange. Next to Total so the start and the balance are seen
						 together. 0 means the coin gets nothing on a reset. -->
					<DataGridTemplateColumn Header="Default" Width="120">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<TextBlock Text="{Binding DefaultText}" VerticalAlignment="Center"
										   HorizontalAlignment="Right" Margin="0,0,4,0"
										   ToolTip.Tip="What a reset hands out for this coin. Edit it and press Apply; it is saved in the settings."/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<TextBox Text="{Binding DefaultText, Mode=TwoWay}" VerticalAlignment="Center"
										 HorizontalContentAlignment="Right"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Header="Total" Width="130">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<TextBlock Text="{Binding TotalText}" VerticalAlignment="Center"
										   HorizontalAlignment="Right" Margin="0,0,4,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<TextBox Text="{Binding TotalText, Mode=TwoWay}" VerticalAlignment="Center"
										 HorizontalContentAlignment="Right"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Header="Locked" Width="120" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<TextBlock Text="{Binding LockedText}" VerticalAlignment="Center"
										   HorizontalAlignment="Right" Margin="0,0,4,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Header="Free" Width="*" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<TextBlock Text="{Binding FreeText}" VerticalAlignment="Center"
										   HorizontalAlignment="Right" Margin="0,0,4,0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Take the coin out of the paper account. Same as correcting it to zero and
						 pressing Apply, but without having to know that. -->
					<DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:AssetRowViewModel">
								<Button Content="Remove" Padding="6,1" FontSize="11"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										Click="OnRemoveClick"
										ToolTip.Tip="Take this coin out of the paper account. It is recorded as a manual correction, so the capital line does not read it as a loss."/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<!-- Book a balance by hand. The only way to get a coin into the list that is not in it: a
			 balance that reaches zero is dropped, so it cannot be corrected in the grid either. -->
		<Grid Grid.Row="2" ColumnDefinitions="Auto,90,Auto,120,Auto,120,*">
			<TextBlock Grid.Column="0" Text="Add asset:" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox Grid.Column="1" Text="{Binding NewAssetName}" Watermark="BTC"
					 ToolTip.Tip="The coin to book a balance for. A coin that is already in the list is set to this amount."/>
			<TextBlock Grid.Column="2" Text="Amount:" VerticalAlignment="Center" Margin="12,0,8,0"/>
			<TextBox Grid.Column="3" Text="{Binding NewAssetAmount}" HorizontalContentAlignment="Right"
					 ToolTip.Tip="The balance in the coin itself. May be left empty when only a default is added."/>
			<TextBlock Grid.Column="4" Text="Default:" VerticalAlignment="Center" Margin="12,0,8,0"/>
			<TextBox Grid.Column="5" Text="{Binding NewAssetDefault}" HorizontalContentAlignment="Right"
					 ToolTip.Tip="What a reset hands out for this coin, saved in the settings. May be left empty; a coin with only a default is fine too."/>
			<Button Grid.Column="6" Content="Add" Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnAddClick"
					ToolTip.Tip="Book this balance. It is recorded as a manual correction, so the capital line does not read it as profit."/>
		</Grid>

		<!-- Action buttons. Start over sits on the left, apart from the everyday buttons. The amounts
			 it hands out are the default assets of the settings (trader, asset management); this
			 window has no amount of its own any more. -->
		<Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
			<Button Grid.Column="0" Content="Reset to defaults" HorizontalContentAlignment="Center" Click="OnResetClick"
					ToolTip.Tip="Throw every paper balance away and hand out the amounts of the Default column again."/>
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
				<Button Content="Refresh" HorizontalContentAlignment="Center" Click="OnRefreshClick" Width="90"
						ToolTip.Tip="Read the balances again. The trader keeps changing them while this window is open; unapplied edits in the list are discarded."/>
				<Button Content="Apply" HorizontalContentAlignment="Center" Click="OnApplyClick" Width="90"
						ToolTip.Tip="Save the amounts changed in the Total and Default columns. Rows that were not changed are left alone."/>
				<Button Content="Close" HorizontalContentAlignment="Center" Click="OnCloseClick" Width="90"/>
			</StackPanel>
		</Grid>

	</Grid>
	</Border>
</Window>
