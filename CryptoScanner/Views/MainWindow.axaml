<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{Binding Title}" Width="1500" Height="800" FontSize="10"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaChromeHints="PreferSystemChrome"
		ExtendClientAreaTitleBarHeightHint="-1"
		xmlns:views="using:CryptoScanner.Views"
		xmlns:vm="using:CryptoScanner.ViewModels"
		xmlns:controls="using:CryptoScanner.Controls"
		x:Class="CryptoScanner.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Panel>
		<DockPanel>

			<!-- Custom titlebar overlay on top of system chrome -->
			<Grid DockPanel.Dock="Top" Height="38" Name="TitleBarGrid">
				<!-- Background layer: fully transparent to hit testing → allows system chrome to handle dragging -->
				<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" IsHitTestVisible="False"/>

				<!-- Titlebar content (on top of the background) -->
				<Grid ColumnDefinitions="Auto,Auto,*,Auto">

					<!-- Menu Foreground="White" -->
					<Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent" FontSize="12">
						<MenuItem x:Name="MenuFile" Header="_File">
							<MenuItem Header="Analyzer active" ToggleType="CheckBox" IsChecked="{Binding AnalyzerActive, Mode=TwoWay}"/>
							<MenuItem Header="Trader active" ToggleType="CheckBox" IsChecked="{Binding TraderActive, Mode=TwoWay}"/>
							<MenuItem Header="Play sounds" ToggleType="CheckBox" IsChecked="{Binding SoundsActive, Mode=TwoWay}"/>
						</MenuItem>
						<MenuItem x:Name="MenuTools" Header="_Tools">
						</MenuItem>
						<MenuItem x:Name="MenuHelp" Header="_Help">
						</MenuItem>
					</Menu>


					<!-- Center: Title -->
					<TextBlock Grid.Column="2" Text="{Binding $parent[Window].Title}"
							   VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12" Margin="20,0,0,0"/>

					<!-- Right: Reserved space for system window buttons -->
					<Border Grid.Column="3" Width="138" Background="Transparent"/>
				</Grid>
			</Grid>

			<!-- Main Content -->
			<Grid RowDefinitions="125,1,*">

				<!-- The top dashboard -->
				<Grid Grid.Row="0">
					<Panel Height="130">
						<views:DashBoardInformationView DataContext="{Binding DashBoardInformationViewModel}" />
					</Panel>
				</Grid>

				<!-- Separator line -->
				<Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Height="1" Margin="0,0"/>

				<Grid Grid.Row="2" Name="MainGrid" ColumnDefinitions="300,4,1,*">

					<!-- The symbols on the left -->
					<Grid Grid.Column ="0" x:Name="SymbolSplitView" RowDefinitions="48,*">
							<Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto">
								<TextBlock Grid.Column="0" Text="Symbols" FontSize="15" FontWeight="Bold" Margin="10,0,0,2"/>
								<TextBlock Grid.Column="1" Text="Filter:" FontSize="12" HorizontalAlignment="Left" Margin="10"/>
								<TextBox Grid.Column="2" FontSize="12" x:Name="FilterTextBox" BorderThickness="0" HorizontalAlignment="Left" Margin="10" Width="100" Height="15"
										 Text="{Binding SymbolFilterText}">
									<TextBox.KeyBindings>
										<KeyBinding Gesture="Enter" Command="{Binding ApplyFilterCommand}" CommandParameter="{Binding #FilterTextBox.Text}"/>
									</TextBox.KeyBindings>
								</TextBox>
							</Grid>
						<views:SymbolGridView Grid.Row="1" DataContext="{Binding SymbolGridViewModel}"/>
					</Grid>

					<!-- Splitter between symbols and the signals -->
					<GridSplitter Grid.Column="1" ResizeDirection="Columns" DragCompleted="OnGridSplitterDragCompleted"/>
					<Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="0,0,0,2"/>

					<!-- Main screen -->
					<Grid Grid.Column="3" RowDefinitions="Auto,1,*">

						<!-- Tab headers -->
						<TabControl x:Name="MainTabs" Grid.Row="0" TabStripPlacement="Top" SelectedIndex="{Binding SelectedTabIndex}">
							<TabItem Header="Signals" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
							<TabItem Header="Tradingview" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
							<TabItem Header="Live Data" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
							<TabItem Header="Dashboard" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
							<TabItem Header="Open positions" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
							<TabItem Header="Closed positions" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
							<TabItem Header="Log" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
						</TabControl>

						<!-- Permanent browser (1×1 pixel, alway's visible) --> 
						<views:BrowserView x:Name="BrowserViewHost" Grid.Row="2" DataContext="{Binding BrowserViewModel}" />

						<!-- Content area -->
						<ContentPresenter x:Name="MainContent" Grid.Row="2"/>

					</Grid>

				</Grid>
			</Grid>
		</DockPanel>

		<!-- Border Overlay (layer 2 - on top) -->
		<!-- IsHitTestVisible="False" allows clicks to pass through to content below -->
		<Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"  BorderThickness="1"
				Background="Transparent" IsHitTestVisible="False"/>
	</Panel>
</Window>