<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CryptoScanner.Views.LoadingCandlesticksView">

    <UserControl.Styles>

        <!-- Candle 1: Bear, delay 0.0s — falls from tall to short -->
        <Style Selector="Border#C1Body">
            <Setter Property="Height" Value="50"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut" Delay="0:0:0.0">
                    <KeyFrame Cue="0%">  <Setter Property="Height" Value="50"/></KeyFrame>
                    <KeyFrame Cue="50%"> <Setter Property="Height" Value="16"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="50"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Candle 2: Bull, delay 0.2s — rises from short to tall -->
        <Style Selector="Border#C2Body">
            <Setter Property="Height" Value="30"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut" Delay="0:0:0.2">
                    <KeyFrame Cue="0%">  <Setter Property="Height" Value="30"/></KeyFrame>
                    <KeyFrame Cue="50%"> <Setter Property="Height" Value="58"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="30"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Candle 3: Bear, delay 0.4s -->
        <Style Selector="Border#C3Body">
            <Setter Property="Height" Value="42"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut" Delay="0:0:0.4">
                    <KeyFrame Cue="0%">  <Setter Property="Height" Value="42"/></KeyFrame>
                    <KeyFrame Cue="50%"> <Setter Property="Height" Value="20"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="42"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Candle 4: Bull, delay 0.6s -->
        <Style Selector="Border#C4Body">
            <Setter Property="Height" Value="22"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut" Delay="0:0:0.6">
                    <KeyFrame Cue="0%">  <Setter Property="Height" Value="22"/></KeyFrame>
                    <KeyFrame Cue="50%"> <Setter Property="Height" Value="52"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="22"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Candle 5: Bear, delay 0.8s -->
        <Style Selector="Border#C5Body">
            <Setter Property="Height" Value="46"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut" Delay="0:0:0.8">
                    <KeyFrame Cue="0%">  <Setter Property="Height" Value="46"/></KeyFrame>
                    <KeyFrame Cue="50%"> <Setter Property="Height" Value="14"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="46"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Candle 1: Bearish (red) -->
        <Grid Width="16" Height="70">
            <Rectangle Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#555"/>
            <Border x:Name="C1Body" Width="16" VerticalAlignment="Center"
                    Background="#cd4040" CornerRadius="2"/>
        </Grid>

        <!-- Candle 2: Bullish (green) -->
        <Grid Width="16" Height="70">
            <Rectangle Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#555"/>
            <Border x:Name="C2Body" Width="16" VerticalAlignment="Center"
                    Background="#45c173" CornerRadius="2"/>
        </Grid>

        <!-- Candle 3: Bearish (red) -->
        <Grid Width="16" Height="70">
            <Rectangle Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#555"/>
            <Border x:Name="C3Body" Width="16" VerticalAlignment="Center"
                    Background="#cd4040" CornerRadius="2"/>
        </Grid>

        <!-- Candle 4: Bullish (green) -->
        <Grid Width="16" Height="70">
            <Rectangle Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#555"/>
            <Border x:Name="C4Body" Width="16" VerticalAlignment="Center"
                    Background="#45c173" CornerRadius="2"/>
        </Grid>

        <!-- Candle 5: Bearish (red) -->
        <Grid Width="16" Height="70">
            <Rectangle Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="#555"/>
            <Border x:Name="C5Body" Width="16" VerticalAlignment="Center"
                    Background="#cd4040" CornerRadius="2"/>
        </Grid>

    </StackPanel>
</UserControl>
