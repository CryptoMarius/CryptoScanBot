<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:CryptoScanner.ViewModels"
		mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="400"
		x:Class="CryptoScanner.Views.ColumnWindow"
		x:DataType="vm:ColumnWindowViewModel"
		x:CompileBindings="False"
		Title="Signal Grid - Column Visibility" SizeToContent="Width"
		Height="600" MinWidth="350" MinHeight="400" MaxWidth="1200"
		WindowStartupLocation="CenterOwner" CanResize="True" ShowInTaskbar="False"
		ExtendClientAreaToDecorationsHint="False">

	<!-- Border around entire content -->
	<Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
	<Grid RowDefinitions="*,Auto" Margin="10">

		<ScrollViewer Grid.Row="0" x:Name="ColumnScrollViewer" HorizontalScrollBarVisibility="Disabled">
			<ItemsControl ItemsSource="{Binding Columns}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Vertical"
								   MaxHeight="{Binding #ColumnScrollViewer.Bounds.Height}" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
								  Content="{Binding Header}" Margin="2" Width="150"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>


		<!-- Action buttons -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
					Spacing="10" Margin="0,10,0,0">

			<Button Content="Select All" HorizontalContentAlignment="Center"
					Command="{Binding SelectAllCommand}" Width="100"/>

			<Button Content="Deselect All" HorizontalContentAlignment="Center"
					Command="{Binding DeselectAllCommand}" Width="100"/>

			<Button Content="Close" HorizontalContentAlignment="Center" Click="OnCloseClick" Width="100"/>
		</StackPanel>
	</Grid>
	</Border>
</Window>
