<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CryptoScanner.Views.DashBoardInformationView"
             xmlns:vm="using:CryptoScanner.ViewModels"
             xmlns:converters="using:CryptoScanner.Converters"
             xmlns:views="using:CryptoScanner.Views"
             x:DataType="vm:DashBoardInformationViewModel">

    <UserControl.Resources>
        <converters:BarometerColorConverter x:Key="BarometerColorConverter" />
        <converters:BarometerGraphValueDescriptionConverter x:Key="BarometerGraphValueDescriptionConverter" />
    </UserControl.Resources>
  
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Grid ColumnDefinitions="80,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1">

        <!-- Column=0, Traffic Lights -->
        <StackPanel Grid.Column="0" Orientation="Vertical" MinWidth="80" Margin="20,0,2,0">
            <TextBlock Text="Status" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,2"/>
            <!-- Row 1: Scanner Status -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="30,50" Height="40" Margin="0,0" >
                <!-- Traffic Light: Scanner -->
                <Ellipse Grid.Row="0" Grid.Column="0" Width="20" Height="20" Margin="2,2,2,2"
                            Fill="{Binding ScannerStatusBrush}"
                            Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cursor="Hand" Tapped="OnScannerTapped"/>
                <Viewbox Grid.Row="0" Grid.Column="0" Width="12" Height="12" IsHitTestVisible="False">
                    <Path Data="M2,2 L2,10 L10,10 M3,8 L5,5 L7,6 L9,3"
                          Stroke="White" StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"/>
                </Viewbox>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Scanner"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Cursor="Hand" Tapped="OnScannerTapped"/>

                <!-- Traffic Light: Trader -->
                <Ellipse Grid.Row="1" Grid.Column="0" Width="20" Height="20" Margin="2,2,2,2"
                            Fill="{Binding TraderStatusBrush}"
                            Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cursor="Hand" Tapped="OnTraderTapped"/>
                <Viewbox Grid.Row="1" Grid.Column="0" Width="12" Height="12" IsHitTestVisible="False">
                    <Path Data="M4,1 L5,11 M2,3 L8,3 A2,2 0 0,1 8,7 L2,7 M2,7 L8,7 A2,2 0 0,1 8,11 L2,11"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent" StrokeLineCap="Round"/>
                </Viewbox>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Trader"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Cursor="Hand" Tapped="OnTraderTapped"/>

                <!-- Row 3: Rulez Status -->
                <Ellipse Grid.Row="2" Grid.Column="0" Width="20" Height="20" Margin="2,2,2,2"
                            Fill="{Binding RulezStatusBrush}"
                            Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Viewbox Grid.Row="2" Grid.Column="0" Width="12" Height="12">
                    <Path Data="M3,2 L3,2 L3,10 L1,10 Z M5,2 L7,2 L7,10 L5,10 Z"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent" StrokeLineCap="Round"/> 
                </Viewbox>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Rulez" 
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" />
                
                <!-- Row 4: Sound Status + Time -->
                <Ellipse Grid.Row="3" Grid.Column="0" Width="20" Height="20" Margin="2,2,2,2"
                            Fill="{Binding SoundStatusBrush}"
                            Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cursor="Hand" Tapped="OnSoundTapped"/>
                <Viewbox Grid.Row="3" Grid.Column="0" Width="12" Height="12" IsHitTestVisible="False">
                    <Path Data="M2,4 L4,4 L7,1 L7,11 L4,8 L2,8 Z M8.5,3.5 Q10,5 10,6 Q10,7 8.5,8.5 M9.5,2 Q12,4.5 12,6 Q12,7.5 9.5,10"
                          Stroke="White" StrokeThickness="1.2" Fill="Transparent" StrokeLineCap="Round"/>
                </Viewbox>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApplicationStatus}"
                            FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"
                            Cursor="Hand" Tapped="OnSoundTapped"/>
            </Grid>
        </StackPanel>
        <!-- Separator -->
        <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="10,0"/>

        <!-- Baromer -->
        <StackPanel Grid.Column="2" Orientation="Vertical" MinWidth="125" Margin="0,0,2,0">
            <!-- The graph selection sits next to the heading: there is room beside the title, and
                 as a row of its own below the values it took a line the grid cannot spare. -->
            <!-- The graph selection has since moved over the chart: beside the title it
                 was as wide as the chosen label (up to "Market state: above EMA50") and set the
                 width of this whole column, which pushed the chart to the right. -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Barometer" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,2"/>
            </StackPanel>

            <!-- The market breadth (the share of coins that rose) used to have a column of its own
                 here. It stood right against the chart and read as part of it, so it now only lives
                 in the tooltip of the row, together with the other figures of the measurement. -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,70" Height="25">
                <!-- ComboBox: Quote -->
                <ComboBox Grid.Row="0" Grid.Column="0" FontSize="13" BorderThickness="0" Margin="0,0,0,0"
                            SelectedItem="{Binding SelectedQuote}" VerticalAlignment="Center" HorizontalAlignment="Left"
                            ItemsSource="{Binding Quotes}" IsDropDownOpen="False"/>
                <!-- ComboBox: Interval. Switched off while a market trend is shown: that figure
                     belongs to the quote coin and carries the same value in every interval, so the
                     choice would change nothing - see BarometerCandleFields.UsesInterval. -->
                <ComboBox Grid.Row="0" Grid.Column="1" FontSize="13" BorderThickness="0" Margin="0,0,0,0"
                            SelectedItem="{Binding SelectedInterval}" VerticalAlignment="Center"  HorizontalAlignment="Left"
                            IsEnabled="{Binding IntervalSelectionEnabled}"
                            ToolTip.Tip="Interval of the barometer (the market trend is the same for every interval)"
                            ItemsSource="{Binding Intervals}" IsDropDownOpen="False"/>

                <!-- Barometer: 1h -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Barometer 1h:"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"
                           ToolTip.Tip="{Binding Barometer1hTooltip}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Barometer1h, StringFormat='{}{0:N2}'}"
                            FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Foreground="{Binding Barometer1h, Converter={StaticResource BarometerColorConverter}}"
                            ToolTip.Tip="{Binding Barometer1hTooltip}"/>

                <!-- Barometer: 11h TextAlignment="Left" -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Barometer 4h:"
                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"
                           ToolTip.Tip="{Binding Barometer4hTooltip}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Barometer4h, StringFormat='{}{0:N2}'}"
                            FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Foreground="{Binding Barometer4h, Converter={StaticResource BarometerColorConverter}}"
                            ToolTip.Tip="{Binding Barometer4hTooltip}"/>

                <!-- Barometer: 1d -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Barometer 1d:"
                           FontSize="13"  VerticalAlignment="Center" HorizontalAlignment="Left"
                           ToolTip.Tip="{Binding Barometer1dTooltip}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Barometer1d, StringFormat='{}{0:N2}'}"
                            FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Foreground="{Binding Barometer1d, Converter={StaticResource BarometerColorConverter}}"
                            ToolTip.Tip="{Binding Barometer1dTooltip}"/>
            </Grid>
        </StackPanel>
        <!-- Visible again: since the graph selection lies over the chart, the line between the
             values and the chart is the only thing that keeps them apart, like the other columns. -->
        <!--<Border Grid.Column="3" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="0" Margin="1,0"/>-->
        <Border Grid.Column="3" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="10,0"/>

        <!-- Column=2, Barometer chart -->
        <!-- 436 = the 400 pixel plot plus the value scale beside it (BarometerAxisWidth) -->
        <!-- No margin on the right: the value scale already ends in empty space after its
             labels (36 pixels for "-0.60", far less used by "100"). -->
        <!-- Left margin 10: together with the separator's own 10 the same 20 pixels as the other columns. -->
        <Border Grid.Column="4" MinWidth="436" MinHeight="100" Margin="10,2,0,0"
                BorderThickness="0">
            <Grid>
                <!-- Loading animation: visible while ChartImage is null -->
                <StackPanel IsVisible="{Binding ChartImage, Converter={x:Static ObjectConverters.IsNull}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                    <views:LoadingCandlesticksView/>
                    <TextBlock Text="{Binding CandleProgressText}" FontSize="11"
                               HorizontalAlignment="Center" Opacity="0.7"
                               IsVisible="{Binding CandleProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <!-- Chart bitmap: visible once loaded -->
                <!-- 122 high and at the top: the full row less the 2 pixel margin above, the same
                     height as intHeight in CreateBarometerBitmap. Centred at 100 it sat lower than
                     the headings and left the bottom of the row empty. -->
                <Image Source="{Binding ChartImage}" Width="436" Height="122" Stretch="Fill"
                       VerticalAlignment="Top"
                       IsVisible="{Binding ChartImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- ComboBox: which figure of the measurement the graph draws. The rows below can
                     only show two of the six; this is where the rest becomes visible. -->
                <!-- The labels are short, so every item explains itself in a tooltip, and the closed
                     box explains the figure that is drawn - see BarometerCandleFields.GetDescription,
                     which the Photino dashboard shows as well. -->
                <!-- Laid over the top-left corner of the chart, on the same see-through plate as the
                     labels drawn in the bitmap (PlateAlpha 191 = 0.75), so it takes no height of its
                     own. As wide as the chosen label so the arrow stays next to the text; the closed
                     box is bold like the headings, the opened list keeps the normal weight. The time
                     of the measurement moved to the top-right corner for it. -->
                <!-- -3 on top undoes the 2 pixel top margin of this border and the 1 pixel the text
                     sits lower in the 22 pixel box, so the text lines up with the other headings,
                     which start at the top of their column (measured: both at y 0). -->
                <Panel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,-3,0,0">
                    <!-- Half see-through, lighter than the plates in the bitmap: the chart stays
                         visible under the label. The closed box uses the heading font (16, bold). -->
                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Opacity="0.5" CornerRadius="2"/>
                    <ComboBox FontSize="13" BorderThickness="0" Margin="0,0,0,0" Height="22" MinHeight="0" Padding="3,0,0,0"
                                Background="Transparent"
                                SelectedItem="{Binding SelectedGraphValue}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding GraphValues}" IsDropDownOpen="False"
                                ToolTip.Tip="{Binding SelectedGraphValue, Converter={StaticResource BarometerGraphValueDescriptionConverter}}">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{ReflectionBinding}" FontWeight="Bold" FontSize="16"/>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.Styles>
                            <!-- On the whole row of the item, not only on its text -->
                            <Style Selector="ComboBoxItem">
                                <Setter Property="ToolTip.Tip"
                                        Value="{ReflectionBinding Converter={StaticResource BarometerGraphValueDescriptionConverter}}"/>
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>
                </Panel>
            </Grid>
        </Border>

        <!-- Separator -->
        <Border Grid.Column="5" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="10,0" />

        <!-- Column=4, Left Section: Market Indicators -->
        <StackPanel Grid.Column="6" Margin="10,0,2,0" MinWidth="180">
            <TextBlock Text="Market Indicators" FontWeight="Bold" FontSize="16" Margin="0,0,0,2"/>
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,80">
                
                <!-- Market Cap Total -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{Binding TvSymbols[0].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[0]}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                           Foreground="{Binding TvSymbols[0].Color}"
                           Text="{Binding TvSymbols[0].PriceText}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[0]}"/>
                
                <!-- Dollar Index -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{Binding TvSymbols[1].Name}"
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[1]}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                           Foreground="{Binding TvSymbols[1].Color}"
                           Text="{Binding TvSymbols[1].PriceText}"
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[1]}"/>

                <!-- S&P 500 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{Binding TvSymbols[2].Name}"
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[2]}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                           Foreground="{Binding TvSymbols[2].Color}"
                           Text="{Binding TvSymbols[2].PriceText}"
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[2]}"/>

                <!-- Bitcoin Dominance -->
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{Binding TvSymbols[3].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[3]}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                           Foreground="{Binding TvSymbols[3].Color}"
                           Text="{Binding TvSymbols[3].PriceText}"
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[3]}"/>

                <!-- Fear and Greed Index -->
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{Binding TvSymbols[4].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[4]}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Classes="value"
                           Foreground="{Binding TvSymbols[4].Color}"
                           Text="{Binding TvSymbols[4].PriceText}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TvSymbols[4]}"/>
            </Grid>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Column="7" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="10,0"/>

        <!-- Column=6 Right Section: Crypto Prices -->
        <StackPanel Grid.Column="8" Margin="10,0,2,0" MinWidth="180">
            <TextBlock Text="Crypto Prices" FontWeight="Bold" FontSize="16" Margin="0,0,0,2"/>
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,80,80">
                
                <!-- 0 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{Binding TopSymbols[0].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[0]}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" MinWidth="50"
                           Foreground="{Binding TopSymbols[0].Color}" Tapped="OnSymbolTapped" 
                           Tag="{Binding TopSymbols[0]}" Text="{Binding TopSymbols[0].PriceText}">
                </TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="value" Text="{Binding TopSymbols[0].VolumeText}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[0]}"/>

                <!-- 1 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{Binding TopSymbols[1].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[1]}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" MinWidth="50"
                           Foreground="{Binding TopSymbols[1].Color}" Tapped="OnSymbolTapped" 
                           Tag="{Binding TopSymbols[1]}" Text="{Binding TopSymbols[1].PriceText}">
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding TopSymbols[1].VolumeText}"
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[1]}"/>

                <!-- 2 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{Binding TopSymbols[2].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[2]}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" MinWidth="50"
                           Foreground="{Binding TopSymbols[2].Color}" Tapped="OnSymbolTapped" 
                           Tag="{Binding TopSymbols[2]}" Text="{Binding TopSymbols[2].PriceText}">
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="value" Text="{Binding TopSymbols[2].VolumeText}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[2]}"/>

                <!-- 3 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{Binding TopSymbols[3].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[3]}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" MinWidth="50"
                           Foreground="{Binding TopSymbols[3].Color}" Tapped="OnSymbolTapped" 
                           Tag="{Binding TopSymbols[3]}" Text="{Binding TopSymbols[3].PriceText}">
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="2" Classes="value" Text="{Binding TopSymbols[3].VolumeText}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[3]}"/>

                <!-- 4 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{Binding TopSymbols[4].Name}" 
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[4]}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" MinWidth="50"
                           Foreground="{Binding TopSymbols[4].Color}" Tapped="OnSymbolTapped" 
                           Tag="{Binding TopSymbols[4]}" Text="{Binding TopSymbols[4].PriceText}">
                </TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="2" Classes="value" Text="{Binding TopSymbols[4].VolumeText}"
                           Tapped="OnSymbolTapped" Tag="{Binding TopSymbols[4]}"/>

            </Grid>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Column="9" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="10,0"/>

        
        <!-- Tickers -->
        <!-- No MinWidth: the counters took about 134 of the 180 pixels and left a gap before
             the closing line. This is the last column, so a growing count moves nothing else. -->
        <StackPanel Grid.Column="10" Margin="10,0,2,0">
            <TextBlock Text="Tickers" FontWeight="Bold" FontSize="16" Margin="0,0,0,2"/>
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto">
                
                <!-- Kline ticker count -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                           Text="Kline Ticker Count" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                           Text="{Binding KlineTickerCount}" />
               
                <!-- Scanner analyze count -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                           Text="Scanner analyze Count" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                           Text="{Binding ScannerExecuteCount}" />

                <!-- Scanner signal count -->
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                           Text="Scanner signal Count" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                           Text="{Binding ScannerSignalCount}" />

                <!-- Trader position count -->
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label"
                           Text="Open positions" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                           Text="{Binding ScannerPositionCount}" />
            </Grid>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Column="11" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="10,0"/>
    </Grid>
    </ScrollViewer>
</UserControl>
