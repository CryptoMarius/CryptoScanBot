<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CryptoScanner.DashBoard.Views.DashBoardView"
             xmlns:vm="using:CryptoScanner.DashBoard.ViewModels"
             xmlns:converters="using:CryptoScanner.DashBoard.Converters"
             x:DataType="vm:DashBoardViewModel">

    <UserControl.Resources>
        <converters:LargeNumberConverter x:Key="LargeNumberConverter" />
    </UserControl.Resources>
  
    <Grid ColumnDefinitions="1,Auto,Auto,1,Auto,Auto,Auto,1">
        
        <!-- TODO: Buttons -->
        <!-- TODO: BM inputs / initializing -->
        <!-- TODO: BM text -->
        <!-- TODO: BM graph -->

        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="15,0"/>

        <!-- Left Section: Market Indicators -->
        <StackPanel Grid.Column="1" Margin="0,0,2,0">
            <TextBlock Text="Market Indicators" FontWeight="Bold" FontSize="16" Margin="0,0,0,2"/>
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto">
                
                <!-- Market Cap Total -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                           Foreground="{Binding MarketCapTotal.Color}"
                           Text="Market Cap Total" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                           Foreground="{Binding MarketCapTotal.Color}"
                           Text="{Binding MarketCapTotal.Price, Converter={StaticResource LargeNumberConverter}}" />
                
                <!-- Dollar Index -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                           Foreground="{Binding DollarIndex.Color}"
                           Text="Dollar Index (DXY)" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                           Foreground="{Binding DollarIndex.Color}"
                           Text="{Binding DollarIndex.Price, StringFormat='{}{0:N2}'}" />

                <!-- S&P 500 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                           Foreground="{Binding Spx500.Color}"
                           Text="S&amp;P 500" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                           Foreground="{Binding Spx500.Color}"
                           Text="{Binding Spx500.Price, Converter={StaticResource LargeNumberConverter}}" />

                <!-- Bitcoin Dominance -->
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label"
                           Foreground="{Binding BitcoinDominance.Color}"
                           Text="BTC Dominance" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                           Foreground="{Binding BitcoinDominance.Color}"
                           Text="{Binding BitcoinDominance.Price, StringFormat='{}{0:N2} %'}" />

                <!-- Fear and Greed Index -->
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label"
                           Foreground="{Binding FearAndGreedIndex.Color}"
                           Text="Fear &amp; Greed Index" />
                <TextBlock Grid.Row="4" Grid.Column="1" Classes="value"
                           Foreground="{Binding FearAndGreedIndex.Color}"
                           Text="{Binding FearAndGreedIndex.Price, StringFormat='{}{0:N0} %'}" />
            </Grid>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Column="3" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="15,0"/>

        <!-- Right Section: Crypto Prices -->
        <StackPanel Grid.Column="4" Margin="2,0,0,0">
            <TextBlock Text="Crypto Prices" FontWeight="Bold" FontSize="16" Margin="0,0,0,2"/>
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto">
                
                <!-- Bitcoin -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                           Foreground="{Binding BtcUsdt.Color}"
                           Text="Bitcoin (BTC)" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                           Foreground="{Binding BtcUsdt.Color}"
                           Text="{Binding BtcUsdt.Price}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="value"
                           Foreground="{Binding BtcUsdt.Color}"
                           Text="{Binding BtcUsdt.Volume}" />
                
                <!-- Ethereum -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                           Foreground="{Binding EthUsdt.Color}"
                           Text="Ethereum (ETH)" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                           Foreground="{Binding EthUsdt.Color}"
                           Text="{Binding EthUsdt.Price}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="value"
                           Foreground="{Binding EthUsdt.Color}"
                           Text="{Binding EthUsdt.Volume, Converter={StaticResource LargeNumberConverter}}" />

                <!-- BNB -->
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                           Foreground="{Binding BnbUsdt.Color}"
                           Text="BNB" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                           Foreground="{Binding BnbUsdt.Color}"
                           Text="{Binding BnbUsdt.Price}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="value"
                           Foreground="{Binding BnbUsdt.Color}"
                           Text="{Binding BnbUsdt.Volume, Converter={StaticResource LargeNumberConverter}}" />

                <!-- Solana -->
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label"
                           Foreground="{Binding SolUsdt.Color}"
                           Text="Solana (SOL)" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                           Foreground="{Binding SolUsdt.Color}"
                           Text="{Binding SolUsdt.Price}" />
                <TextBlock Grid.Row="3" Grid.Column="2" Classes="value"
                           Foreground="{Binding SolUsdt.Color}"
                           Text="{Binding SolUsdt.Volume, Converter={StaticResource LargeNumberConverter}}" />

                <!-- XRP -->
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label"
                           Foreground="{Binding XrpUsdt.Color}"
                           Text="XRP" />
                <TextBlock Grid.Row="4" Grid.Column="1" Classes="value"
                           Foreground="{Binding XrpUsdt.Color}"
                           Text="{Binding XrpUsdt.Price}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Classes="value"
                           Foreground="{Binding XrpUsdt.Color}"
                           Text="{Binding XrpUsdt.Volume, Converter={StaticResource LargeNumberConverter}}" />

            </Grid>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Column="5" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="15,0"/>

        
        <!-- Tickers -->
        <StackPanel Grid.Column="6" Margin="2,0,0,0">
            <TextBlock Text="Tickers" FontWeight="Bold" FontSize="16" Margin="0,0,0,2"/>
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto">
                
                <!-- Kline ticker count -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                           Text="Kline Ticker Count" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                           Text="1234567890..." />
               
                <!-- Scanner analyze count -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                           Text="Scanner analyze Count" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                           Text="1234567890..." />

                <!-- Scanner signal count -->
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                           Text="Scanner signal Count" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                           Text="1234567890..." />
            </Grid>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Column="7" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Width="1" Margin="15,0"/>
    </Grid>
</UserControl>
