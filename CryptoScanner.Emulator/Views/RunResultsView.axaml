<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CryptoScanner.Emulator.ViewModels"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="420"
             x:Class="CryptoScanner.Emulator.Views.RunResultsView"
             x:DataType="vm:RunResultsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <!-- Refresh and "Delete all runs" moved into the context menu of the grid (04-10-2026). -->
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <TextBox Width="420" Text="{Binding LabelFilter}"
                     Watermark="label words and conditions, e.g. dbr counts=1 recoveryfactor&gt;2 totalpnl&gt;0"
                     ToolTip.Tip="Shows only the runs whose label contains every word, in any order and case.&#10;A word with an operator (&gt; &lt; &gt;= &lt;= = !=) is a condition on a number column. Its name is the column header without spaces and dots, in any case:&#10;  recoveryfactor&gt;2  totalpnl&gt;0  drawdown%&lt;20  win%&gt;=50  peakcap&lt;5000  (two on one field give a range: drawdown%&gt;5 drawdown%&lt;20)&#10;One name without a column: counts=1 keeps the runs whose recovery factor counts in the ranking (not greyed).&#10;Avg dur., Min dur. and Max dur. are tested in days: avgdur&gt;2.&#10;An unknown name is reported in the status line under the grid.&#10;Empty shows all runs."/>
        </StackPanel>

        <!-- HorizontalScrollBarVisibility is forced to Visible: on Auto the grid never showed its
             horizontal scrollbar, so the columns on the right could not be reached (05-09-2026).
             Forced, the scrollbar is always there and scrolls whenever the columns overflow.
             The disappearing act turned out to be the 18px rows presenter margin in App.axaml,
             fixed there by giving the presenter its own row; Visible stays so the bar is always
             present, also when the columns happen to fit. -->
        <!-- The rows come through RunsView (the label filter), an untyped collection view, so the
             column bindings cannot be compiled against RunRow any more: x:CompileBindings off. -->
        <DataGrid Grid.Row="1"
                  Name="RunsGrid"
                  ItemsSource="{Binding RunsView}"
                  x:CompileBindings="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  HorizontalScrollBarVisibility="Visible">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Refresh" Click="OnRefreshClick"/>
                    <Separator/>
                    <MenuItem Header="Adjust columns…" Click="OnAdjustColumnsClick"/>
                    <Separator/>
                    <MenuItem Header="Edit label…" Click="OnEditLabelClick"/>
                    <MenuItem Header="Show positions…" Click="OnShowPositionsClick"/>
                    <MenuItem Header="Show signals…" Click="OnShowSignalsClick"/>
                    <MenuItem Header="Show settings GUI" Click="OnShowSettingsGuiClick"/>
                    <MenuItem Header="Show settings JSON" Click="OnShowJsonClick"/>
                    <MenuItem Header="Show emulator config" Click="OnShowEmulatorConfigClick"/>
                    <MenuItem Header="Export scanner settings…" Click="OnExportSettingsClick"/>
                    <MenuItem Header="Take over these settings…" Click="OnTakeOverSettingsClick"/>
                    <Separator/>
                    <MenuItem Header="Copy selected rows (for Excel)" Click="OnCopyRowsClick"/>
                    <MenuItem Header="Copy all rows (for Excel)"      Click="OnCopyAllRowsClick"/>
                    <MenuItem Header="Export selected rows to Excel" Click="OnExportSelectedToExcelClick"/>
                    <MenuItem Header="Export all rows to Excel"      Click="OnExportAllToExcelClick"/>
                    <Separator/>
                    <MenuItem Header="Delete run(s)…" Click="OnDeleteRunClick"/>
                    <MenuItem Header="Delete all runs…" Click="OnDeleteAllRunsClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Id" Width="50" SortMemberPath="Id">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
				<DataGridTextColumn Header="Started" Binding="{Binding StartedLocal}" SortMemberPath="StartedLocal" Width="120"/>
                <!-- The build that made the run. Runs on different builds are not comparable, and
                     the 29-08-2026 break (+432,07 against +734,17 for the same settings) could only
                     be found from dates and commits (open point 52). -->
				<DataGridTextColumn Header="Build" Binding="{Binding BuildStampText}" SortMemberPath="BuildStampText" Width="120"/>
				<DataGridTextColumn Header="Label" Binding="{Binding Label}" SortMemberPath="Label" Width="400"/>
				<DataGridTextColumn Header="Period" Binding="{Binding Period}" SortMemberPath="Period" Width="210"/>
				<DataGridTextColumn Header="Finished" Binding="{Binding FinishedLocal}" SortMemberPath="FinishedLocal" Width="130" IsVisible="False"/>
				<DataGridTextColumn Header="Duration" Binding="{Binding Duration}" SortMemberPath="Duration" Width="90"/>
                <!-- Wide enough for "duplicate of run 515": a recognised repeat is recorded as a row
                     whose Result names the run it matched, so the reference has to be readable. -->
                <!-- Narrowed to fit "completed" / "cancelled"; a longer "duplicate of run …" is clipped
                     and shows in full when the column is widened (the width is remembered). -->
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" SortMemberPath="Result" Width="85"/>
                <DataGridTemplateColumn Header="Signals" Width="65" SortMemberPath="SignalCount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding SignalCount}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Pos" Width="55" SortMemberPath="PositionCount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionCount}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Open" Width="55" SortMemberPath="PositionsOpen">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionsOpen}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Won" Width="55" SortMemberPath="PositionsWon">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionsWon}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Lost" Width="55" SortMemberPath="PositionsLost">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionsLost}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Timeout" Width="65" SortMemberPath="PositionsTimeout">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionsTimeout}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Win %" Width="70" SortMemberPath="WinPercentage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WinPercentageText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Profit" Width="90" SortMemberPath="Profit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ProfitText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The open positions against the price of the last day, and the run's real worth -->
                <DataGridTemplateColumn Header="Unrealized PnL" Width="100" SortMemberPath="UnrealizedPnl">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding UnrealizedPnlText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Total PnL" Width="90" SortMemberPath="TotalPnl">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding TotalPnlText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The same per side: realised profit of the side plus its open positions at the last price -->
                <DataGridTemplateColumn Header="Total PnL Long" Width="110" SortMemberPath="TotalPnlLong">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding TotalPnlLongText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Total PnL Short" Width="110" SortMemberPath="TotalPnlShort">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding TotalPnlShortText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Profit %" Width="80" SortMemberPath="ProfitPercentage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ProfitPercentageText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Invested" Width="90" SortMemberPath="Invested">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding InvestedText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Peak capital is the money the run actually needed at its busiest moment, which is
                     what says whether an account could have run it. Invested above is the same stake
                     going round and grows with the trade count, so its percentage flatters a strategy
                     that trades little. Peak % is the honest one, and sits next to it on purpose. -->
                <DataGridTemplateColumn Header="Peak cap." Width="90" SortMemberPath="PeakInvested">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PeakInvestedText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Peak pos" Width="70" SortMemberPath="PeakPositions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PeakPositions}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Peak %" Width="80" SortMemberPath="PeakProfitPercentage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PeakProfitPercentageText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The deepest fall of the capital from an earlier high, from the daily snapshots of
                     the run. Two runs with the same profit are not the same when one of them was
                     down 40% halfway (open point 47). -->
                <DataGridTemplateColumn Header="Drawdown %" Width="90" SortMemberPath="MaxDrawdownPercentage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding MaxDrawdownText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The run against the money it started with. Only filled when asset management was
                     on: with it off the start capital never bounded what was traded, and a percentage
                     of it would say nothing. Not per day - compared runs cover the same period. -->
                <DataGridTemplateColumn Header="Start cap." Width="90" SortMemberPath="TotalStartCapital" IsVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding StartCapitalText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="End cap." Width="90" SortMemberPath="EndCapital" IsVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding EndCapitalText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Return %" Width="80" SortMemberPath="CapitalReturnPercentage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding CapitalReturnPercentageText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The one figure the runs are ranked on (decided 03-10-2026, as in emulator_report.py
                     and beste-runs.sql): Total PnL / the fall including open positions in USDT. Return %
                     and Drawdown % move with the start capital, this does not. A run that does not count
                     (too few trades, or no profit without its best 10) stays in, greyed, with the reason
                     on the cell. -->
                <DataGridTemplateColumn Header="Recovery factor" Width="105" SortMemberPath="RecoveryFactor">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding RecoveryFactorText}"
                                       Opacity="{Binding RecoveryFactorOpacity}" ToolTip.Tip="{Binding RecoveryFactorReason}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Without best 10" Width="105" SortMemberPath="ProfitWithoutBestTen">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ProfitWithoutBestTenText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- How much of the account was at work in trades (AmiBroker's Exposure and Risk Adjusted
                     Return, database version 110). Exact from the fills since that version; an older run
                     shows the digest estimate, greyed and marked "ca.", with the reason on the cell. -->
                <DataGridTemplateColumn Header="Exposure %" Width="95" SortMemberPath="ExposurePercentage">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ExposurePercentageText}"
                                       Opacity="{Binding CapitalUseOpacity}" ToolTip.Tip="{Binding CapitalUseReason}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RAR %" Width="95" SortMemberPath="RiskAdjustedReturn">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding RiskAdjustedReturnText}"
                                       Opacity="{Binding CapitalUseOpacity}" ToolTip.Tip="{Binding CapitalUseReason}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Profit long" Width="90" SortMemberPath="ProfitLong" IsVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ProfitLongText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Profit short" Width="90" SortMemberPath="ProfitShort" IsVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding ProfitShortText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Best and worst case for the positions still open at the end. They are not a random
                     sample - the winners hit take profit and closed - so what is left leans to the
                     losing side, and these two say how much that can still move the run. -->
                <DataGridTemplateColumn Header="Best case" Width="90" SortMemberPath="BestCase" IsVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding BestCaseText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Worst case" Width="90" SortMemberPath="WorstCase" IsVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WorstCaseText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Avg dur." Binding="{Binding AvgDurationText}" SortMemberPath="AvgDurationText" Width="90"/>
                <DataGridTextColumn Header="Min dur." Binding="{Binding MinDurationText}" SortMemberPath="MinDurationText" Width="90"/>
                <DataGridTextColumn Header="Max dur." Binding="{Binding MaxDurationText}" SortMemberPath="MaxDurationText" Width="90"/>
			</DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="Gray" FontSize="11"/>

    </Grid>

</UserControl>