<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CryptoScanner.Emulator.ViewModels"
        xmlns:views="using:CryptoScanner.Emulator.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        Width="1600" Height="1000"
        x:Class="CryptoScanner.Emulator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <DockPanel>

            <!-- ─── Custom title bar (mirrors CryptoScanner/Views/MainWindow.axaml) ──────── -->
            <Grid DockPanel.Dock="Top" Height="38" Name="TitleBarGrid">
                <!-- Background layer: transparent to hit testing so the system chrome handles
                     window dragging from the empty title-bar area. -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" IsHitTestVisible="False"/>

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Menu with the same actions as the command-bar buttons -->
                    <Menu Grid.Column="0" VerticalAlignment="Center" Background="Transparent" FontSize="12">
                        <MenuItem Header="_Run">
                            <MenuItem Header="Fetch symbols"
                                      Command="{Binding FetchSymbolsCommand}"
                                      IsEnabled="{Binding !IsRunning}"/>
                            <MenuItem Header="Fetch candles"
                                      Command="{Binding FetchCandlesCommand}"
                                      IsEnabled="{Binding !IsRunning}"/>
                            <Separator/>
                            <MenuItem Header="Run parameters..."
                                      Command="{Binding EditRunConfigCommand}"
                                      CommandParameter="{Binding $parent[Window]}"
                                      IsEnabled="{Binding !IsRunning}"/>
                            <MenuItem Header="Configure scanner..."
                                      Command="{Binding ConfigureScannerCommand}"
                                      CommandParameter="{Binding $parent[Window]}"
                                      IsEnabled="{Binding !IsRunning}"/>
                            <Separator/>
                            <MenuItem Header="Start"
                                      Command="{Binding StartCommand}"
                                      IsEnabled="{Binding !IsRunning}"/>
                            <MenuItem Header="Run all algorithms"
                                      Command="{Binding RunAllAlgorithmsCommand}"
                                      IsEnabled="{Binding !IsRunning}"/>
                            <MenuItem Header="Stop"
                                      Command="{Binding StopCommand}"
                                      IsEnabled="{Binding IsRunning}"/>
                        </MenuItem>
                    </Menu>

                    <!-- Center: window title -->
                    <TextBlock Grid.Column="1" Text="{Binding $parent[Window].Title}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="12" Margin="20,0,0,0"/>

                    <!-- Right: reserved space for the system window buttons -->
                    <Border Grid.Column="2" Width="138" Background="Transparent"/>
                </Grid>
            </Grid>

            <!-- ─── Main content ────────────────────────────────────────────────────────── -->
            <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">

                <!-- ─── Command bar (knoppen) ─────────────────────────────────────────────── -->
                <Border Grid.Row="0" Padding="8" BorderBrush="#606060" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Fetch symbols"
                                Command="{Binding FetchSymbolsCommand}"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Pulls the symbol list from the exchange (REST). Needed before Configure can show quotes and before runs can find any symbol."/>
                        <Button Content="Configure scanner..."
                                Command="{Binding ConfigureScannerCommand}"
                                CommandParameter="{Binding $parent[Window]}"
                                IsEnabled="{Binding !IsRunning}"/>
                        <Button Content="Run parameters..."
                                Command="{Binding EditRunConfigCommand}"
                                CommandParameter="{Binding $parent[Window]}"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Set the replay period, the symbols to run and a label (saved to emulator-run.json)."/>
                        <Button Content="Fetch candles"
                                Command="{Binding FetchCandlesCommand}"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Pulls candles for every symbol in emulator-run.json and persists them. May take a while; only needs doing once per symbol/range."/>
                        <Button Content="Start"
                                Command="{Binding StartCommand}"
                                IsVisible="{Binding !IsRunning}"
                                Background="#3A8D3A" Foreground="White"/>
                        <Button Content="Run all algorithms"
                                Command="{Binding RunAllAlgorithmsCommand}"
                                IsVisible="{Binding !IsRunning}"
                                ToolTip.Tip="Runs every registered algorithm one by one (long+short) with the symbols/period from emulator-run.json. Each algorithm gets its own EmulatorRun row labelled with its name."/>
                        <Button Content="Stop"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsRunning}"
                                Background="#A03030" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- ─── Header (titel + hint) ─────────────────────────────────────────────── -->
                <StackPanel Grid.Row="1" Margin="4,0,0,0">
                    <TextBlock FontSize="20" FontWeight="Bold" Text="CryptoScanBot Emulator"/>
                    <TextBlock FontSize="11" Foreground="Gray"
                               Text="Backtest replay over a dedicated data folder. Edit settings.json via Configure; symbols and dates via Run parameters."/>
                </StackPanel>

                <!-- ─── Paths (Version / App / Data folder) ───────────────────────────────── -->
                <Grid Grid.Row="2" Margin="4,0,0,0" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App path:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppPath}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Data folder:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataFolder}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </Grid>

                <!-- ─── Status panel (progress / symbol / status text) ────────────────────── -->
                <Border Grid.Row="3" BorderBrush="#808080" BorderThickness="1" Padding="10" CornerRadius="3">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Progress:"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1"
                                     Value="{Binding ProgressValue}"
                                     Maximum="{Binding ProgressMaximum}"
                                     Minimum="0"
                                     Height="14"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Symbol:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentSymbol}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ─── Tabs: Log + Results (charts etc. can slot in later) ───────────────── -->
                <TabControl Grid.Row="4">
                    <TabItem Header="Log">
                        <views:LogTabView DataContext="{Binding LogTab}"/>
                    </TabItem>
                    <TabItem Header="Results">
                        <views:RunResultsView DataContext="{Binding RunResults}"/>
                    </TabItem>
                </TabControl>

            </Grid>
        </DockPanel>
    </Panel>

</Window>
