<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CryptoScanner.Emulator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="620"
        Width="760" Height="800"
        x:Class="CryptoScanner.Emulator.Views.RunConfigWindow"
        x:DataType="vm:RunConfigViewModel"
        Title="Run parameters"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- The Fluent theme draws the drop-down button of a CalendarDatePicker as a miniature
             calendar built from two half-pixel borders, a dot and a TextBlock bound to
             DateTime.Today.Day. Right next to a date field that number reads as part of the selected
             period, while it in fact changes every midnight — and the hairline borders barely show
             on a dark background. One plain calendar icon instead; the button still opens the
             calendar popup. -->
        <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Transparent background so the whole button area keeps taking clicks. -->
                    <Border Background="Transparent">
                        <PathIcon Width="14" Height="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                  Data="M4,1 H5.2 V3 H4 Z M10.8,1 H12 V3 H10.8 Z M1,3 H15 V15 H1 Z M2,6.2 V14 H14 V6.2 Z"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- Border around entire content -->
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">

        <!-- Label -->
        <Grid Grid.Row="0" ColumnDefinitions="90,*">
            <TextBlock Grid.Column="0" Text="Label:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Label}"
                     Watermark="optional — to spot the run in the Results tab"/>
        </Grid>

        <!-- Period -->
        <Grid Grid.Row="1" ColumnDefinitions="90,*,40,*">
            <TextBlock Grid.Column="0" Text="From:" VerticalAlignment="Center"/>
            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding FromDate}"
								SelectedDateFormat="Custom" CustomDateFormatString="dd-MM-yyyy"/>
            <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <CalendarDatePicker Grid.Column="3" SelectedDate="{Binding ToDate}"
								SelectedDateFormat="Custom" CustomDateFormatString="dd-MM-yyyy"/>
        </Grid>

        <!-- Base interval + start capital -->
        <Grid Grid.Row="2" ColumnDefinitions="90,*,90,*,Auto">
            <TextBlock Grid.Column="0" Text="Base interval:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding BaseIntervals}"
                      SelectedItem="{Binding SelectedBaseInterval}"
                      ToolTip.Tip="Replay resolution: 1m = full precision, 5m = ~5× faster (less precise order-fill timing)"/>
            <TextBlock Grid.Column="2" Text="Start capital:" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <NumericUpDown Grid.Column="3" Value="{Binding StartCapital}"
                           Minimum="0" Increment="1000" FormatString="N2"
                           ToolTip.Tip="Paper-trading capital per traded quote coin. The balances are wiped and handed out again at the start of every run, so two runs over the same period start with the same amount of money."/>
            <CheckBox Grid.Column="4" Content="Asset management" IsChecked="{Binding UseAssetManagement}"
                      Margin="8,0,0,0" VerticalAlignment="Center"
                      ToolTip.Tip="On: entries are paid out of the free balance and a position is only opened when the entry and its DCA levels fit, so the run can run out of money. Off: the balances are still booked (the equity curve keeps working) but nothing is refused for lack of money, and every entry is the plain entry amount of the quote coin - a percentage needs a balance to be a percentage of."/>
        </Grid>

        <!-- Symbols header + filter -->
        <Grid Grid.Row="3" ColumnDefinitions="90,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Symbols:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SymbolFilter}" Watermark="filter…"/>
            <Button Grid.Column="2" Content="All" Margin="6,0,0,0"
                    Command="{Binding SelectAllFilteredCommand}"
                    ToolTip.Tip="Select every symbol currently shown by the filter"/>
            <Button Grid.Column="3" Content="None" Margin="6,0,0,0"
                    Command="{Binding DeselectAllFilteredCommand}"
                    ToolTip.Tip="Deselect every symbol currently shown by the filter"/>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding SelectedSummary}" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Show only selected" IsChecked="{Binding ShowOnlySelected}"
                      FontSize="11" Padding="4,0,0,0"
                      ToolTip.Tip="Show only the currently selected (active) symbols, so you can review and switch them off without scrolling the whole list. Combine with 'None' to clear them all at once."/>
        </Grid>

        <!-- Symbol checklist -->
        <Border Grid.Row="5" BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
            <DataGrid ItemsSource="{Binding FilteredSymbols}"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SymbolSelectionItem">
                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Symbol" Binding="{Binding Name}" Width="*"/>
                    <DataGridTemplateColumn Header="Volume" Width="120" SortMemberPath="Volume">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:SymbolSelectionItem">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding VolumeText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Validation -->
        <TextBlock Grid.Row="6" Text="{Binding ValidationMessage}" Foreground="#C0392B"
                   TextWrapping="Wrap" FontSize="11"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancel" MinWidth="80"/>
            <Button Content="OK" Click="OnOk" MinWidth="80"
                    Background="#3A8D3A" Foreground="White"/>
        </StackPanel>

    </Grid>
    </Border>

</Window>
