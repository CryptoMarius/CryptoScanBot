<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CryptoScanner.Emulator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
        Width="420" Height="360"
        x:Class="CryptoScanner.Emulator.Views.PaperAssetDefaultsWindow"
        x:DataType="vm:PaperAssetDefaultsViewModel"
        x:Name="Root"
        Title="Start assets"
        WindowStartupLocation="CenterOwner">

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                   Text="The balances every run starts with, one row per coin, in the coin itself. The same list as the Default column of Paper assets in the scanner. Empty hands out 10.000 per traded quote coin."/>

        <Border Grid.Row="1" BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaperAssetDefaultRow">
                            <Grid ColumnDefinitions="Auto,90,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Asset:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="USDC"/>
                                <TextBlock Grid.Column="2" Text="Amount:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                <NumericUpDown Grid.Column="3" Value="{Binding Total}"
                                               Minimum="0" Increment="1000" FormatString="N2"/>
                                <Button Grid.Column="4" Content="✕" Margin="6,0,0,0"
                                        Command="{Binding #Root.((vm:PaperAssetDefaultsViewModel)DataContext).RemoveRowCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Remove this coin from the list"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Content="Add asset" Command="{Binding AddRowCommand}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="OnCancel" MinWidth="80"/>
                <Button Content="OK" Click="OnOk" MinWidth="80"
                        Background="#3A8D3A" Foreground="White"/>
            </StackPanel>
        </Grid>

    </Grid>
    </Border>

</Window>
