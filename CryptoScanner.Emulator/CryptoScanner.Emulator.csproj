<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Self-contained publish so the emulator carries its own runtime and can ship next to
		     (or merged with) the scanner without a system-wide .NET 8 install. Mirrors the scanner. -->
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>true</SelfContained>

		<!-- Version / Company / Copyright / Authors are shared via Directory.Build.props -->
		<Product>CryptoScanBot.Emulator</Product>
		<Description>Backtest emulator for the CryptoScanBot scanner</Description>
		<Configurations>Debug;Release</Configurations>

		<AssemblyName>CryptoScanBot.Emulator</AssemblyName>

		<!-- Same application/exe icon as the scanner. Referenced directly from the scanner's
		     Assets folder so the two stay identical (no duplicated .ico file). -->
		<ApplicationIcon>..\CryptoScanner\Assets\AppIcon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.17" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CryptoScanner.Core\CryptoScanner.Core.csproj" />
		<ProjectReference Include="..\CryptoScanner.Config\CryptoScanner.Config.csproj" />
		<ProjectReference Include="..\CryptoScanner.Chart\CryptoScanner.Chart.csproj" />
	</ItemGroup>
</Project>
