<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="400"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderTakeProfitViewModel"
             x:Class="CryptoScanner.Config.Views.TraderTakeProfitView">

    <HeaderedContentControl Classes="groupbox" Header="Take profit">
        <StackPanel Margin="8" Spacing="12">

            <!-- Strategy -->
            <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Strategy:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StrategyList}"
                          SelectedValue="{Binding TakeProfitStrategy, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Key}"
                          SelectedValueBinding="{Binding Value}"
                          FontSize="12"/>
            </Grid>

            <!-- Add Dust to TP -->
            <CheckBox IsChecked="{Binding AddDustToTp, Mode=TwoWay}"
                      Content="Add dust to TP"
                      FontSize="12"/>

            <!-- Add/Remove TP level Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Content="Add TP level"
                        Command="{Binding AddTpCommand}"
                        Width="130"
                        FontSize="12"/>
                <Button Content="Remove TP level"
                        Command="{Binding RemoveTpCommand}"
                        Width="130"
                        FontSize="12"/>
            </StackPanel>

            <!-- TP Levels List - SettingsTrading.TpList defaults to a single 0.75% / 100% level.
                 The LAST level's Quantity % is always treated as "the rest", whatever is typed there. -->
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TpItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TpItemViewModel">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>

                                    <!-- Profit Percentage -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Profit %:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Percentage, Mode=TwoWay, StringFormat=N2}"
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>

                                    <!-- Quantity Percentage -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Quantity %:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Factor, Mode=TwoWay, StringFormat=N2}"
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
