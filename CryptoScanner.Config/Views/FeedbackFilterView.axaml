<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="220"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:FeedbackFilterViewModel"
             x:Class="CryptoScanner.Config.Views.FeedbackFilterView">

    <HeaderedContentControl Classes="groupbox" Header="Performance feedback (auto-dempen)">
        <StackPanel Margin="8" Spacing="4">

            <!-- Active toggle -->
            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                      Content="Active"
                      FontSize="12"/>

            <!-- Max lookback days -->
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Lookback (days)"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="140"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MaxLookbackDays, Mode=TwoWay}"
                               Minimum="1" Maximum="90" Increment="1"
                               IsEnabled="{Binding IsActive}"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="120"
                               FormatString="0"/>
            </Grid>

            <!-- Min signals before blocking -->
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Min signals"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="140"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MinSignals, Mode=TwoWay}"
                               Minimum="2" Maximum="50" Increment="1"
                               IsEnabled="{Binding IsActive}"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="120"
                               FormatString="0"/>
            </Grid>

            <!-- Block threshold % -->
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Block if win% below"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="140"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding BlockThresholdPercent, Mode=TwoWay}"
                               Minimum="0" Maximum="100" Increment="5"
                               IsEnabled="{Binding IsActive}"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="120"
                               FormatString="0"/>
            </Grid>

            <!-- Re-enable hours -->
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Re-enable after (hours)"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="140"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding ReEnableHours, Mode=TwoWay}"
                               Minimum="1" Maximum="168" Increment="1"
                               IsEnabled="{Binding IsActive}"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="120"
                               FormatString="0"/>
            </Grid>

            <!-- Log checkbox -->
            <CheckBox IsChecked="{Binding Log, Mode=TwoWay}"
                      Content="Log block/unblock events"
                      FontSize="12"
                      Margin="0,4,0,0"/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
