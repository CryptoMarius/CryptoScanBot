<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="400"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderDcaViewModel"
             x:Class="CryptoScanner.Config.Views.TraderDcaView">

    <HeaderedContentControl Classes="groupbox" Header="DCA">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- DCA Method Settings -->
            <StackPanel Spacing="8">
                
                <!-- Order Type -->
                <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Order Type:" VerticalAlignment="Center" 
                               Margin="0,0,12,0" FontSize="12"/>
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding OrderTypeList}"
                              SelectedValue="{Binding SelectedOrderType, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Key}"
                              SelectedValueBinding="{Binding Value}"
                              FontSize="12"/>
                </Grid>

                <!-- Strategy -->
                <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Strategy:" VerticalAlignment="Center" 
                               Margin="0,0,12,0" FontSize="12"/>
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding StrategyList}"
                              SelectedValue="{Binding SelectedStrategy, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Key}"
                              SelectedValueBinding="{Binding Value}"
                              FontSize="12"/>
                </Grid>

                <!-- Pricing -->
                <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Pricing:" VerticalAlignment="Center" 
                               Margin="0,0,12,0" FontSize="12"/>
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding PricingList}"
                              SelectedValue="{Binding SelectedPricing, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Key}"
                              SelectedValueBinding="{Binding Value}"
                              FontSize="12"/>
                </Grid>

                <!-- Add/Remove Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Content="Add DCA" 
                            Command="{Binding AddDcaCommand}"
                            Width="130"
                            FontSize="12"/>
                    <Button Content="Remove DCA" 
                            Command="{Binding RemoveDcaCommand}"
                            Width="130"
                            FontSize="12"/>
                </StackPanel>

            </StackPanel>

            <!-- DCA Items List -->
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DcaItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DcaItemViewModel">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Header}" 
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    
                                    <!-- Percentage -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Percentage:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding Percentage, Mode=TwoWay, StringFormat=N2}" 
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>

                                    <!-- Factor -->
                                    <Grid ColumnDefinitions="Auto,*,130" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="Factor:" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,12,0" FontSize="12"/>
                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding Factor, Mode=TwoWay, StringFormat=N2}" 
                                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
