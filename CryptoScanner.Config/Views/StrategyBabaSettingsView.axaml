<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="540"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:StrategyBabaSettingsViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyBabaSettingsView">

    <StackPanel Spacing="8">

        <HeaderedContentControl Classes="groupbox" Header="Mean Reversion Bands (VWAP volume-weighted)">
            <StackPanel Margin="4" Spacing="4">

                <!-- VWMA / vw-stdev length -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="VWMA / volume-weighted-stdev window for the VWAP basis (fit ≈ 50).">
                    <TextBlock Grid.Column="0" Text="Length (VWAP/vw-stdev):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding Length, Mode=TwoWay}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- vw-stdev multiplier -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Volume-weighted-stdev multiplier: basis ± Mult × vwStdev (the VWAP-band width; fit ≈ 2.5). Higher = wider band = fewer signals.">
                    <TextBlock Grid.Column="0" Text="Multiplier (vw-stdev):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding Mult, Mode=TwoWay, StringFormat=N2}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- ATR length -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Fast ATR length added on top of the vw-stdev band (optional angular shape).">
                    <TextBlock Grid.Column="0" Text="ATR length:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding AtrLength, Mode=TwoWay}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- ATR multiplier -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Multiplier on the fast ATR term: band = Mult × vwStdev + AtrMult × ATR. 0 = pure VWAP bands; higher = more angular and wider.">
                    <TextBlock Grid.Column="0" Text="ATR multiplier:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding AtrMult, Mode=TwoWay, StringFormat=N1}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- RSI confluence (overbought/oversold LEVELS come from the Indicators tab → RSI) -->
                <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                          Content="Require RSI overbought/oversold" FontSize="12"
                          ToolTip.Tip="Only fire a short on an upper-band break when RSI ≥ overbought, and a long on a lower-band break when RSI ≤ oversold. The overbought/oversold levels are taken from the Indicators tab (RSI settings)."/>

                <!-- Stochastic OS/OB gate -->
                <CheckBox IsChecked="{Binding RequireStochOsOb, Mode=TwoWay}"
                          Content="Require Stochastic oversold/overbought" FontSize="12"
                          ToolTip.Tip="When on, a long signal also requires Stochastic to be oversold and a short signal requires Stochastic to be overbought (uses the global Stoch thresholds)."/>

                <!-- Multi-timeframe consensus count -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Number of consecutive higher timeframes that must also confirm a band break. 0 = single-timeframe (normal). Example: 1 means the next higher TF must also show a break.">
                    <TextBlock Grid.Column="0" Text="TF consensus count:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding TimeframeConsensusCount, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- Only if lux 5m at the configured threshold -->
                <Grid ColumnDefinitions="Auto,*,80,Auto" RowDefinitions="Auto"
                      ToolTip.Tip="Long needs Lux5mValue ≤ -threshold; short needs Lux5mValue ≥ +threshold. 50 = previous default; raise toward 100 for stricter signals.">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding OnlyIfLux5m, Mode=TwoWay}"
                              Content="Only if lux 5m at"
                              VerticalAlignment="Center"
                              FontSize="12"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding Lux5mPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="8,0,4,0"
                             IsEnabled="{Binding OnlyIfLux5m}"/>
                    <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                    <CheckBox IsChecked="{Binding CheckTrendPrimaryDirection, Mode=TwoWay}"
                              Content="Trade with the primary trend"
                              FontSize="12"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding TrendPrimaryDirectionCount, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                             IsEnabled="{Binding CheckTrendPrimaryDirection}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                    <CheckBox IsChecked="{Binding CheckTrendSecondaryDirection, Mode=TwoWay}"
                              Content="Trade with the secondary trend"
                              FontSize="12"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding TrendSecondaryDirectionCount, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                             IsEnabled="{Binding CheckTrendSecondaryDirection}"/>
                </Grid>

                <CheckBox IsChecked="{Binding CheckPriceAboveMa200, Mode=TwoWay}"
                          Content="Check price above/below MA200"
                          FontSize="12"
                          ToolTip.Tip="Long: only fire when price is above MA200. Short: only fire when price is below MA200."/>
                <Grid ColumnDefinitions="Auto,8,80,16,Auto,8,80" Margin="24,0,0,0"
                      IsEnabled="{Binding CheckPriceAboveMa200}">
                    <TextBlock Grid.Column="0" Text="Min distance %"
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding Ma200MinDistancePercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                             ToolTip.Tip="Minimum distance from MA200 as percentage (0 = disabled)."/>
                    <TextBlock Grid.Column="4" Text="Confirm candles"
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="6"
                             Text="{Binding Ma200ConfirmationCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                             ToolTip.Tip="Number of preceding candles that must also close on the correct side of MA200 (0 = disabled)."/>
                </Grid>

                <!-- Zone confirmation (OR over enabled types) -->
                <CheckBox IsChecked="{Binding UseDlzZone, Mode=TwoWay}"
                          Content="Require DLZ zone rejection" FontSize="12"
                          ToolTip.Tip="Only fire when the band break was also a rejection at a DLZ zone."/>
                <CheckBox IsChecked="{Binding UseFvgZone, Mode=TwoWay}"
                          Content="Require FVG zone rejection" FontSize="12"
                          ToolTip.Tip="Only fire when the band break was also a rejection at an FVG zone."/>
                <CheckBox IsChecked="{Binding UseSmcZone, Mode=TwoWay}"
                          Content="Require SMC zone rejection" FontSize="12"
                          ToolTip.Tip="Only fire when the band break was also a rejection at an SMC order block."/>

            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Stop-loss">
            <StackPanel Margin="4" Spacing="4">

                <!-- Stop-loss -->
                <CheckBox IsChecked="{Binding UseStopLoss, Mode=TwoWay}"
                          Content="Use stop-loss" FontSize="12"
                          ToolTip.Tip="When on, the signal passes its own percentage based stop-loss (SLStdevFactor × vwStdev) to the trader. When off, the trader uses its default stop-loss."/>
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="SL distance = SLStdevFactor × vwStdev below the lower band (long) or above the upper band (short). Factor 1.0 = one full band-width below the break level.">
                    <TextBlock Grid.Column="0" Text="Stop-loss stdev factor:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding SLStdevFactor, Mode=TwoWay, StringFormat=N1}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Slide filter">
            <StackPanel Margin="4" Spacing="4">

                <!-- Slide (glijbaan) filter -->
                <CheckBox IsChecked="{Binding UseSlideFilter, Mode=TwoWay}"
                          Content="Suppress signals into an ongoing slide" FontSize="12"
                          ToolTip.Tip="Skip LONG signals during a DOWN-slide and SHORT signals during an UP-slide (don't trade into an efficient one-way move). Symmetric."/>
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Lookback window (bars) over which the slide is measured.">
                    <TextBlock Grid.Column="0" Text="Slide window:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding SlideWindow, Mode=TwoWay}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Minimum Kaufman efficiency (0..1): net move / total path. Higher = stricter (only very straight slides count).">
                    <TextBlock Grid.Column="0" Text="Slide min efficiency:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding SlideMinEfficiency, Mode=TwoWay, StringFormat=N2}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Minimum net move over the window, in percent, for it to count as a slide.">
                    <TextBlock Grid.Column="0" Text="Slide min move %:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding SlideMinMovePercent, Mode=TwoWay, StringFormat=N1}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

            </StackPanel>
        </HeaderedContentControl>

    </StackPanel>

</UserControl>
