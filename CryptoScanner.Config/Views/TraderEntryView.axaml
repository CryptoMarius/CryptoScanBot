<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="180"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderEntryViewModel"
             x:Class="CryptoScanner.Config.Views.TraderEntryView">

    <HeaderedContentControl Classes="groupbox" Header="Entry">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- Order Type -->
            <Grid ColumnDefinitions="Auto,*,250" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Order Type:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding OrderTypeList}"
                          SelectedValue="{Binding EntryOrderType, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Key}"
                          SelectedValueBinding="{Binding Value}"
                          FontSize="12"/>
            </Grid>

            <!-- Remove Time -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Remove time:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding EntryRemoveTime, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="candles" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <!-- Limit entry below (long) or above (short) the signal price -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto"
                  ToolTip.Tip="Only for a limit entry: place the order this percentage better than the signal price - below it for a long, above it for a short - so the entry waits for a pullback. 0 places it at the signal price. A pullback that does not come within the remove time cancels the entry.">
                <TextBlock Grid.Column="0" Text="Limit below signal price:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding EntryLimitOffsetPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
