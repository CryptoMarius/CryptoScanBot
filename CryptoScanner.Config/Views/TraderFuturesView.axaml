<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderFuturesViewModel"
             x:Class="CryptoScanner.Config.Views.TraderFuturesView">

    <HeaderedContentControl Classes="groupbox" Header="Futures">
        <StackPanel Margin="8" Spacing="8">
            
            <!-- Margin (Cross/Isolated) -->
            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Margin:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2" 
                          SelectedIndex="{Binding CrossOrIsolated, Mode=TwoWay}"
                          FontSize="12">
                    <ComboBoxItem Content="Cross"/>
                    <ComboBoxItem Content="Isolated"/>
                </ComboBox>
            </Grid>

            <!-- Leverage -->
            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Leverage:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" 
                         Text="{Binding Leverage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
