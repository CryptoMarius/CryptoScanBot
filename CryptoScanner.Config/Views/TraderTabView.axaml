<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:controls="using:Avalonia.Controls"
             xmlns:settings="using:CryptoScanner.Config.Views"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderTabViewModel"
             x:Class="CryptoScanner.Config.Views.TraderTabView">

    <TabControl Grid.Row="2" Margin="0">
        <TabItem Header="Trader common" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <settings:TraderMiscSettingsView DataContext="{Binding TraderMiscSettingsViewModel}" />
                    <settings:TraderEntryConditionsView DataContext="{Binding TraderEntryConditionsViewModel}" />
                    <settings:TraderFuturesView DataContext="{Binding TraderFuturesViewModel}" />
                    <settings:TraderEntryView DataContext="{Binding TraderEntryViewModel}" />
                    <settings:TraderTakeProfitView DataContext="{Binding TraderTakeProfitViewModel}" />
                    <settings:TraderStopLossView DataContext="{Binding TraderStopLossViewModel}" />
                    <settings:TraderDcaView DataContext="{Binding TraderDcaViewModel}" />
                </WrapPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Trader long" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="4">
                    <!-- Col 0: Strategies -->
                    <!-- Col 0: Strategies with the intervals underneath; both are chip boxes now,
                         so they fit in one column and leave room for the barometer. -->
                    <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                        <settings:StrategyView DataContext="{Binding TraderStrategyLongViewModel}" />
                        <settings:IntervalView DataContext="{Binding TraderIntervalLongViewModel}" />
                    </StackPanel>
                    <!-- Col 1: Trend interval filter + Symbol trend filter (primary + secondary) -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <settings:TrendIntervalFilterView DataContext="{Binding TraderTrendIntervalFilterLongViewModel}" />
                        <settings:SymbolTrendFilterView DataContext="{Binding TraderSymbolTrendFilterLongViewModel}" />
                        <settings:SymbolTrendFilterView DataContext="{Binding TraderSymbolTrendFilterSecondaryLongViewModel}" />
                        <settings:MarketRsiFilterView DataContext="{Binding TraderMarketRsiFilterLongViewModel}" />
                        <settings:MarketStateFilterView DataContext="{Binding TraderMarketStateFilterLongViewModel}" />
                        <settings:EntryFiltersView DataContext="{Binding TraderEntryFiltersLongViewModel}" />
                        <settings:MarketExitView DataContext="{Binding TraderMarketExitLongViewModel}" />
                    </StackPanel>
                    <!-- Col 2: Intervals -->
                    <!-- Col 3: Barometer -->
                    <!-- The intervals moved under the strategies in col 0, so the barometer is col 2 now. -->
                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                        <settings:BarometerFilterView DataContext="{Binding TraderBarometerFilterLongViewModel}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Trader short" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="4">
                    <!-- Col 0: Strategies -->
                    <!-- Col 0: Strategies with the intervals underneath; both are chip boxes now,
                         so they fit in one column and leave room for the barometer. -->
                    <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                        <settings:StrategyView DataContext="{Binding TraderStrategyShortViewModel}" />
                        <settings:IntervalView DataContext="{Binding TraderIntervalShortViewModel}" />
                    </StackPanel>
                    <!-- Col 1: Trend interval filter + Symbol trend filter (primary + secondary) -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <settings:TrendIntervalFilterView DataContext="{Binding TraderTrendIntervalFilterShortViewModel}" />
                        <settings:SymbolTrendFilterView DataContext="{Binding TraderSymbolTrendFilterShortViewModel}" />
                        <settings:SymbolTrendFilterView DataContext="{Binding TraderSymbolTrendFilterSecondaryShortViewModel}" />
                        <settings:MarketRsiFilterView DataContext="{Binding TraderMarketRsiFilterShortViewModel}" />
                        <settings:MarketStateFilterView DataContext="{Binding TraderMarketStateFilterShortViewModel}" />
                        <settings:EntryFiltersView DataContext="{Binding TraderEntryFiltersShortViewModel}" />
                        <settings:MarketExitView DataContext="{Binding TraderMarketExitShortViewModel}" />
                    </StackPanel>
                    <!-- Col 2: Intervals -->
                    <!-- Col 3: Barometer -->
                    <!-- The intervals moved under the strategies in col 0, so the barometer is col 2 now. -->
                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                        <settings:BarometerFilterView DataContext="{Binding TraderBarometerFilterShortViewModel}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>

</UserControl>
