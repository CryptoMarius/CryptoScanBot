<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyBbmaTabViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyBbmaTabView">

    <Grid>
        <settings:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
    </Grid>

</UserControl>
