<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:StrategyViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyView">

    <UserControl.Styles>
        <StyleInclude Source="avares://CryptoScanner.Config/Views/ChipStyles.axaml"/>
    </UserControl.Styles>

    <StackPanel >
        <HeaderedContentControl Classes="groupbox" Header="Strategies">
            <HeaderedContentControl.Tag>
                <!-- On the frame of the groupbox at the right, opposite the caption. It sits in Tag
                     because the shared groupbox style renders the Header as a plain TextBlock and
                     would drop any interactive content put into it; see App.axaml. -->
                <Button Content="&#x25BC;"
                        Padding="6,0" FontSize="10" Height="16" MinHeight="16"
                        ToolTip.Tip="Select all, select none, or copy from another side.">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Select all"  Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="Select none" Command="{Binding SelectNoneCommand}"/>
                            <Separator/>
                            <MenuItem Header="Copy from Long"  Command="{Binding CopyFromLongCommand}"/>
                            <MenuItem Header="Copy from Short" Command="{Binding CopyFromShortCommand}"/>
                            <Separator/>
                            <MenuItem Command="{Binding CopyFromCrossTabLongCommand}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Copy from "/><Run Text="{Binding CrossTabLabel}"/><Run Text="/Long"/>
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding CopyFromCrossTabShortCommand}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Copy from "/><Run Text="{Binding CrossTabLabel}"/><Run Text="/Short"/>
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </HeaderedContentControl.Tag>
            <DockPanel LastChildFill="True">
                <!-- The switched-on strategies as chips; a click on the box opens the full list of
                     checkboxes in a flyout, in columns so that it fits on the screen. -->
                <Border Classes="chipBox" Width="340" Margin="4"
                        PointerPressed="ChipBox_PointerPressed"
                        ToolTip.Tip="Click to choose the strategies; the x on a chip removes it.">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="chipFlyout">
                            <ItemsControl ItemsSource="{Binding StrategyList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" MaxHeight="440"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  MinWidth="150" Margin="0,0,12,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <Grid ColumnDefinitions="*,Auto">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding StrategyList}" IsVisible="{Binding ShowChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="chip" IsVisible="{Binding IsEnabled}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"/>
                                            <Button Classes="chipRemove" Content="&#x2715;" Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="0" Classes="chipPlaceholder"
                                   Text="None selected"
                                   IsVisible="{Binding !ShowChips}"/>
                        <TextBlock Grid.Column="1" Classes="chipArrow" Text="&#x25BC;"/>
                    </Grid>
                </Border>
            </DockPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
