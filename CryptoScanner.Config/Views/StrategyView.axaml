<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:StrategyViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyView">

    <StackPanel >
        <HeaderedContentControl Classes="groupbox" Header="Strategies">
            <DockPanel LastChildFill="True">
                <!-- Top toolbar: "Copy from..." popup. Placed inside the content area because
                     the shared groupbox style renders the Header as a plain TextBlock and would
                     drop any interactive content put into HeaderedContentControl.Header. -->
                <Button DockPanel.Dock="Top" Content="&#x25BC;"
                        HorizontalAlignment="Right" Padding="6,2" FontSize="11"
                        Margin="0,0,0,4"
                        ToolTip.Tip="Select all, select none, or copy from another side.">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Select all"  Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="Select none" Command="{Binding SelectNoneCommand}"/>
                            <Separator/>
                            <MenuItem Header="Copy from Long"  Command="{Binding CopyFromLongCommand}"/>
                            <MenuItem Header="Copy from Short" Command="{Binding CopyFromShortCommand}"/>
                            <Separator/>
                            <MenuItem Command="{Binding CopyFromCrossTabLongCommand}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Copy from "/><Run Text="{Binding CrossTabLabel}"/><Run Text="/Long"/>
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding CopyFromCrossTabShortCommand}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Copy from "/><Run Text="{Binding CrossTabLabel}"/><Run Text="/Short"/>
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding StrategyList}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
