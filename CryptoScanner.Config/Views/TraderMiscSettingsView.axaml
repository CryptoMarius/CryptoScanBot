<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="220"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderMiscSettingsViewModel"
             x:Class="CryptoScanner.Config.Views.TraderMiscSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Common">
        <StackPanel Spacing="4" Margin="6">

            <!-- Trade Via -->
            <Grid ColumnDefinitions="Auto,*,170" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Trading:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding TradeViaList}"
                          SelectedValue="{Binding TradeVia, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Key}"
                          SelectedValueBinding="{Binding Value}"
                          FontSize="12"/>
            </Grid>

            <!-- Sound Trade Notification -->
            <CheckBox IsChecked="{Binding SoundTradeNotification, Mode=TwoWay}"
                      Content="Sound trade notification"
                      FontSize="12"/>

            <!-- Disable New Positions -->
            <CheckBox IsChecked="{Binding DisableNewPositions, Mode=TwoWay}"
                      Content="Disable new positions"
                      FontSize="12"/>

            <!-- Log Canceled Orders -->
            <CheckBox IsChecked="{Binding LogCanceledOrders, Mode=TwoWay}"
                      Content="Log cancelled orders"
                      FontSize="12"/>

            <!-- Cool Down Time -->
            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto"
                  ToolTip.Tip="Minutes after the last fill on a symbol (entry, DCA, take profit or stop loss) in which no NEW position may be opened on it. Stops laddering into the same coin. A position that is still waiting for its entry to fill is exempt, so a newer signal can replace it.">
                <TextBlock Grid.Column="0" Text="Cool down time (m):"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding GlobalBuyCooldownTime, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Signal cool down after a trade -->
            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto"
                  ToolTip.Tip="Minutes after the last fill on a symbol in which no SIGNAL is created for it at all. Cool down time above holds off opening a position; this one stops the signal from being produced in the first place. Keep it at or above the coarsest base interval you run.">
                <TextBlock Grid.Column="0" Text="Signal cool down after trade (m):"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding SignalCooldownAfterTradeTime, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Cool down after a losing trade -->
            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto"
                  ToolTip.Tip="Minutes to stay out of a symbol after a position on it closed at a LOSS, counted from that close. Replaces the cool down time above while it lasts, so it only ever makes the wait longer. Zero switches it off. A position that timed out without buying anything does not count as a loss.">
                <TextBlock Grid.Column="0" Text="Cool down after loss (m):"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding LossCooldownTime, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Close a position that has been open too long -->
            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto"
                  ToolTip.Tip="Days a position may stay open before it is closed at whatever the market offers, counted from the moment it was created. Zero switches it off. Decimals are allowed, so 0.5 is twelve hours. Meant for the rare position that walks away and never comes back: it holds capital that cannot be put to work anywhere else.">
                <TextBlock Grid.Column="0" Text="Close position after (days):"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding MaxPositionDurationDays, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Slot Limits -->
            <HeaderedContentControl Classes="groupbox" Header="Slot limits" Margin="0,2,0,0">
                <StackPanel Margin="6" Spacing="4">

                    <!-- Long Slots -->
                    <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="Long:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontSize="12"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SlotsMaximalLong, Mode=TwoWay}"
                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                    </Grid>

                    <!-- Short Slots -->
                    <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="Short:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontSize="12"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SlotsMaximalShort, Mode=TwoWay}"
                                 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                    </Grid>

                </StackPanel>
            </HeaderedContentControl>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
