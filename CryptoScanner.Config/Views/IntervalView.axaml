<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:IntervalViewModel"
             x:Class="CryptoScanner.Config.Views.IntervalView">

    <StackPanel Spacing="10">
        <HeaderedContentControl Classes="groupbox" Header="Intervals" Padding="10">
            <HeaderedContentControl.Tag>
                <!-- On the frame of the groupbox at the right, opposite the caption. It sits in Tag
                     because the shared groupbox style renders the Header as a plain TextBlock and
                     would drop any interactive content put into it; see App.axaml. -->
                <Button Content="&#x25BC;"
                        Padding="6,0" FontSize="10" Height="16" MinHeight="16"
                        IsEnabled="{Binding IntervalsEnabled}"
                        ToolTip.Tip="Select all, select none, or copy from another side.">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Select all"  Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="Select none" Command="{Binding SelectNoneCommand}"/>
                            <Separator/>
                            <MenuItem Header="Copy from Long"  Command="{Binding CopyFromLongCommand}"/>
                            <MenuItem Header="Copy from Short" Command="{Binding CopyFromShortCommand}"/>
                            <Separator/>
                            <MenuItem Command="{Binding CopyFromCrossTabLongCommand}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Copy from "/><Run Text="{Binding CrossTabLabel}"/><Run Text="/Long"/>
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding CopyFromCrossTabShortCommand}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <Run Text="Copy from "/><Run Text="{Binding CrossTabLabel}"/><Run Text="/Short"/>
                                    </TextBlock>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </HeaderedContentControl.Tag>
            <DockPanel LastChildFill="True">
                <!-- Only the strategy tabs show this one; off means the strategy follows the
                     intervals that are ticked for its side, which is what an empty list stands for. -->
                <CheckBox DockPanel.Dock="Top"
                          IsChecked="{Binding UseCustom, Mode=TwoWay}"
                          IsVisible="{Binding ShowUseCustom}"
                          Content="Use custom intervals for this strategy"
                          Margin="0,0,0,4"
                          FontSize="12"
                          ToolTip.Tip="Off: the strategy runs on the intervals that are ticked for its side on the Signals tab."/>
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,*" IsEnabled="{Binding IntervalsEnabled}">
        
                <!-- Column Headers -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Minutes" FontWeight="SemiBold" 
                           Margin="0,4,24,10" HorizontalAlignment="Left"/>
        
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Hours" FontWeight="SemiBold" 
                           Margin="0,4,24,10" HorizontalAlignment="Left"/>
        
                <TextBlock Grid.Column="2" Grid.Row="0" Text="Days/Weeks" FontWeight="SemiBold" 
                           Margin="0,4,24,10" HorizontalAlignment="Left"/>

                <!-- Column 1: Minutes -->
                <ItemsControl Grid.Column="0" Grid.Row="1" ItemsSource="{Binding MinuteIntervals}" Margin="0,0,24,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, Mode=TwoWay}"
                                      Content="{Binding Name}" Margin="0,2" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Column 2: Hours -->
                <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding HourIntervals}" Margin="0,0,24,0"> 
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, Mode=TwoWay}"
                                      Content="{Binding Name}" Margin="0,2" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Column 3: Days/Weeks -->
                <ItemsControl Grid.Column="2" Grid.Row="1" ItemsSource="{Binding DayIntervals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, Mode=TwoWay}"
                                      Content="{Binding Name}" Margin="0,2" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
            </DockPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
