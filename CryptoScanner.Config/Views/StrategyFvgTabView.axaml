<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyFvgTabViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyFvgTabView">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="5">
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="5" HorizontalAlignment="Left">
                <settings:SoundAndColorsView Grid.Row="0" Grid.Column="0" DataContext="{Binding SoundAndColorsViewModel}" />
                <settings:StrategyFvgSettingsView Grid.Row="1" Grid.Column="0" DataContext="{Binding StrategyFvgSettingsViewModel}" />
                <settings:IntervalView Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" DataContext="{Binding IntervalViewModel}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            </Grid>
            <settings:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
