<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategySbmTabViewModel"
             x:Class="CryptoScanner.Config.Views.StrategySbmTabView">

    <ScrollViewer>
        <StackPanel>
            <settings:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" Margin="4" RowSpacing="0" >
                <settings:StrategySbmSettingsView Grid.Row="0" Grid.Column="0" DataContext="{Binding StrategySbmSettingsViewModel}" />
                <settings:StrategySbmSettingsMethodsView Grid.Row="0" Grid.Column="1" DataContext="{Binding StrategySbmSettingsMethodsViewModel}" />
            </Grid>
            <settings:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
