<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="290" d:DesignHeight="140"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:StrategyDlzSettingsZoomedBoxViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyDlzSettingsZoomedBoxView">

    <HeaderedContentControl Classes="groupbox" Header="Settings zoomed box">
        <StackPanel Margin="8" Spacing="8">
            
            <!-- Zoom in on lower intervals -->
            <CheckBox IsChecked="{Binding ZoomLowerTimeFrames, Mode=TwoWay}"
                      Content="Zoom in on lower intervals"
                      FontSize="12"/>

            <!-- Minimum zoomed percentage -->
            <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Minimum zoomed percentage:" VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" Text="{Binding MinimumZoomedPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Maximum zoomed percentage -->
            <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Maximum zoomed percentage:" VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" Text="{Binding MaximumZoomedPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
