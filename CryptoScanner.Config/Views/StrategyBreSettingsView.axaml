<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="520"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:StrategyBreSettingsViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyBreSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- Donchian band lookback -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Donchian lookback for the outer bands, computed over the PREVIOUS N candles (Pine default 20).">
                <TextBlock Grid.Column="0" Text="Band length:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BandLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Outer band multiplier -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Outer band multiplier: middle ± halfRange × (mult / 2.5) (Pine default 3.2). Higher = wider bands = fewer signals.">
                <TextBlock Grid.Column="0" Text="Band multiplier:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding OuterMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- DIDO cloud length (chart only) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="DIDO cloud: EMA/ATR length for the middle cloud on the chart (Pine default 20). Chart only, no effect on the signal.">
                <TextBlock Grid.Column="0" Text="DIDO length (chart):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding DidoLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- DIDO cloud width (chart only) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="DIDO cloud width: basis ± ATR × mult (Pine default 1.0). Chart only, no effect on the signal.">
                <TextBlock Grid.Column="0" Text="DIDO width (chart):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding DidoMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- WGHM trend filter -->
            <CheckBox IsChecked="{Binding UseTrendFilter, Mode=TwoWay}"
                      Content="Use WGHM trend filter (Hull MA)" FontSize="12"
                      ToolTip.Tip="When on, a long also requires close above the Hull MA and a short requires close below it. The WGHM line is drawn on the chart when enabled."/>

            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Hull MA length for the WGHM trend filter (Pine default 55).">
                <TextBlock Grid.Column="0" Text="WGHM (HMA) length:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding HmaLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- RSI filter -->
            <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                      Content="Use RSI filter" FontSize="12"
                      ToolTip.Tip="When on, a long requires RSI (this or the previous candle) at or below oversold and a short requires RSI at or above overbought."/>

            <Grid ColumnDefinitions="Auto,80,20,Auto,50,20,Auto,50,*" RowDefinitions="Auto"
                  ToolTip.Tip="RSI length and the overbought/oversold thresholds (Pine defaults 14 / 70 / 30).">
                <TextBlock Grid.Column="0" Text="RSI length / OB / OS:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding RsiLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBox Grid.Column="4"
                         Text="{Binding RsiOverbought, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBox Grid.Column="7"
                         Text="{Binding RsiOversold, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Stochastic-RSI filter -->
            <CheckBox IsChecked="{Binding UseStochFilter, Mode=TwoWay}"
                      Content="Use Stochastic RSI filter" FontSize="12"
                      ToolTip.Tip="When on, a long requires %K or %D at or below oversold and a short requires %K or %D at or above overbought."/>

            <Grid ColumnDefinitions="Auto,50,20,Auto,50,20,Auto,50,*" RowDefinitions="Auto"
                  ToolTip.Tip="Stochastic RSI length, %K smoothing and %D smoothing (Pine defaults 14 / 3 / 3).">
                <TextBlock Grid.Column="0" Text="Stoch length / K / D:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding StochLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBox Grid.Column="4"
                         Text="{Binding StochKLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBox Grid.Column="7"
                         Text="{Binding StochDLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,50,20,Auto,50,*" RowDefinitions="Auto"
                  ToolTip.Tip="Stochastic RSI overbought/oversold thresholds (Pine defaults 80 / 20).">
                <TextBlock Grid.Column="0" Text="Stoch OB / OS:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding StochOverbought, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBox Grid.Column="4"
                         Text="{Binding StochOversold, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Stacking rule -->
            <CheckBox IsChecked="{Binding AllowStack, Mode=TwoWay}"
                      Content="Allow stacked signals on a stronger break (HYPE style)" FontSize="12"
                      ToolTip.Tip="When on, a new signal fires on every higher High / lower Low while price keeps stretching beyond the band. When off only the first candle of a break run fires."/>

            <!-- Hand the signal's own (percentage based) stop-loss to the trader -->
            <CheckBox IsChecked="{Binding UseStopLoss, Mode=TwoWay}"
                      Content="Use stop-loss" FontSize="12"
                      ToolTip.Tip="When on, the signal passes the band-width percentage (the chart label) as stop-loss to the trader. When off, no stop-loss is handed over (null) and the trader uses its default percentage stop-loss."/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
