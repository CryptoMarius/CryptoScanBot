<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="160"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:VolumeFilterViewModel"
             x:Class="CryptoScanner.Config.Views.VolumeFilterView">

    <HeaderedContentControl Classes="groupbox" Header="Relative volume filter">
        <StackPanel Margin="8" Spacing="4">

            <!-- Active toggle -->
            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                      Content="Active"
                      FontSize="12"/>

            <!-- Min / Max RelVol range -->
            <Grid ColumnDefinitions="Auto,100,30,100" RowDefinitions="Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="RelVol range"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="80"/>
                <TextBox Grid.Column="1"
                         Text="{Binding MinRelVol, Mode=TwoWay, StringFormat=N2}"
                         IsEnabled="{Binding IsActive}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBlock Grid.Column="2" Text=".."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"/>
                <TextBox Grid.Column="3"
                         Text="{Binding MaxRelVol, Mode=TwoWay, StringFormat=N2}"
                         IsEnabled="{Binding IsActive}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Lookback period -->
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Lookback candles"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="80"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding Lookback, Mode=TwoWay}"
                               Minimum="5" Maximum="200" Increment="1"
                               IsEnabled="{Binding IsActive}"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="120"
                               FormatString="0"/>
            </Grid>

            <!-- Log checkbox -->
            <CheckBox IsChecked="{Binding Log, Mode=TwoWay}"
                      Content="Log if outside boundaries"
                      FontSize="12"
                      Margin="0,4,0,0"/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
