<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:StrategyTabViewModel"
             x:Class="CryptoScanner.Config.Views.StrategyTabView">

    <TabControl x:Name="StrategyTabControl" Grid.Row="2" Margin="0" >
		<!-- All strategy tabs are added dynamically from the plugin ConfigViews (see the code-behind). -->
	</TabControl>

</UserControl>
