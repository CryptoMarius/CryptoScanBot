<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderStopLossViewModel"
             x:Class="CryptoScanner.Config.Views.TraderStopLossView">

    <HeaderedContentControl Classes="groupbox" Header="Stop loss">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- Stop Loss Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Stop loss trigger %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="Distance from the entry/DCA anchor at which the stop-limit order triggers."/>
                <TextBox Grid.Column="2" 
                         Text="{Binding StopLossPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <!-- Stop Loss Limit Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Stop loss worst fill %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="Worst acceptable fill price, further from entry than the trigger. Must be larger than the trigger %; auto-corrected if not."/>
                <TextBox Grid.Column="2"
                         Text="{Binding StopLossLimitPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12" />
            </Grid>

            <!-- Profit lock: move the SL to protect profit once the position is far enough in the green -->
            <CheckBox IsChecked="{Binding MoveSlToBreakEven, Mode=TwoWay}"
                      Content="Profit lock"
                      FontSize="12"
                      ToolTip.Tip="Once the position reaches the trigger % below, the SL moves to the stop loss % above break-even to lock in profit. Open DCA orders are cancelled at that point."/>

            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto"
                  IsVisible="{Binding MoveSlToBreakEven}">
                <TextBlock Grid.Column="0" Text="Profit lock trigger %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="How far above break-even (below for a short) the price has to reach before the profit lock arms itself. The whole candle has to be past that level (the low for a long, the high for a short), so a wick through the trigger does not arm the lock. E.g. 2% arms the lock once a whole candle sits 2% in profit."/>
                <TextBox Grid.Column="2"
                         Text="{Binding MoveSlToBreakEvenPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"
                         IsEnabled="{Binding MoveSlToBreakEven}" />
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,190,Auto" RowDefinitions="Auto"
                  IsVisible="{Binding MoveSlToBreakEven}">
                <TextBlock Grid.Column="0" Text="Profit lock method:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="What happens once the trigger is reached. A fixed stop is placed once and stays there; a trailing stop follows the price at a fixed distance and only ever moves towards the take profit."/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding ProfitLockMethodList}"
                          SelectedValue="{Binding MoveSlToBreakEvenMethod, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding Key}"
                          SelectedValueBinding="{Binding Value}"
                          FontSize="12"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto"
                  IsVisible="{Binding IsFixedProfitLock}">
                <TextBlock Grid.Column="0" Text="Profit lock stop loss %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="Where the SL is placed once the trigger is reached, measured from break-even. Keep it below the trigger to leave room between the price and the stop; e.g. trigger 3% with stop loss 1.5% locks in 1.5% profit and gives the position 1.5% of room. A value above the trigger is capped to the trigger."/>
                <TextBox Grid.Column="2"
                         Text="{Binding MoveSlToBreakEvenSlPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"
                         IsEnabled="{Binding MoveSlToBreakEven}" />
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto"
                  IsVisible="{Binding IsTrailingProfitLock}">
                <TextBlock Grid.Column="0" Text="Profit lock trailing %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="How far behind the price the SL follows once the trigger is reached: below the highest price for a long, above the lowest for a short. It only moves towards the take profit, so a pullback leaves it where it was."/>
                <TextBox Grid.Column="2"
                         Text="{Binding MoveSlToBreakEvenTrailPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"
                         IsEnabled="{Binding MoveSlToBreakEven}" />
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
