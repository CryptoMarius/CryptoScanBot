<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:TraderStopLossViewModel"
             x:Class="CryptoScanner.Config.Views.TraderStopLossView">

    <HeaderedContentControl Classes="groupbox" Header="Stop loss">
        <StackPanel Margin="8" Spacing="12">
            
            <!-- Stop Loss Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Stop loss trigger %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="Distance from the entry/DCA anchor at which the stop-limit order triggers."/>
                <TextBox Grid.Column="2" 
                         Text="{Binding StopLossPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <!-- Stop Loss Limit Percentage -->
            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Stop loss worst fill %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"
                           ToolTip.Tip="Worst acceptable fill price, further from entry than the trigger. Must be larger than the trigger %; auto-corrected if not."/>
                <TextBox Grid.Column="2"
                         Text="{Binding StopLossLimitPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12" />
            </Grid>

            <!-- SL protection: move the stop to break-even once the position is far enough in profit -->
            <CheckBox IsChecked="{Binding MoveSlToBreakEven, Mode=TwoWay}"
                      Content="Move SL to break-even when in profit"
                      FontSize="12"
                      ToolTip.Tip="Once the position reaches the percentage below in profit, the stop-loss is pulled to the break-even price and kept there. Open DCA orders are cancelled at that point (paper-trade only)."/>

            <Grid ColumnDefinitions="Auto,*,100,Auto" RowDefinitions="Auto"
                  IsVisible="{Binding MoveSlToBreakEven}">
                <TextBlock Grid.Column="0" Text="Break-even at profit %:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding MoveSlToBreakEvenPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"
                         IsEnabled="{Binding MoveSlToBreakEven}" />
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
