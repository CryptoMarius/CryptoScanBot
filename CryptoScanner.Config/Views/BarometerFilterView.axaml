<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="230"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:BarometerFilterViewModel"
             x:Class="CryptoScanner.Config.Views.BarometerFilterView">

    <HeaderedContentControl Classes="groupbox" Header="Barometer filter">
        <StackPanel Margin="8" Spacing="4">
            
            <!-- 15m interval -->
            <settings:BarometerFilterRangeView DataContext="{Binding Interval15m}" />

            <!-- 30m interval -->
            <settings:BarometerFilterRangeView DataContext="{Binding Interval30m}" />

            <!-- 1h interval -->
            <settings:BarometerFilterRangeView DataContext="{Binding Interval1h}" />

            <!-- 4h interval -->
            <settings:BarometerFilterRangeView DataContext="{Binding Interval4h}" />

            <!-- 1d interval -->
            <settings:BarometerFilterRangeView DataContext="{Binding Interval1d}" />

            <!-- Consensus active + min consensus -->
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ConsensusActive, Mode=TwoWay}"
                          Content="Min consensus"
                          FontSize="12"
                          VerticalAlignment="Center"
                          MinWidth="80"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MinConsensus, Mode=TwoWay}"
                               IsEnabled="{Binding ConsensusActive}"
                               Minimum="1" Maximum="5" Increment="1"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="110"
                               FormatString="0"/>
            </Grid>

            <!-- Market breadth: percentage of the coins that rose over the last hour (0..100) -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding BreadthActive, Mode=TwoWay}"
                          Content="Breadth 1h %"
                          ToolTip.Tip="Percentage of the coins of the quote that rose over the last hour must lie between these two"
                          FontSize="12"
                          VerticalAlignment="Center"
                          MinWidth="80"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding BreadthMinimum, Mode=TwoWay}"
                               IsEnabled="{Binding BreadthActive}"
                               Minimum="0" Maximum="100" Increment="5"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="80"
                               FormatString="0"/>
                <TextBlock Grid.Column="2" Text=".." VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="3"
                               Value="{Binding BreadthMaximum, Mode=TwoWay}"
                               IsEnabled="{Binding BreadthActive}"
                               Minimum="0" Maximum="100" Increment="5"
                               Height="26" FontSize="12" Padding="4,2"
                               CornerRadius="4" Width="80"
                               FormatString="0"/>
            </Grid>

            <!-- Log checkbox -->
            <CheckBox IsChecked="{Binding Log, Mode=TwoWay}"
                      Content="Log if outside boundaries"
                      FontSize="12"
                      Margin="0,4,0,0"/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
