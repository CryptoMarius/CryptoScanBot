<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:controls="using:Avalonia.Controls"
             xmlns:settings="using:CryptoScanner.Config.Views"
             xmlns:vm="using:CryptoScanner.Config.ViewModels"
             x:DataType="vm:AnalyzerTabViewModel"
             x:Class="CryptoScanner.Config.Views.AnalyzerTabView">

    <TabControl Grid.Row="2" Margin="0">
        <TabItem Header="Analyze common" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <settings:AnalyzerCommonView DataContext="{Binding AnalyzerCommonViewModel}" />
                </WrapPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Analyze long" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="4">
                    <!-- Col 0: Strategies -->
                    <settings:StrategyView Grid.Column="0"
                        DataContext="{Binding AnalyzerStrategyLongViewModel}" />
                    <!-- Col 1: Trend interval filter + Market trend filter -->
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                        <settings:TrendIntervalFilterView DataContext="{Binding AnalyzerTrendIntervalFilterLongViewModel}" />
                        <settings:MarketTrendFilterView DataContext="{Binding AnalyzerMarketTrendFilterLongViewModel}" />
                    </StackPanel>
                    <!-- Col 2: Intervals + Barometer -->
                    <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">
                        <settings:IntervalView DataContext="{Binding AnalyzerIntervalLongViewModel}" />
                        <settings:BarometerFilterView DataContext="{Binding AnalyzerBarometerFilterLongViewModel}" />
                    </StackPanel>
                    <!-- Col 3: Volume + Feedback -->
                    <StackPanel Grid.Column="3" Spacing="16" VerticalAlignment="Top" IsVisible="false">
                        <settings:VolumeFilterView DataContext="{Binding AnalyzerVolumeFilterLongViewModel}" />
                        <settings:FeedbackFilterView DataContext="{Binding AnalyzerFeedbackFilterLongViewModel}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Analyze short" FontSize="15" FontWeight="Bold" Margin="0,0,0,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="4">
                    <!-- Col 0: Strategies -->
                    <settings:StrategyView Grid.Column="0"
                        DataContext="{Binding AnalyzerStrategyShortViewModel}" />
                    <!-- Col 1: Trend interval filter + Market trend filter -->
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                        <settings:TrendIntervalFilterView DataContext="{Binding AnalyzerTrendIntervalFilterShortViewModel}" />
                        <settings:MarketTrendFilterView DataContext="{Binding AnalyzerMarketTrendFilterShortViewModel}" />
                    </StackPanel>
                    <!-- Col 2: Intervals + Barometer -->
                    <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">
                        <settings:IntervalView DataContext="{Binding AnalyzerIntervalShortViewModel}" />
                        <settings:BarometerFilterView DataContext="{Binding AnalyzerBarometerFilterShortViewModel}" />
                    </StackPanel>
                    <!-- Col 3: Volume + Feedback -->
                    <StackPanel Grid.Column="3" Spacing="16" VerticalAlignment="Top" IsVisible="false">
                        <settings:VolumeFilterView DataContext="{Binding AnalyzerVolumeFilterShortViewModel}" />
                        <settings:FeedbackFilterView DataContext="{Binding AnalyzerFeedbackFilterShortViewModel}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>

</UserControl>
