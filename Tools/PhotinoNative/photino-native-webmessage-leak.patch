+// UTF-8 to UTF-16 conversion that lives on the stack of the caller. ToUTF16String below allocates
+// a std::wstring with new and never deletes it, so every call leaked the converted text. For the
+// one-off conversions at window creation that is a few kilobytes; for SendWebMessage, which
+// Blazor calls for every render batch, it was the whole working set of a long running window
+// (tryphotino/photino.Native issue 165). The hot paths use this helper instead.
+static std::wstring ToUTF16(AutoString source)
+{
+	std::wstring wide;
+	int inLen = (int)strlen((char*)source);
+	int result = MultiByteToWideChar(CP_UTF8, 0, (char*)source, inLen, NULL, 0);
+	if (result > 0)
+	{
+		wide.resize(result, 0);
+		MultiByteToWideChar(CP_UTF8, 0, (char*)source, inLen, &wide[0], result);
+	}
+	return wide;
+}
+
 void Photino::NavigateToString(AutoString content)
 {
-	content = ToUTF16String(content);
-	_webviewWindow->NavigateToString(content);
+	std::wstring wide = ToUTF16(content);
+	_webviewWindow->NavigateToString(wide.c_str());
 }
 
 void Photino::NavigateToUrl(AutoString url)
 {
-	url = ToUTF16String(url);
-	_webviewWindow->Navigate(url);
+	std::wstring wide = ToUTF16(url);
+	_webviewWindow->Navigate(wide.c_str());
 }
 
