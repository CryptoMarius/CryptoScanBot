<Project Sdk="Microsoft.NET.Sdk">

  <!--
    All concrete exchange implementations (Binance, Bybit, Kraken, ...) live here instead of in
    CryptoScanner.Core. The namespace is deliberately unchanged (CryptoScanner.Core.Exchange.*),
    so no source file outside this project needed a different using.

    The core keeps the abstractions (ExchangeBase, CandleBase, SymbolBase, SubscriptionManager,
    ...) because the core itself uses them. The other direction - the core needing a CONCRETE
    exchange - runs through ExchangeRegistry, which this project fills in at startup. That keeps
    the reference one-way: Exchanges -> Core.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CryptoScanner.Core.Exchange</RootNamespace>
    <Configurations>Debug;Release;MaxOS-X-Debug</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The same reasoning as in CryptoScanner.Core.csproj: the rules an exchange applies to its own
      instrument list are internal, and a test that has to make them public first would widen the
      api for everyone. OkxProduct is the first of those to be tested.
    -->
    <InternalsVisibleTo Include="CryptoScanner.CoreTests" />
  </ItemGroup>

  <!--
    Files that were already excluded from the build in CryptoScanner.Core.csproj before the move.
    They are kept on disk (order/trade/asset handling that is not wired up yet), but they do not
    compile.
  -->
  <ItemGroup>
    <Compile Remove="Binance\Perpetual\Asset.cs" />
    <Compile Remove="Binance\Perpetual\Order.cs" />
    <Compile Remove="Binance\Perpetual\SubscriptionPriceTicker.cs" />
    <Compile Remove="Binance\Perpetual\SubscriptionUserTicker.cs" />
    <Compile Remove="Binance\Perpetual\Trade.cs" />
    <Compile Remove="Binance\Spot\Asset.cs" />
    <Compile Remove="Binance\Spot\FetchTradesForOrder.cs" />
    <Compile Remove="Binance\Spot\Order.cs" />
    <Compile Remove="Binance\Spot\SubscriptionPriceTicker.cs" />
    <Compile Remove="Binance\Spot\SubscriptionUserTicker.cs" />
    <Compile Remove="Binance\Spot\Trade.cs" />
    <Compile Remove="BybitApi\Perpetual\Asset.cs" />
    <Compile Remove="BybitApi\Perpetual\FetchTradesForOrder.cs" />
    <Compile Remove="BybitApi\Perpetual\Order.cs" />
    <Compile Remove="BybitApi\Perpetual\SubscriptionPriceTicker.cs" />
    <Compile Remove="BybitApi\Perpetual\SubscriptionUserTicker.cs" />
    <Compile Remove="BybitApi\Perpetual\Trade.cs" />
    <Compile Remove="BybitApi\Spot\Asset.cs" />
    <Compile Remove="BybitApi\Spot\FetchTradesForOrder.cs" />
    <Compile Remove="BybitApi\Spot\Order.cs" />
    <Compile Remove="BybitApi\Spot\SubscriptionPriceTicker.cs" />
    <Compile Remove="BybitApi\Spot\SubscriptionUserTicker.cs" />
    <Compile Remove="BybitApi\Spot\Trade.cs" />
    <Compile Remove="Mexc\Spot\Order.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Alpaca.Markets" Version="7.2.2" />
    <PackageReference Include="Binance.Net" Version="13.5.1" />
    <PackageReference Include="BitMart.Net" Version="4.4.0" />
