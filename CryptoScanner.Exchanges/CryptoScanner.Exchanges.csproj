    <PackageReference Include="JK.OKX.Net" Version="5.4.0" />
    <PackageReference Include="JKorf.Coinbase.Net" Version="4.5.0" />
    <PackageReference Include="KrakenExchange.Net" Version="8.4.0" />
    <PackageReference Include="Kucoin.Net" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoScanner.Core\CryptoScanner.Core.csproj" />
  </ItemGroup>

</Project>
