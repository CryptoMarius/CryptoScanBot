<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/avalonia"
        xmlns:vm="using:CryptoScanner.ViewModels"
        xmlns:views="using:CryptoScanner.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="950"
        Width="1300" Height="1000"
        x:DataType="vm:ChartWindowViewModel"
        x:Class="CryptoScanner.Views.ChartWindow"
        Title="{Binding WindowTitle}">

    <Grid ColumnDefinitions="220,*" RowDefinitions="*">
        
        <!-- Left Panel - Controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Width="220">
            <StackPanel Margin="8,0,0,2" Spacing="2">
                
                <!-- Symbol Selector 
                <views:SymbolSelectorView DataContext="{Binding SymbolSelector}"/>
                -->

                <HeaderedContentControl Classes="groupbox" Header="Symbol" Padding="4">
                    <StackPanel >
                        <Grid ColumnDefinitions="Auto,80" RowDefinitions="Auto,Auto,Auto" Margin="4" Grid.RowSpacing="2">
                            <!-- Quote Base -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Base:" VerticalAlignment="Center" 
                                        Margin="0,0,8,0" FontSize="12" Width="50"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" 
                                        ItemsSource="{Binding SymbolSelector.BaseSymbols}"
                                        SelectedItem="{Binding SymbolSelector.SelectedBase, Mode=TwoWay}"
                                        FontSize="12" Width="80.0"/>

                            <!-- Quote -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Quote:" VerticalAlignment="Center" 
                                        Margin="0,0,8,0" FontSize="12" Width="50"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" 
                                        ItemsSource="{Binding SymbolSelector.QuoteSymbols}"
                                        SelectedItem="{Binding SymbolSelector.SelectedQuote, Mode=TwoWay}"
                                        FontSize="12" Width="80.0"/>

                            <!-- Interval -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Interval:" VerticalAlignment="Center" 
                                        Margin="0,0,8,0" FontSize="12" Width="50"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" 
                                        ItemsSource="{Binding SymbolSelector.Intervals}"
                                        SelectedItem="{Binding SymbolSelector.SelectedInterval, Mode=TwoWay}"
                                        FontSize="12" Width="80.0"/>
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Trend Settings -->
                <HeaderedContentControl Classes="groupbox" Header="Trend">
                    <StackPanel Margin="4,8,0,2" >
                        <ComboBox SelectedIndex="{Binding TrendSettings.TrendType, Mode=TwoWay}"
                                  FontSize="12">
                            <ComboBoxItem Content="Primary trend"/>
                            <ComboBoxItem Content="Secondary trend"/>
                        </ComboBox>
                        <CheckBox IsChecked="{Binding TrendSettings.ShowZigZag, Mode=TwoWay}"
                                  Content="Show zigzag"
                                  FontSize="12"/>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- FIB Settings -->
                <HeaderedContentControl Classes="groupbox" Header="FIB">
                    <StackPanel Margin="4" >
                        <ComboBox SelectedIndex="{Binding FibSettings.FibTrend, Mode=TwoWay}"
                                  FontSize="12">
                            <ComboBoxItem Content="Primary trend"/>
                            <ComboBoxItem Content="Secondary trend"/>
                        </ComboBox>
                        <CheckBox IsChecked="{Binding FibSettings.ShowFibRetracement, Mode=TwoWay}"
                                  Content="Show fib retracement"
                                  FontSize="12"/>
                        <CheckBox IsChecked="{Binding FibSettings.ShowZigZag, Mode=TwoWay}"
                                  Content="Show zigzag"
                                  FontSize="12"/>
                    </StackPanel>
                </HeaderedContentControl>


                <!-- Display Options -->
                <HeaderedContentControl Classes="groupbox" Header="Display">
                    <StackPanel Margin="4" Spacing="-7">
                        <!-- not working, turned off -->
                        <!--
                        <CheckBox IsChecked="{Binding DisplayOptions.Transparent, Mode=TwoWay}" Content="Transparent" FontSize="12"/>
                        -->
						<CheckBox IsChecked="{Binding DisplayOptions.ShowCandles, Mode=TwoWay}" Content="Candles" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowPoints, Mode=TwoWay}" Content="Pivot points" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowSignals, Mode=TwoWay}" Content="Signals" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowPositions, Mode=TwoWay}" Content="Positions" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowDlzZones, Mode=TwoWay}" Content="DLZ Zones" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowFvgZones, Mode=TwoWay}" Content="FVG Zones" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowSmcZones, Mode=TwoWay}" Content="SMC Zones" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowDtb, Mode=TwoWay}" Content="DTB" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowBollingerBand, Mode=TwoWay}" Content="Bollinger Bands" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowKeltnerChannel, Mode=TwoWay}" Content="Keltner Channel" FontSize="12"/>
                        <!-- AtrRb, Baba, Slide and BRE checkboxes are now generated dynamically via PluginOverlays -->
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowPSar, Mode=TwoWay}" Content="PSar" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowNweRepainting, Mode=TwoWay}" Content="NWE (repainting)" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowNwe, Mode=TwoWay}" Content="NWE (not repainting)" FontSize="12"/>
                        <CheckBox IsChecked="{Binding DisplayOptions.ShowSmaLinesSbm, Mode=TwoWay}" Content="SBM SMA lines" FontSize="12"/>
						<CheckBox x:Name="ShowBbmaCheckBox" IsChecked="{Binding DisplayOptions.ShowBbma, Mode=TwoWay}" Content="BBMA lines" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowStoch, Mode=TwoWay}" Content="Stochastic" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowRsi, Mode=TwoWay}" Content="RSI" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowLux, Mode=TwoWay}" Content="Lux" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowMacd, Mode=TwoWay}" Content="MACD" FontSize="12"/>
						<CheckBox IsChecked="{Binding DisplayOptions.ShowVolume, Mode=TwoWay}" Content="Volume" FontSize="12"/>
						<ItemsControl ItemsSource="{Binding DisplayOptions.PluginOverlays}" Margin="0">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Spacing="-7"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Label}" FontSize="12"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
                </HeaderedContentControl>

				<!-- Action Buttons -->
				<Grid ColumnDefinitions="*,*,*" Margin="0,6,4,0" ColumnSpacing="4">
					<Button Grid.Column="0" Content="Refresh"
							Command="{Binding RefreshCommand}"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Padding="4,4"/>
					<Button Grid.Column="1" Content="Calc"
							Command="{Binding CalculateCommand}"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Padding="4,4"
							ToolTip.Tip="Calculate"/>
					<!-- Open Trading App -->
					<Button Grid.Column="2"
							Command="{Binding OpenTradingAppCommand}"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Padding="4,4"
							ToolTip.Tip="Open trading app">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<Viewbox Width="14" Height="14" VerticalAlignment="Center">
								<Canvas Width="24" Height="24">
									<!-- Flame -->
									<Path Data="M9,18 L12,23 L15,18 L13,17 L12,19 L11,17 Z" Fill="#FF6B35"/>
									<!-- Fins -->
									<Path Data="M8,14 L4,18 L8,18 Z" Fill="#E63946"/>
									<Path Data="M16,14 L20,18 L16,18 Z" Fill="#E63946"/>
									<!-- Body -->
									<Path Data="M12,2 C14,4 16,7 16,12 L16,18 L8,18 L8,12 C8,7 10,4 12,2 Z"
										  Fill="#F1FAEE" Stroke="#1D3557" StrokeThickness="0.8"/>
									<!-- Window -->
									<Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="8"
											 Fill="#457B9D" Stroke="#1D3557" StrokeThickness="0.6"/>
								</Canvas>
							</Viewbox>
							<TextBlock Text="" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</Grid>
				<!-- not working, turned off -->
				<Button Content="Zoom last" Command="{Binding ZoomLastCommand}" HorizontalAlignment="Center" IsEnabled="false" IsVisible="false"/>



			</StackPanel>
        </ScrollViewer>

        <!-- Right Panel - Chart -->
        <!-- Host the PlotView directly in XAML (like DashboardPositionsView) so OxyPlot's control
             theme is applied. Hosting a VM-created PlotView via <ContentControl Content="{Binding PlotView}"/>
             left it without a template → a completely blank panel. Model is bound to PlotModel; the
             code-behind hands this control + controller back to the VM. -->
        <Border Grid.Column="1" Margin="8">
            <oxy:PlotView x:Name="PlotViewControl"
                          Model="{Binding PlotModel}"
                          Background="Transparent" />
        </Border>
    </Grid>
    

</Window>
