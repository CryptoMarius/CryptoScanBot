@inherits LayoutComponentBase
@using CryptoScanner.Core.Core
@using CryptoScanner.Core.Diagnostics
@using CryptoScanner.Core.Enums
@using CryptoScanner.Core.Excel
@using CryptoScanner.Core.Context
@using CryptoScanner.Core.Exchange
@using CryptoScanner.Core.Helpers
@using CryptoScanner.Core.Messages
@using CommunityToolkit.Mvvm.Messaging
@using CryptoScanner.Core.Signal
@using CryptoScanner.Core.Zones
@using CryptoScanner.UI.Services
@using CryptoScanner.UI.ViewModels
@using CryptoScanner.Core.Services
@using CryptoScanner.UI.Components
@inject SymbolService SymbolService
@inject SignalService SignalService
@inject GridCommandService GridCommandService
@inject ApplicationStateService StateService
@inject DashboardService DashboardService
@inject MarketIndicatorService MarketIndicatorService
@inject LogService LogService
@inject InternalBrowserService InternalBrowser
@inject IJSRuntime JS
@implements IDisposable

<div class="app-root" data-theme="@_theme">

    <!-- Title bar: Menu + title (matches Avalonia MainWindow TitleBarGrid) -->
    <div class="titlebar">
        <div class="titlebar-menu">
            <div class="menu-dropdown">
                <span class="menu-dropdown-trigger">File</span>
                <div class="menu-dropdown-content">
                    <label class="menu-check-item">
                        <input type="checkbox" checked="@GlobalData.Settings.Signal.Active"
                               @onchange="ToggleScanner" />
                        Analyzer active
                    </label>
                    <label class="menu-check-item">
                        <input type="checkbox" checked="@GlobalData.Settings.Trading.Active"
                               @onchange="ToggleTrader" />
                        Trader active
                    </label>
                    <label class="menu-check-item">
                        <input type="checkbox" checked="@GlobalData.Settings.Signal.SoundsActive"
                               @onchange="ToggleSounds" />
                        Play sounds
                    </label>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="OpenSettings">Scanner configuration</span>
                    <span class="menu-action-item" @onclick="OnRefreshInformation">Refresh information</span>
                    <span class="menu-action-item" @onclick="OnClearLogAndTickers">Clear log and tickers</span>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="OnOpenDataFolder">Open data folder</span>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="OnExit">Exit</span>
                </div>
            </div>
            <div class="menu-dropdown">
                <span class="menu-dropdown-trigger">Tools</span>
                <div class="menu-dropdown-content">
                    @* Opens the separate browser window. The Tradingview tab it replaces could only
                       show the anonymous embed widget, because www.tradingview.com refuses to be
                       loaded inside a frame. *@
                    <span class="menu-action-item" @onclick="OnOpenTradingViewWindow">Open TradingView window</span>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="OnExportExchangeToExcel">Export exchange info to Excel</span>
                    <span class="menu-action-item" @onclick="OnExportSignalsToExcel">Export signals to Excel</span>
                    <span class="menu-action-item" @onclick="OnExportPositionsToExcel">Export positions to Excel</span>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="OnDumpMemoryInfo">Dump memory info</span>
                    <span class="menu-action-item" @onclick="OnCleanupCandles">Cleanup candles and old files</span>
                    <span class="menu-action-item" @onclick="OnCalculateAllDlz">Calculate all liquidity zones</span>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="ToggleTheme">Toggle theme</span>
                </div>
            </div>
            <div class="menu-dropdown">
                <span class="menu-dropdown-trigger">Help</span>
                <div class="menu-dropdown-content">
                    <span class="menu-action-item" @onclick="OnOpenWiki">Wiki</span>
                    <div class="menu-separator"></div>
                    <span class="menu-action-item" @onclick="OpenAbout">About</span>
                </div>
            </div>
        </div>
        <span class="titlebar-title">CryptoScanBot v@(GlobalData.AppVersion) — @(DashboardService.ExchangeName)</span>
    </div>

    <!-- Dashboard info panel (matches Avalonia DashBoardInformationView, 125px).
         Its own component so a dashboard tick does not re-render the symbol sidebar as well. -->
    <DashboardPanel />


    <!-- Separator -->
    <div class="separator-line"></div>

    <!-- Main area: symbols left, tabs right -->
    <div class="main-area">

        <!-- Symbol sidebar (matches Avalonia SymbolSplitView, 300px, collapsible) -->
        @if (_sidebarVisible)
        {
            <div class="symbol-sidebar" @ref="_sidebarRef" style="width: @(_sidebarWidth)px;">
                <div class="symbol-sidebar-header">
                    <span class="symbol-sidebar-title">Symbols</span>
                    <span class="symbol-sidebar-filter">Filter:</span>
                    <input type="text" class="input-text symbol-filter-input"
                           value="@_symbolFilter"
                           @oninput="OnFilterInput"
                           @onkeydown="OnFilterKeyDown" />
                    <button class="btn sidebar-toggle-btn" @onclick="ToggleSidebar" title="Hide symbols">◄</button>
                </div>
                <div class="symbol-sidebar-content" tabindex="0" @onkeydown="OnSymbolGridKeyDown">
                    <table class="data-table" @ref="_symbolTableRef">
                        <thead @oncontextmenu="OnHeaderContextMenu" @oncontextmenu:preventDefault="true">
                            <tr>
                                @foreach (var col in _symbolColumns!.VisibleColumns)
                                {
                                    var header = _headerCallbacks.Get(col);
                                    <th class="@col.CssClass @(_dragOverColumn?.Equals(col.Column) == true ? "drag-over" : "")"
                                        data-col="@col.Column"
                                        draggable="true"
                                        @onclick="header.Sort"
                                        @ondragstart="header.DragStart"
                                        @ondragover="header.DragOver"
                                        @ondragover:preventDefault="true"
                                        @ondrop="header.Drop"
                                        @ondragend="OnHeaderDragEnd"
                                        style="@(col.Width > 0 ? $"width:{col.Width}px" : "")">
                                        @col.Header@(SymbolService.SortState.GetSortIndicator(col.Column))
                                        <div class="col-resize-handle" @onmousedown:stopPropagation="true"></div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_symbols.Count > 0)
                            {
                                @foreach (var vm in _symbols)
                                {
                                    var row = _rowCallbacks.Get(vm);
                                    <tr class="@(_selectedSymbols.Contains(vm) ? "selected" : "")"
                                        id="@SymbolRowId(vm)"
                                        @key="vm"
                                        @onclick="row.Click"
                                        @ondblclick="row.DoubleClick"
                                        @oncontextmenu="row.ContextMenu"
                                        @oncontextmenu:preventDefault="true">
                                        @foreach (var col in _symbolColumns!.VisibleColumns)
                                        {
                                            @* Avalonia wraps only the Symbol cell in a Border with the quote colour
                                               (SymbolGridView.axaml), so the tint marks the coin, not the whole row. *@
                                            <td class="@GetSymbolCellClass(col, vm)"
                                                style="@(col.Column == SymbolColumnEnum.Symbol ? vm.BackgroundStyle : "")">@GetSymbolCellValue(col, vm)</td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@_symbolColumns!.VisibleColumns.Count()" class="empty-state">
                                        @if (GlobalData.ActiveExchange == null)
                                        {
                                            <text>Start the scanner to load symbols.</text>
                                        }
                                        else
                                        {
                                            <text>No symbols match the filter.</text>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Splitter -->
            <div class="splitter-handle" @ref="_splitterRef"></div>
            <div class="splitter-line"></div>
        }
        else
        {
            <div class="sidebar-collapsed">
                <button class="btn sidebar-toggle-btn" @onclick="ToggleSidebar" title="Show symbols">►</button>
            </div>
            <div class="splitter-line"></div>
        }

        <!-- Tabbed content (matches Avalonia MainTabs) -->
        <div class="content-area">
            <div class="tab-bar">
                <NavLink class="tab" href="" Match="NavLinkMatch.All">Signals</NavLink>
                <NavLink class="tab" href="chart">Chart</NavLink>
                <NavLink class="tab" href="livedata">Live Data</NavLink>
                <NavLink class="tab" href="dashboard">Dashboard</NavLink>
                <NavLink class="tab" href="positions/open">Open positions</NavLink>
                <NavLink class="tab" href="positions/closed">Closed positions</NavLink>
                <NavLink class="tab" href="log">Log</NavLink>
            </div>

            <div class="tab-content">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <div style="padding: 10px; color: var(--red);">
                            An error occurred. <button class="btn btn-secondary" @onclick="ResetError">Retry</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>

    </div>

    @if (_contextMenuVisible)
    {
        <div class="context-menu-overlay" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="context-menu" @ref="_contextMenuRef" style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;">
            @if (_contextMenuType == ContextMenuType.SymbolRow && _contextMenuSymbol != null)
            {
                <div class="context-menu-item" @onclick="@(() => OnMenuOpenChart())">Open symbol chart</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuOpenTradingApp())">Open trading app</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuOpenTradingViewInternal())">Open TradingView internal</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuOpenTradingViewExternal())">Open TradingView external</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuOpenExchange())">Open the exchange</div>
                <div class="context-menu-separator"></div>
                <div class="context-menu-item" @onclick="@(() => OnMenuCopySymbolName())">Copy symbol name</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuCopyDataCells())">Copy all data cells</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuCalculateZones())">Calculate liquidity zones</div>
                <div class="context-menu-separator"></div>
                <div class="context-menu-item" @onclick="@(() => OnMenuExportTrend())">Export trend information to log</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuExportSymbolToExcel())">Export symbol information to Excel</div>
                <div class="context-menu-item" @onclick="@(() => OnMenuExportBarometerToExcel())">Export barometer information to Excel</div>
                <div class="context-menu-separator"></div>
                <div class="context-menu-item" @onclick="@(() => OnMenuHideSelection())">Hide grid selection</div>
            }
            else if (_contextMenuType == ContextMenuType.Header)
            {
                <div class="context-menu-item" @onclick="OnMenuAdjustColumns">Adjust Columns...</div>
            }
        </div>
    }

    @if (_shuttingDown)
    {
        <div class="shutdown-overlay">
            <div class="shutdown-box">
                <div class="shutdown-spinner"></div>
                <div>Closing down, saving candles and closing connections...</div>
            </div>
        </div>
    }

    <CryptoScanner.UI.Pages.Settings @bind-Visible="_settingsVisible" />
    <AboutDialog @bind-Visible="_aboutVisible" />

    <ColumnVisibilityDialog TEnum="SymbolColumnEnum"
                            @bind-Visible="_columnDialogVisible"
                            ColumnState="_symbolColumns"
                            OnColumnsChanged="OnColumnsVisibilityChanged" />
</div>

@code {
    private enum ContextMenuType { None, SymbolRow, Header }

    private string _theme = "dark";
    private bool _shuttingDown;
    private int _sidebarWidth = 300;
    private bool _sidebarVisible = true;
    private string _symbolFilter = "";
    private List<SymbolViewModel> _symbols = [];
    private System.Threading.Timer? _refreshTimer;
    private System.Threading.Timer? _dashboardTimer;
    private int _dashboardTickCount;
    private bool _disposed;
    private ErrorBoundary? _errorBoundary;

    private SymbolViewModel? _selectedSymbol;
    private readonly HashSet<SymbolViewModel> _selectedSymbols = [];
    private bool _contextMenuVisible;
    private ElementReference _contextMenuRef;
    private bool _contextMenuPositioned;
    private double _contextMenuX;
    private double _contextMenuY;
    private ContextMenuType _contextMenuType;
    private SymbolViewModel? _contextMenuSymbol;
    private bool _columnDialogVisible;
    private bool _settingsVisible;
    private bool _aboutVisible;

    private GridColumnState<SymbolColumnEnum>? _symbolColumns;
    private ElementReference _symbolTableRef;
    private ElementReference _sidebarRef;
    private ElementReference _splitterRef;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private bool _jsInitialized;
    private SymbolColumnEnum? _dragSourceColumn;
    private SymbolColumnEnum? _dragOverColumn;

    // Event handlers per row and per column header, created once and handed to Blazor unchanged on
    // every render. See GridCallbackCache for what that saves. Built in OnInitialized because the
    // factories capture this.
    private GridCallbackCache<SymbolViewModel, RowCallbacks> _rowCallbacks = null!;
    private GridCallbackCache<ColumnRuntimeState<SymbolColumnEnum>, HeaderCallbacks> _headerCallbacks = null!;

    private static readonly GridColumnDef<SymbolColumnEnum>[] SymbolColumnDefs =
    [
        new() { Column = SymbolColumnEnum.Id, Header = "Id", DefaultVisible = false, DefaultDisplayIndex = 0 },
        new() { Column = SymbolColumnEnum.Symbol, Header = "Symbol", CssClass = "symbol-name", DefaultVisible = true, DefaultDisplayIndex = 1 },
        new() { Column = SymbolColumnEnum.Volume, Header = "Volume", CssClass = "text-right", DefaultVisible = true, DefaultDisplayIndex = 2 },
        new() { Column = SymbolColumnEnum.Distance, Header = "Distance", CssClass = "text-right", DefaultVisible = true, DefaultDisplayIndex = 3 },
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A menu opened on the last row of a grid ran off the bottom of the screen. Move it back
        // inside the window once it has been laid out, the way Avalonia shifts its menu up.
        if (_contextMenuVisible && !_contextMenuPositioned)
        {
            _contextMenuPositioned = true;
            try
            {
                await JS.InvokeVoidAsync("cryptoScannerPopup.keepInViewport", _contextMenuRef);
            }
            catch (JSException)
            {
            }
        }
        else if (!_contextMenuVisible)
            _contextMenuPositioned = false;

        if (firstRender)
        {
            // "Follow system" can only be answered by the browser (prefers-color-scheme), so ask it
            // once and keep listening — otherwise that setting silently stayed dark.
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                bool prefersDark = await JS.InvokeAsync<bool>("cryptoScannerTheme.prefersDark");
                await JS.InvokeVoidAsync("cryptoScannerTheme.watch", _dotNetRef);
                ReportSystemPreference(prefersDark);
            }
            catch (JSException)
            {
            }
        }

        if (!_jsInitialized && _sidebarVisible)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("GridInterop.initAllResizeHandles", _symbolTableRef, _dotNetRef);
                await JS.InvokeVoidAsync("GridInterop.initSplitter", _splitterRef, _sidebarRef, _dotNetRef);
                _jsInitialized = true;
            }
            catch (JSException)
            {
            }
        }
    }

    /// <summary>The operating system switched between its light and dark theme.</summary>
    [JSInvokable]
    public void OnSystemThemeChanged(bool prefersDark)
    {
        ReportSystemPreference(prefersDark);
    }

    /// <summary>
    /// Hand the browser's prefers-color-scheme answer to the shared helper and repaint.
    /// <para>
    /// The broadcast is for the host, not for this layout: it draws the title bar of the native
    /// window and has no way of noticing that the browser has answered. Only when the answer is
    /// news - the first one, or a real change - so a "Follow system" that agrees with the guess
    /// still reaches the host once.
    /// </para>
    /// </summary>
    private void ReportSystemPreference(bool prefersDark)
    {
        bool news = !ThemeHelper.SystemPreferenceKnown || ThemeHelper.SystemPrefersDark != prefersDark;
        ThemeHelper.ReportSystemPreference(prefersDark);
        ApplyTheme();
        if (news)
            GlobalData.SendMvvmMessage(new ThemeChangedMessage());
    }

    [JSInvokable]
    public void OnColumnResized(string columnName, double newWidth)
    {
        if (Enum.TryParse<SymbolColumnEnum>(columnName, out var col))
        {
            var runtime = _symbolColumns?.Columns.FirstOrDefault(c => c.Column.Equals(col));
            if (runtime != null)
            {
                runtime.Width = newWidth;
                _symbolColumns?.SaveColumnState();
                InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public void OnSidebarResized(int newWidth)
    {
        _sidebarWidth = newWidth;
        StateService.SaveSplitterPosition("MainWindow", newWidth);
        InvokeAsync(StateHasChanged);
    }

    private void OnHeaderDragStart(SymbolColumnEnum column)
    {
        _dragSourceColumn = column;
    }

    private void OnHeaderDragOver(SymbolColumnEnum column)
    {
        if (_dragSourceColumn.HasValue && !_dragSourceColumn.Value.Equals(column))
        {
            _dragOverColumn = column;
        }
    }

    private void OnHeaderDrop(SymbolColumnEnum targetColumn)
    {
        _dragOverColumn = null;

        if (!_dragSourceColumn.HasValue || _dragSourceColumn.Value.Equals(targetColumn))
            return;

        var source = _symbolColumns?.Columns.FirstOrDefault(c => c.Column.Equals(_dragSourceColumn.Value));
        var target = _symbolColumns?.Columns.FirstOrDefault(c => c.Column.Equals(targetColumn));
        if (source == null || target == null)
            return;

        int sourceIdx = source.DisplayIndex;
        int targetIdx = target.DisplayIndex;

        foreach (var c in _symbolColumns!.Columns)
        {
            if (sourceIdx < targetIdx)
            {
                if (c.DisplayIndex > sourceIdx && c.DisplayIndex <= targetIdx)
                    c.DisplayIndex--;
            }
            else
            {
                if (c.DisplayIndex >= targetIdx && c.DisplayIndex < sourceIdx)
                    c.DisplayIndex++;
            }
        }
        source.DisplayIndex = targetIdx;

        _symbolColumns.SaveColumnState();
        _dragSourceColumn = null;

        _jsInitialized = false;
    }

    private void OnHeaderDragEnd()
    {
        _dragSourceColumn = null;
        _dragOverColumn = null;
    }

    protected override void OnInitialized()
    {
        _rowCallbacks = new(vm => new RowCallbacks
        {
            Click = e => OnSymbolRowClick(e, vm),
            DoubleClick = () => OnSymbolDoubleClick(vm),
            ContextMenu = e => OnSymbolRowContextMenu(e, vm),
        });
        _headerCallbacks = new(col => new HeaderCallbacks
        {
            Sort = () => OnSymbolSort(col.Column),
            DragStart = () => OnHeaderDragStart(col.Column),
            DragOver = () => OnHeaderDragOver(col.Column),
            Drop = () => OnHeaderDrop(col.Column),
        });

        _theme = ThemeHelper.ToCssTheme(GlobalData.Settings.General.Theme);

        // Repaint the moment the theme changes instead of on the next dashboard tick. The poll
        // below stays as a safety net for a host that sets the theme without broadcasting.
        WeakReferenceMessenger.Default.Register<ThemeChangedMessage>(this, (_, _) => ApplyTheme());
        WeakReferenceMessenger.Default.Register<ShutdownStartedMessage>(this, (_, _) =>
        {
            _shuttingDown = true;
            _ = InvokeAsync(StateHasChanged);
        });
        // The check marks in the File menu follow the same three settings as the traffic lights in
        // the dashboard panel. That panel is a separate component now, so a click there no longer
        // repaints this one; this message does. It only fires on an actual toggle, unlike the
        // dashboard tick that used to repaint the whole window (and the symbol grid with it).
        WeakReferenceMessenger.Default.Register<StatusesHaveChangedMessage>(this, (_, _) =>
        {
            if (!_disposed)
                _ = InvokeAsync(StateHasChanged);
        });

        _sidebarWidth = (int)StateService.GetSplitterPosition("MainWindow", 300);
        _sidebarVisible = !StateService.GetSymbolPanelCollapsed();

        _symbolColumns = new GridColumnState<SymbolColumnEnum>(
            "Symbol", StateService, SymbolColumnDefs,
            SymbolColumnEnum.Symbol);

        // SymbolService keeps itself up to date through the scanner messages; just take the
        // current snapshot and subscribe.
        SymbolService.SymbolsChanged += OnSymbolsChanged;
        _symbols = SymbolService.Symbols.ToList();

        _refreshTimer = new System.Threading.Timer(_ =>
        {
            if (_disposed)
                return;
            try
            {
                SymbolService.InvalidateDistances();
            }
            catch
            {
            }
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));

        // The timer stays here (one timer for the whole window), but the result of the poll is
        // picked up by DashboardPanel, which subscribes to DashboardChanged itself.
        _dashboardTimer = new System.Threading.Timer(_ =>
        {
            if (_disposed)
                return;
            try
            {
                _dashboardTickCount++;
                DashboardService.Poll();
                if (_dashboardTickCount == 1 || _dashboardTickCount % 30 == 0)
                    DashboardService.PollSlow();

                ApplyTheme();
            }
            catch
            {
            }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    /// <summary>Re-read the theme from the settings and repaint if it actually changed.</summary>
    private void ApplyTheme()
    {
        if (_disposed)
            return;
        var current = ThemeHelper.ToCssTheme(GlobalData.Settings.General.Theme);
        if (current == _theme)
            return;
        _theme = current;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSymbolsChanged()
    {
        if (_disposed)
            return;
        _symbols = SymbolService.Symbols.ToList();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnFilterInput(ChangeEventArgs e)
    {
        _symbolFilter = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void OnFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            ApplyFilter();
    }

    /// <summary>
    /// The filter box drives both the symbol panel and the signal grid, the same way Avalonia
    /// wires MainWindowViewModel.FilterTextChanged to both grids.
    /// </summary>
    private void ApplyFilter()
    {
        SymbolService.SetFilter(_symbolFilter);
        SignalService.SetFilter(_symbolFilter);
    }

    private void OnSymbolSort(SymbolColumnEnum column)
    {
        SymbolService.Sort(column);
    }

    private void ToggleSidebar()
    {
        _sidebarVisible = !_sidebarVisible;
        StateService.SaveSymbolPanelCollapsed(!_sidebarVisible);
    }

    private void ResetError()
    {
        _errorBoundary?.Recover();
    }

    private void OnSymbolRowClick(MouseEventArgs e, SymbolViewModel vm)
    {
        if (e.CtrlKey)
        {
            if (_selectedSymbols.Contains(vm))
                _selectedSymbols.Remove(vm);
            else
                _selectedSymbols.Add(vm);
            _selectedSymbol = vm;
        }
        else if (e.ShiftKey && _selectedSymbol != null)
        {
            int startIdx = _symbols.IndexOf(_selectedSymbol);
            int endIdx = _symbols.IndexOf(vm);
            if (startIdx >= 0 && endIdx >= 0)
            {
                int from = Math.Min(startIdx, endIdx);
                int to = Math.Max(startIdx, endIdx);
                _selectedSymbols.Clear();
                for (int i = from; i <= to; i++)
                    _selectedSymbols.Add(_symbols[i]);
            }
        }
        else
        {
            _selectedSymbols.Clear();
            _selectedSymbols.Add(vm);
            _selectedSymbol = vm;
        }

        SymbolService.SetSelectedSymbol(vm.Object);
    }

    // Type-ahead buffer. Characters typed shortly after one another search for a symbol starting
    // with the whole string ("OP" jumps to OP, not to P), and it resets after a short pause.
    private string _typeAhead = "";
    private DateTime _typeAheadTime = DateTime.MinValue;
    private static readonly TimeSpan TypeAheadTimeout = TimeSpan.FromMilliseconds(900);

    private static string SymbolRowId(SymbolViewModel vm) => "sym-" + vm.Symbol;

    private async Task OnSymbolGridKeyDown(KeyboardEventArgs e)
    {
        if (_symbols.Count == 0 || string.IsNullOrEmpty(e.Key))
            return;

        int current = _selectedSymbol != null ? _symbols.IndexOf(_selectedSymbol) : -1;
        int target = -1;

        // A page is however many rows actually fit, asked of the browser. It used to be a fixed 15,
        // which is most of two pages on a short sidebar and half a page on a tall one — in neither
        // case what a page key is supposed to do.
        int pageSize = 15;
        if (e.Key == "PageDown" || e.Key == "PageUp")
        {
            var anchor = _selectedSymbol ?? _symbols[0];
            try
            {
                int rows = await JS.InvokeAsync<int>("GridInterop.visibleRowCount", SymbolRowId(anchor));
                if (rows > 1)
                    pageSize = rows - 1; // one row of overlap, so you keep your bearings
            }
            catch (JSException) { }
        }

        switch (e.Key)
        {
            case "ArrowDown":
                target = current < 0 ? 0 : Math.Min(current + 1, _symbols.Count - 1);
                break;
            case "ArrowUp":
                target = current <= 0 ? 0 : current - 1;
                break;
            case "PageDown":
                target = current < 0 ? 0 : Math.Min(current + pageSize, _symbols.Count - 1);
                break;
            case "PageUp":
                target = current < 0 ? 0 : Math.Max(current - pageSize, 0);
                break;
            case "Home":
                target = 0;
                break;
            case "End":
                target = _symbols.Count - 1;
                break;

            default:
                if (e.Key.Length != 1 || !char.IsLetterOrDigit(e.Key[0]))
                    return;

                var now = DateTime.UtcNow;
                if (now - _typeAheadTime > TypeAheadTimeout)
                    _typeAhead = "";
                _typeAheadTime = now;
                _typeAhead += char.ToUpperInvariant(e.Key[0]);

                target = _symbols.FindIndex(s =>
                    s.Symbol.StartsWith(_typeAhead, StringComparison.OrdinalIgnoreCase));

                // Nothing starts with the whole buffer: treat this key as a fresh search, so
                // holding down one letter keeps stepping instead of getting stuck
                if (target < 0 && _typeAhead.Length > 1)
                {
                    _typeAhead = _typeAhead[^1..];
                    target = _symbols.FindIndex(s =>
                        s.Symbol.StartsWith(_typeAhead, StringComparison.OrdinalIgnoreCase));
                }
                break;
        }

        if (target < 0 || target >= _symbols.Count)
            return;

        var match = _symbols[target];
        _selectedSymbols.Clear();
        _selectedSymbols.Add(match);
        _selectedSymbol = match;

        // Same effect as clicking the row, otherwise the chart and the rest keep the old symbol
        SymbolService.SetSelectedSymbol(match.Object);
        StateHasChanged();

        try
        {
            await JS.InvokeVoidAsync("GridInterop.scrollRowIntoView", SymbolRowId(match));
        }
        catch (JSException) { }
    }

    private static string GetSymbolCellClass(ColumnRuntimeState<SymbolColumnEnum> col, SymbolViewModel vm)
    {
        return col.Column switch
        {
            SymbolColumnEnum.Symbol => "symbol-name",
            SymbolColumnEnum.Volume => $"text-right {vm.VolumeColorClass}",
            SymbolColumnEnum.Distance => "text-right",
            _ => "",
        };
    }

    private static string GetSymbolCellValue(ColumnRuntimeState<SymbolColumnEnum> col, SymbolViewModel vm)
    {
        return col.Column switch
        {
            SymbolColumnEnum.Id => vm.Id,
            SymbolColumnEnum.Symbol => vm.Symbol,
            SymbolColumnEnum.Volume => vm.VolumeText,
            SymbolColumnEnum.Distance => vm.DistanceText,
            _ => "",
        };
    }

