    private void OnOpenDataFolder()
    {
        var folder = GlobalData.AppDataFolder;
        if (!string.IsNullOrEmpty(folder))
        {
            try
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = folder,
                    UseShellExecute = true,
                });
            }
            catch { }
        }
    }

    /// <summary>
    /// Open the separate TradingView window on the currently selected symbol, or on its own start
    /// page when nothing is selected. Hosts that cannot open a window (no OpenBrowserWindow) fall
    /// back on the system browser, so the menu item never does nothing.
    /// </summary>
    private void OnOpenTradingViewWindow()
    {
        if (_selectedSymbol != null)
            GridCommandService.OpenTradingViewInternal(_selectedSymbol.Object);
        else if (InternalBrowser.OpenBrowserWindow != null)
            InternalBrowser.OpenBrowserWindow("");
        else
            ExternalLinkHelper.OpenSystemBrowser("https://www.tradingview.com/chart/");
    }

