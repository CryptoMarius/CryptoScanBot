    private void OnDumpMemoryInfo()
    {
        Task.Run(() =>
        {
            try
            {
                // Same dump as the Avalonia CommandShowMemoryObjects: application state, managed
                // versus native memory, heap statistics per type and the large object heap.
                // Walking the heap takes a while on a large process, hence the background task.
                GlobalData.AddTextToLogTab("Memory dump started, this can take a while...");
                string folder = MemoryDump.Execute();
                GlobalData.AddTextToLogTab($"Memory dump saved to {folder}");
            }
            catch (Exception ex)
            {
                GlobalData.AddTextToLogTab($"Memory dump failed: {ex.Message}");
            }
        });
    }

