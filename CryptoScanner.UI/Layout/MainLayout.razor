    private void ToggleTheme()
    {
        // Store the same capitalised values the Avalonia host expects ("Light"/"Dark"), so the
        // shared settings file stays valid for both applications.
        GlobalData.Settings.General.Theme = ThemeHelper.Toggle(GlobalData.Settings.General.Theme);
        _theme = ThemeHelper.ToCssTheme(GlobalData.Settings.General.Theme);
        GlobalData.SetTheme?.Invoke(GlobalData.Settings.General.Theme);
    }

    private void OnRefreshInformation()
    {
        Task.Run(async () =>
        {
            var api = GlobalData.ActiveExchange?.GetApiInstance();
            if (api == null)
                return;
            await api.Symbol.GetSymbolsAsync();
            CandleBase.UpdateVolumeDecisions();
            // The symbols and their volumes were just replaced in place. SymbolService caches the
            // formatted volume per row, so without this the column keeps the numbers it was built
            // with - the same reason the hourly refresh in ScannerSession sends it.
            GlobalData.SendMvvmMessage(new SymbolsHaveChangedMessage());
            if (ExchangeBase.KLineTicker != null)
                await ExchangeBase.KLineTicker.CheckSubscriptions();
            if (ExchangeBase.KLineTicker != null)
                await ExchangeBase.KLineTicker.SynchronizeSymbolsAsync();
            await api.Candle.GetCandlesForAllSymbolsAndIntervalsAsync();
        });
    }

