@using CryptoScanner.Core.Core
@using CryptoScanner.Core.Trader

@* Shows the paper-trading balances and lets them be corrected by hand. Reset throws everything away
   and hands out the start capital again - the same thing the emulator does at the start of a run.
   Mirrors the Avalonia AssetWindow; the actions themselves live in PaperAssetsEditor. *@

@if (Visible)
{
    <div class="modal-overlay" @onclick="OnClose" @oncontextmenu:preventDefault="true">
    </div>
    <div class="modal-dialog assets-dialog" @onclick:stopPropagation="true">
        <div class="modal-header">
            <span class="modal-title">Paper assets</span>
        </div>
        <div class="modal-body assets-body">

            <div class="assets-summary">@_summary</div>

            @* The balances. Only Total is editable: Locked follows from the orders that are open
               right now and Free follows from Total minus Locked. *@
            <div class="assets-list">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width: 120px;">Asset</th>
                            <th style="width: 130px;">Total</th>
                            <th style="width: 120px;">Locked</th>
                            <th>Free</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _rows.Count; i++)
                        {
                            int index = i;
                            <tr>
                                <td>@_rows[index].Name</td>
                                @* Text and not a number field: the cell shows the rounded amount the
                                   Avalonia grid shows, and "9,954.12" is not a number a browser field
                                   accepts. *@
                                <td>
                                    <input type="text" class="input-number assets-total-input"
                                           value="@_rows[index].TotalText"
                                           @onchange="e => SetTotal(index, e.Value)" />
                                </td>
                                <td class="text-right">@_rows[index].LockedText</td>
                                <td class="text-right">@_rows[index].FreeText</td>
                            </tr>
                        }
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="4" class="empty-state">No assets</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Book a balance by hand. The only way to get a coin into the list that is not in it: a
               balance that reaches zero is dropped, so it cannot be corrected in the grid either. *@
            <div class="assets-add">
                <span>Add asset:</span>
                <input type="text" class="input-number assets-add-name" placeholder="BTC"
                       @bind="_newAssetName"
                       title="The coin to book a balance for. A coin that is already in the list is set to this amount." />
                <span>Amount:</span>
                <input type="text" class="input-number assets-add-amount"
                       @bind="_newAssetAmount"
                       title="The balance in the coin itself, above zero." />
                <button class="btn" @onclick="OnAddClick"
                        title="Book this balance. It is recorded as a manual correction, so the capital line does not read it as profit.">
                    Add
                </button>
            </div>

            <!-- Start over -->
            <div class="assets-reset">
                <span>Start capital:</span>
                <input type="number" class="input-number assets-start-capital" min="0" step="1000"
                       value="@_startCapital"
                       @onchange="e => _startCapital = ParseDecimal(e.Value)"
                       title="Amount handed out per traded quote coin when you press Reset, except the coins with a start capital of their own. Not used at all when the default asset list in the settings holds anything - that list is handed out instead." />
                <button class="btn" @onclick="OnResetClick"
                        title="Throw every paper balance away and hand out the starting balances again: the default asset list from the settings when there is one, and otherwise the start capital for each traded quote coin.">
                    Reset to start capital
                </button>
            </div>

        </div>
        <div class="modal-footer">
            <button class="btn" @onclick="Reload">Refresh</button>
            <button class="btn btn-primary" @onclick="OnApply">Apply</button>
            <button class="btn btn-secondary" @onclick="OnClose">Close</button>
        </div>
    </div>

    @* Deliberately behind a confirmation: this wipes the balances of a running paper session.
       Placed after the dialog so it lands on top of it. *@
    <ConfirmDialog @bind-Visible="_confirmResetVisible"
                   Title="Reset paper assets"
                   Message="Throw every paper balance away and hand out the start capital again?"
                   OnConfirmed="OnResetConfirmed" />
}

@code {
    /// <summary>One editable row. Only Total can be changed, Locked and Free are shown as text.</summary>
    private sealed class AssetRow
    {
        public string Name { get; init; } = "";
        public decimal Total { get; set; }

        /// <summary>Rounded the way PaperAssetsEditor.FormatAmount rounds it, so both screens agree.</summary>
        public string TotalText => PaperAssetsEditor.FormatAmount(Name, Total);

        public string LockedText { get; init; } = "";
        public string FreeText { get; init; } = "";

        /// <summary>The amount this row started with, so Apply only writes what the user really changed.</summary>
        public decimal OriginalTotal { get; init; }
    }

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private List<AssetRow> _rows = [];

    /// <summary>The coin and the amount of the add row, as typed - both are read as text.</summary>
    private string _newAssetName = "";
    private string _newAssetAmount = "";

    private decimal _startCapital;
    private string _summary = "";
    private bool _confirmResetVisible;

    /// <summary>Loaded once per opening, the way the Avalonia window builds its view model.</summary>
    private bool _loaded;

    protected override void OnParametersSet()
    {
        if (Visible && !_loaded)
        {
            _startCapital = GlobalData.Settings.Trading.PaperAssetStartCapital;
            Reload();
            _loaded = true;
        }
        else if (!Visible)
            _loaded = false;
    }

    private void Reload()
    {
        var exchange = GlobalData.ActiveExchange;
        _rows = [.. PaperAssetsEditor.LoadRows(exchange).Select(row => new AssetRow
        {
            Name = row.Name,
            Total = row.Total,
            LockedText = row.LockedText,
            FreeText = row.FreeText,
            OriginalTotal = row.Total,
        })];
        _summary = PaperAssetsEditor.Describe(exchange, _rows.Count);
    }

    /// <summary>Write back the rows the user actually changed.</summary>
    private void OnApply()
    {
        PaperAssetsEditor.Apply(GlobalData.ActiveExchange, _rows.Select(row => new PaperAssetEdit
        {
            Name = row.Name,
            OriginalTotal = row.OriginalTotal,
            NewTotal = row.Total,
        }));
        Reload();
    }

    /// <summary>
    /// Book the balance of the add row. Nothing happens when the coin or the amount cannot be used;
    /// the log tab says why, and what was typed stays where it is so it can be corrected.
    /// </summary>
    private void OnAddClick()
    {
        PaperAssetsEditor.TryParseAmount(_newAssetAmount, out decimal amount);
        if (!PaperAssetsEditor.Add(GlobalData.ActiveExchange, _newAssetName, amount))
            return;

        _newAssetName = "";
        _newAssetAmount = "";
        Reload();
    }

    private void OnResetClick()
    {
        _confirmResetVisible = true;
    }

    private void OnResetConfirmed()
    {
        PaperAssetsEditor.Reset(GlobalData.ActiveExchange, _startCapital);
        Reload();
    }

    private async Task OnClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    /// <summary>
    /// Take over an edited amount, and ignore anything that cannot be read as one: the balance keeps
    /// what it had, and Apply therefore writes nothing for this row. The field itself keeps showing
    /// what was typed until the list is loaded again - the rendered value did not change, so there is
    /// nothing for the renderer to put back.
    /// </summary>
    private void SetTotal(int index, object? value)
    {
        if (PaperAssetsEditor.TryParseAmount(value?.ToString(), out decimal amount))
            _rows[index].Total = amount;
    }

    private static decimal ParseDecimal(object? value) =>
        decimal.TryParse(value?.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out decimal result) ? result : 0m;
}
