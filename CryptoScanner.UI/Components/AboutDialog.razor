@using CryptoScanner.Core.Core

@if (Visible)
{
    <div class="modal-overlay" @onclick="OnClose" @oncontextmenu:preventDefault="true">
    </div>
    <div class="modal-dialog about-dialog" @onclick:stopPropagation="true">
        <div class="modal-header">
            <span class="modal-title">About CryptoScanBot</span>
        </div>
        <div class="modal-body about-body">
            @* The application icon with the logo of the exchange, the same picture the window and
               the task bar show (since 08-11-2026; before that a money bag emoji) *@
            @if (_icon != "")
            {
                <img class="about-icon-image" src="@_icon" width="80" height="80" alt="" />
            }
            <div class="about-app-name">CryptoScanBot</div>
            @* With the variant since 08-11-2026, so it is clear which of the three applications this is *@
            <div class="about-version">Version @GlobalData.AppVersion (@GlobalData.AppVariant)</div>
            @* The commit this build was made from (see BuildInfo). Left out when the build carries
               no stamp, because an empty "Build" line reads as a missing value. *@
            @if (BuildInfo.Description != "")
            {
                <div class="about-copyright">Build @BuildInfo.Description</div>
            }
            <div class="about-copyright">@_copyright</div>
            <div class="about-author">Author: @CryptoScanner.Core.Const.Constants.Author</div>
            @* The licence and where to read its full text. Both come from Constants so this dialog
               and the Avalonia About window always show the same wording. *@
            <div class="about-copyright">@CryptoScanner.Core.Const.Constants.License</div>
            <div class="about-copyright">@CryptoScanner.Core.Const.Constants.LicenseUrl</div>

            <div class="about-section-title">Application Info</div>
            <div class="about-info-list">
                <div class="about-info-row"><span>Data folder</span><span class="mono">@GlobalData.AppDataFolder</span></div>
                <div class="about-info-row"><span>Application path</span><span class="mono">@GlobalData.AppPath</span></div>
                <div class="about-info-row"><span>Exchange</span><span>@(GlobalData.ActiveExchange?.Name ?? "None")</span></div>
            </div>

            <div class="about-section-title">Supported Exchanges</div>
            <div class="about-exchange-list">
                @foreach (var name in _exchanges)
                {
                    <div class="about-exchange-item">- @name</div>
                }
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-primary" @onclick="OnClose">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private string _copyright = "";
    private string _icon = "";
    private List<string> _exchanges = [];

    protected override void OnParametersSet()
    {
        if (Visible && _exchanges.Count == 0)
        {
            _copyright = GetCopyright();
            _icon = GetIcon();
            _exchanges = GlobalData.ExchangeListName.Keys.OrderBy(x => x).ToList();
        }
    }

    private static string GetIcon()
    {
        try
        {
            return "data:image/png;base64," + Convert.ToBase64String(AppIconBuilder.BuildCurrentPng());
        }
        catch (Exception error)
        {
            ScannerLog.Logger.Error(error, "AboutDialog.GetIcon");
            return "";
        }
    }

    private static string GetCopyright()
    {
        var assembly = typeof(GlobalData).Assembly;
        var attr = assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyCopyrightAttribute), false);
        if (attr.Length > 0)
            return ((System.Reflection.AssemblyCopyrightAttribute)attr[0]).Copyright;
        return $"CryptoScanBot (c) {DateTime.Now.Year}";
    }

    private async Task OnClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
