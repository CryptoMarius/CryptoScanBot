@using CryptoScanner.UI.Models

@* The two columns of TraderEntryConditionsView: oscillator conditions on the left, trend/price
   conditions on the right. Used twice, exactly as Avalonia does — once for the global trader
   conditions and once inside a strategy's own "Entry conditions" box.

   <fieldset disabled> greys out everything at once, which is what the <Border IsEnabled="..."/>
   around the view does over there. *@
<fieldset class="entry-conditions" disabled="@Disabled">

    <div class="settings-group-body">
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckIncreasingRsi" />
            <label>RSI must be increasing/decreasing</label>
        </div>
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.WaitForRsiRecovery" />
            <label>Wait if RSI is OS/OB</label>
        </div>
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckIncreasingStoch" />
            <label>Stoch must be increasing/decreasing</label>
        </div>
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.WaitForStochRecovery" />
            <label>Wait if stoch %K is OS/OB</label>
        </div>

        @* Flush left, exactly as in TraderEntryConditionsView: the nested groupbox there carries
           Margin="0,2,0,0". Only the MA200 sub-row below is indented (Margin="24,0,0,0"). *@
        <div class="settings-group settings-group-nested">
            <div class="settings-group-header">Stoch OS/OB strength</div>
            <div class="settings-group-body">
                <div class="field" title="Window (in signal-interval bars) used to find the most-recent OS run and to compute the Z-score mean/stdev.">
                    <label>Lookback</label>
                    <span class="field-control">
                        <input type="number" class="input-number" min="0" @bind="Data.StochExtremeLookback" />
                        <span class="field-unit">bars</span>
                    </span>
                </div>
                <div class="field" title="Persistence: minimum consecutive bars stoch %K was in OS (long) / OB (short). 0 = off.">
                    <label>Min OS bars</label>
                    <span class="field-control">
                        <input type="number" class="input-number" min="0" @bind="Data.StochMinExtremeBars" />
                        <span class="field-unit">bars</span>
                    </span>
                </div>
                <div class="field" title="Absolute cumulative depth below the oversold line, summed over the lookback window. 0 = off. Start with ~20, strict 60-80+.">
                    <label>Min OS area</label>
                    <span class="field-control">
                        <input type="number" class="input-number" step="0.1" min="0" @bind="Data.StochMinExtremeArea" />
                        <span class="field-unit">∑</span>
                    </span>
                </div>
                <div class="field" title="Statistical outlier of the deepest %K in the lookback, not absolute depth. 0 = off. Start with 1.0-1.5, strict 2.0+.">
                    <label>Min |Z-score|</label>
                    <span class="field-control">
                        <input type="number" class="input-number" step="0.1" min="0" @bind="Data.StochMinExtremeZScore" />
                        <span class="field-unit">σ</span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="settings-group-body">
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckIncreasingMacd" />
            <label>MACD must be increasing/decreasing</label>
        </div>
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckFurtherPriceMove" />
            <label>Price must be increasing/decreasing</label>
        </div>
        @* The "Intervals" caption matches the TextBlock the Avalonia grid puts in front of the
           count, the same way the MA200 row captions its second field. *@
        <div class="field" title="Number of timeframes that must all show the trend in the signal direction, starting at the signal's own timeframe. 1 = this timeframe only, 2 = this one plus the next higher one. The walk stops at the daily interval (the weekly trend is not calculated).">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckTrendPrimaryDirection" />
            <label>Trade with the primary trend</label>
            <span class="field-unit @(Data.CheckTrendPrimaryDirection ? "" : "unit-disabled")">Intervals</span>
            <input type="number" class="input-number" style="width: 60px;"
                   @bind="Data.TrendPrimaryDirectionCount" disabled="@(!Data.CheckTrendPrimaryDirection)" />
        </div>
        <div class="field" title="Number of timeframes that must all show the trend in the signal direction, starting at the signal's own timeframe. 1 = this timeframe only, 2 = this one plus the next higher one. The walk stops at the daily interval (the weekly trend is not calculated).">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckTrendSecondaryDirection" />
            <label>Trade with the secondary trend</label>
            <span class="field-unit @(Data.CheckTrendSecondaryDirection ? "" : "unit-disabled")">Intervals</span>
            <input type="number" class="input-number" style="width: 60px;"
                   @bind="Data.TrendSecondaryDirectionCount" disabled="@(!Data.CheckTrendSecondaryDirection)" />
        </div>
        <div class="field">
            <input type="checkbox" class="input-checkbox" @bind="Data.CheckPriceAboveMa200" />
            <label>Price above MA200 (long) / below (short)</label>
        </div>
        @* The whole row greys out with its checkbox, the way the Avalonia Grid carries
           IsEnabled="{Binding CheckPriceAboveMa200}" over the captions as well as the fields. *@
        <div class="field indented @(Data.CheckPriceAboveMa200 ? "" : "row-disabled")"
             title="Minimum distance from MA200 as percentage (0 = disabled), and the number of preceding candles that must also close on the correct side (0 = disabled).">
            <label>Min dist %</label>
            <span class="field-control">
                <input type="number" class="input-number" step="0.1" min="0" style="width: 60px;"
                       @bind="Data.Ma200MinDistancePercentage" disabled="@(!Data.CheckPriceAboveMa200)" />
                <span class="field-unit">Candles</span>
                <input type="number" class="input-number" min="0" style="width: 60px;"
                       @bind="Data.Ma200ConfirmationCandles" disabled="@(!Data.CheckPriceAboveMa200)" />
            </span>
        </div>
        @* Watch the signal for a while before acting on it — the same row the Avalonia view puts
           under the MA200 block. *@
        <div class="field space-before"
             title="Candles of the signal's own interval to watch before stepping in, counted from the signal candle's open. Zero switches the rule off. Keep it below EntryRemoveTime, otherwise the signal expires before the wait is over and nothing is ever entered.">
            <label>Wait after signal (candles)</label>
            <span class="field-control">
                <input type="number" class="input-number" min="0" style="width: 60px;"
                       @bind="Data.EntryWaitCandles" />
                <span class="field-unit" title="How far price may run against the signal during that wait, as a positive percentage of the signal price. Above this the signal is dropped. Zero means no limit: the wait then only delays the entry.">Max against %</span>
                <input type="number" class="input-number" step="0.1" min="0" style="width: 60px;"
                       @bind="Data.EntryMaxAdversePercentage" />
            </span>
        </div>

        @* Reversal shapes to wait for inside that window. With one or more ticked the wait above
           stops being a delay and becomes a SEARCH WINDOW: the entry is taken on the first candle
           within it that forms one of these. Same nested groupbox as the Avalonia view. *@
        <div class="settings-group settings-group-nested">
            <div class="settings-group-header">Wait for a reversal shape</div>
            <div class="settings-group-body">
                <div class="settings-note">Nothing ticked leaves the wait a plain delay</div>
                <div class="field"
                     title="The reversal shapes an entry waits for. Ticking several is an OR: any one of them is enough. Which ones are worth using was measured on runs 525-531; how OFTEN a shape occurs decides whether it is usable as a filter at all.">
                    <label>Shapes</label>
                    <span class="field-control">
                        <span class="enum-list">
                            @foreach (var option in EntryConditionsData.PatternNames)
                            {
                                var name = option;
                                <label class="enum-list-item">
                                    <input type="checkbox" class="input-checkbox"
                                           checked="@Data.HasPattern(name)"
                                           @onchange="@(e => Data.TogglePattern(name, e.Value is bool on && on))" />
                                    <span>@name</span>
                                </label>
                            }
                        </span>
                    </span>
                </div>

                <hr class="settings-separator" />

                <div class="field" title="A body at or under this counts as small: the hammer's body, and the hesitant middle candle of a morning star.">
                    <label>Small body max %</label>
                    <input type="number" class="input-number" step="0.1" min="0" @bind="Data.EntryPatternShape.MaxBodyPercentage" />
                </div>
                <div class="field" title="A body at or over this counts as decisive: both candles of an engulfing or a harami, and the two outer candles of a morning star. Keeps two nearly flat candles from engulfing each other.">
                    <label>Decisive body min %</label>
                    <input type="number" class="input-number" step="0.1" min="0" @bind="Data.EntryPatternShape.MinBodyPercentage" />
                </div>
                <div class="field" title="How long the long wick has to be for a hammer (below the body) or an inverted hammer (above it).">
                    <label>Dominant wick min %</label>
                    <input type="number" class="input-number" step="0.1" min="0" @bind="Data.EntryPatternShape.MinWickPercentage" />
                </div>
                <div class="field" title="And how short the wick at the other end has to stay for that same hammer.">
                    <label>Opposite wick max %</label>
                    <input type="number" class="input-number" step="0.1" min="0" @bind="Data.EntryPatternShape.MaxOppositeWickPercentage" />
                </div>
                <div class="field" title="How far apart the two lows (or highs) of a tweezer may be and still count as equal. An exact match between two decimal prices essentially never happens.">
                    <label>Tweezer tolerance %</label>
                    <input type="number" class="input-number" step="0.1" min="0" @bind="Data.EntryPatternShape.TweezerTolerancePercentage" />
                </div>
                <div class="settings-note">All as a percentage of the candle's own range</div>
            </div>
        </div>
        @* The band break confirmation used to sit here as "Timeframe consensus count". Only the
           three band strategies could act on it, so it now lives in their own settings as
           "Band break confirmation on higher timeframes". *@
    </div>

</fieldset>

@code {
    [Parameter, EditorRequired] public EntryConditionsData Data { get; set; } = null!;

    /// <summary>Greyed out as a whole, for a strategy that follows the global conditions.</summary>
    [Parameter] public bool Disabled { get; set; }
}
