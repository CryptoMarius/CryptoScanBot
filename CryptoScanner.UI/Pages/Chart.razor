    private async Task OnPluginToggled(string key, ChangeEventArgs e)
    {
        _pluginOverlayStates[key] = e.Value is bool b && b;
        SaveSession();
        await LoadChartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ThemeHelper is what turns "Dark"/"Light"/"Default"/empty into the lower case value the
            // widget expects. Passing Settings.General.Theme straight through meant "Dark" never
            // matched the widget's === 'dark' test, so the chart rendered in its light palette while
            // the rest of the application was dark.
            var theme = ThemeHelper.ToCssTheme(GlobalData.Settings.General.Theme);

            try
            {
                await JS.InvokeVoidAsync("ChartWidget.init", theme);
                _initialized = true;
                await LoadChartAsync();
                StartAutoRefresh();
            }
            catch (JSException) { }
        }
    }

    // ------------------------------------------------------------------------------------------
    // Auto refresh
    //
    // The chart used to be a pure snapshot: it only rebuilt on a symbol/interval change, an
    // overlay toggle or the Refresh button. So a running candle never moved and a position that
    // got filled while you were watching only appeared after leaving the tab and coming back
    // (which recreates the component and therefore reloads).
    //
    // A full rebuild every tick would be wasteful, so the timer first computes a cheap signature
    // of everything the chart draws from live data and only reloads when that actually changed.
    // ------------------------------------------------------------------------------------------

    // Four times a minute. A subscription on the candle/position events would be exact, but the
    // chart draws from so many sources at once that polling a signature stays far simpler.
    private const int AutoRefreshSeconds = 15;
    private System.Threading.Timer? _autoRefreshTimer;
    private string _dataSignature = "";

    private void StartAutoRefresh()
    {
        _autoRefreshTimer?.Dispose();
        _dataSignature = BuildDataSignature();
        _autoRefreshTimer = new System.Threading.Timer(_ => AutoRefreshTick(), null,
            TimeSpan.FromSeconds(AutoRefreshSeconds), TimeSpan.FromSeconds(AutoRefreshSeconds));
    }

    private void AutoRefreshTick()
    {
        if (_disposed || GlobalData.ApplicationIsClosing || !_initialized || _loadingChart)
            return;

        try
        {
            string signature = BuildDataSignature();
            if (signature == _dataSignature)
                return;

            _dataSignature = signature;

            // The timer runs on a thread pool thread; every JS call has to go through the
            // renderer's synchronisation context.
            _ = InvokeAsync(LoadChartAsync);
        }
        catch
        {
            // A refresh that cannot even determine what changed must never take the timer down
        }
    }

    /// <summary>
    /// Everything the chart draws from live data, condensed into a string. Deliberately cheap:
    /// no snapshot copy of the candle list and no database query, just the counters and the
    /// last candle the scanner keeps in memory anyway.
    /// </summary>
    private string BuildDataSignature()
    {
        if (_currentSymbol == null)
            return "";
        if (!Enum.TryParse<CryptoIntervalPeriod>(_selectedInterval, out var period))
            return "";

        // A CLOSED position is finished history: no candle arriving now can change any of it, so
        // the signature is constant and the timer never reloads it. An open one (_windowEnd null)
        // still grows, and falls through to the live signature below.
        if (_windowStart != null && _windowEnd != null)
            return $"{_currentSymbol.Name}|{_selectedInterval}|{_windowStart:O}|{_windowEnd:O}";

        var text = new System.Text.StringBuilder();
        text.Append(_currentSymbol.Name).Append('|').Append(_selectedInterval).Append('|');

        var symbolInterval = _currentSymbol.GetSymbolInterval(period);
        var candleList = symbolInterval.CandleList;
        var last = candleList.LastCandle;

        // Count catches a new candle, close catches the running one moving, high/low catch a
        // wick that grows without the close changing.
        text.Append(candleList.Count).Append('|')
            .Append(last.OpenTime).Append('|')
            .Append(last.Close).Append('|')
            .Append(last.High).Append('|')
            .Append(last.Low).Append('|');

        // And the same four for the 1m candle, because the running candle at the right edge is built
        // from that list (CandleTools.BuildRunningCandles). Nothing above moves while a 30m interval
        // is halfway through - the closed 30m candle those counters read stays exactly as it was - so
        // without this the chart would only pick the running candle up once the interval closed,
        // which is the very lag it exists to remove.
        if (period != CryptoIntervalPeriod.interval1m && !GlobalData.IsEmulatorMode)
        {
            var last1m = _currentSymbol.GetSymbolInterval(CryptoIntervalPeriod.interval1m).CandleList.LastCandle;
            text.Append(last1m.OpenTime).Append('|')
                .Append(last1m.Close).Append('|')
                .Append(last1m.High).Append('|')
                .Append(last1m.Low).Append('|');
        }

        // Positions are drawn from the database, but the open list in memory is what changes
        // first: a fill updates UpdateTime, and a close moves the position out of this list.
        if (_showPositions)
        {
            foreach (var position in PositionService.OpenPositions)
            {
                if (position.Object.Symbol != _currentSymbol)
                    continue;

                text.Append(position.Object.Id).Append(':')
                    .Append((int)position.Object.Status).Append(':')
                    .Append(position.Object.Quantity).Append(':')
                    .Append(position.Object.UpdateTime?.Ticks ?? 0).Append(',');
            }
        }

        return text.ToString();
    }

    // Live working copy of every stylable series, edited by the small popups behind the overlays.
    // Held here (not per popup) so a change survives closing and reopening one.
    private readonly Dictionary<string, ChartLineStyle> _chartStyles = [];

    // EXPERIMENT: the TradingView style indicator dropdown in the bar above the chart
    private bool _indicatorMenuOpen;

    private bool _styleDialogVisible;
    private string _styleDialogTitle = "";
    private List<ChartStyleSettings.ChartSeriesDefinition> _styleDialogDefinitions = [];

    // The zigzag lines sit in the Trend and FIB groups instead of the overlay list, so they need
    // their own constants (a string literal inside a Razor attribute cannot be nested).
    private const string ZigZagStyleKey = "zigzag";
    private const string FibZigZagStyleKey = "fibZigzag";

    private static readonly List<ChartStyleSettings.ChartSeriesDefinition> ZigZagStyleDefinitions =
        ChartStyleSettings.DefinitionsForOverlay(ZigZagStyleKey).ToList();

    private static readonly List<ChartStyleSettings.ChartSeriesDefinition> FibZigZagStyleDefinitions =
        ChartStyleSettings.DefinitionsForOverlay(FibZigZagStyleKey).ToList();

    private void LoadChartStyles()
    {
        var stored = ChartStyleSettings.Current;
        _chartStyles.Clear();
        foreach (var definition in ChartStyleSettings.Definitions)
        {
            _chartStyles[definition.Key] = stored.Styles.TryGetValue(definition.Key, out var s)
                ? s.Clone()
                : definition.Default.Clone();
        }
    }

    private void OpenStyleDialog(string key, string title)
    {
        _styleDialogDefinitions = ChartStyleSettings.DefinitionsForOverlay(key).ToList();
        if (_styleDialogDefinitions.Count == 0)
            return;

        _styleDialogTitle = title;
        _styleDialogVisible = true;

        // The gear now lives inside the dropdown. Leaving that open behind the dialog puts two
        // layers of chrome over the chart you are trying to judge the colours against.
        _indicatorMenuOpen = false;
    }

    private void OnStyleDialogVisibleChanged(bool visible)
    {
        _styleDialogVisible = visible;
    }

    /// <summary>
    /// A colour or line was changed in one of the popups: store it and redraw straight away, so
    /// the effect is visible while picking instead of after a separate save step.
    /// </summary>
    private async Task OnChartStyleChanged()
    {
        SaveChartStyles();
        await LoadChartAsync();
    }

    private void SaveChartStyles()
    {
        var target = new ChartStyleSettings();

        // Only what actually differs from the default is written, so a later change to the
        // built-in palette still reaches series the user never touched.
        foreach (var definition in ChartStyleSettings.Definitions)
        {
            if (!_chartStyles.TryGetValue(definition.Key, out var style))
                continue;

            if (style.Color != definition.Default.Color
                || style.LineWidth != definition.Default.LineWidth
                || style.LineStyle != definition.Default.LineStyle
                || style.Dots != definition.Default.Dots)
            {
                target.Styles[definition.Key] = style.Clone();
            }
        }

        target.Save();
    }

    /// <summary>
    /// Push the user's personal colours and line widths to the chart. Only the series that were
    /// actually changed are sent; the rest keep the built-in look.
    /// </summary>
    private async Task ApplyChartStylesAsync()
    {
        // Every series is sent, not only the changed ones: the JavaScript side has no table of
        // its own for the sub-panel indicators, so an unsent key would fall back to plain grey.
        // ToCssColor turns the stored #AARRGGBB into an rgba() the canvas understands.
        var stored = ChartStyleSettings.Current;
        var styles = ChartStyleSettings.Definitions.ToDictionary(
            d => d.Key,
            d =>
            {
                var style = stored.Styles.TryGetValue(d.Key, out var s) ? s : d.Default;
                return (object)new
                {
                    color = style.ToCssColor(),
                    lineWidth = style.LineWidth,
                    lineStyle = style.LineStyle,
                    dots = style.Dots,
                };
            });

        try
        {
            await JS.InvokeVoidAsync("ChartWidget.setStyles", styles);
        }
        catch (JSException) { }
    }


    private void OnSelectedSymbolChanged()
    {
        InvokeAsync(async () =>
        {
            var symbol = SymbolService.SelectedSymbol;
            if (symbol == null)
                return;

            // The interval belongs to the selection as well, so opening the chart from a 15m row
            // while it already shows that symbol on 1h still has to switch it over. So does the
            // window: two closed positions on the same symbol and interval differ in nothing else,
            // and without this the second one would leave the chart on the first one's window.
            string? interval = SymbolService.SelectedInterval?.IntervalPeriod.ToString();
            bool intervalChanged = interval != null && interval != _selectedInterval;
            bool windowChanged = SymbolService.SelectedWindowStart != _windowStart
                || SymbolService.SelectedWindowEnd != _windowEnd;
            if (symbol == _currentSymbol && !intervalChanged && !windowChanged)
                return;

            _currentSymbol = symbol;
            _currentSymbolName = symbol.Name;
            _selectedBase = symbol.Base;
            _selectedQuote = symbol.Quote;
            if (intervalChanged)
                _selectedInterval = interval!;
            _windowStart = SymbolService.SelectedWindowStart;
            _windowEnd = SymbolService.SelectedWindowEnd;
            RefreshSymbolOptions();
            SaveSession();
            StateHasChanged();
            await ResetChartViewAsync();
            await LoadChartAsync();
        });
    }

    private async Task OnIntervalChanged()
    {
        SaveSession();
        await ResetChartViewAsync();
        await LoadChartAsync();
    }

    /// <summary>
    /// Let the chart fit its content on the next load. Only for a different symbol or interval —
    /// an overlay toggle must keep the zoom and scroll position the user set.
    /// </summary>
    private async Task ResetChartViewAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ChartWidget.resetView");
        }
        catch (JSException) { }
    }

    private async Task LoadChart()
    {
        SaveSession();

        // The reload button doubles as the way out of a price axis that was dragged off the
        // candles: autoScale back on, zoom and scroll position untouched.
        try { await JS.InvokeVoidAsync("ChartWidget.resetPriceScale"); }
        catch (JSException) { }

        await LoadChartAsync();
    }

    private bool _loadingChart;
    private bool _loadPending;

    /// <summary>
    /// Rebuild the chart. Every checkbox calls this, and ChartWidget.setData throws away all series
    /// and rebuilds them, so two overlapping runs can leave the chart holding whatever the slower
    /// one produced — which is how ticking an overlay off could take the candles with it. Only one
    /// run at a time; a request arriving during a run is coalesced into a single re-run afterwards.
    /// </summary>
    private async Task LoadChartAsync()
    {
        if (!_initialized)
            return;

        // No symbol at all: the load below would return without drawing anything and without saying
        // why, which is the same black pane the empty-candle case used to leave behind.
        if (_currentSymbol == null)
        {
            SetEmptyReason("There is no symbol to draw yet. Pick a coin above, or open the chart "
                + "from a row in one of the grids.", null);
            return;
        }

        if (_loadingChart)
        {
            _loadPending = true;
            return;
        }

        _loadingChart = true;
        try
        {
            await LoadChartCoreAsync();
        }
        finally
        {
            _loadingChart = false;

            // What is on screen now is what the signature must describe, otherwise the auto
            // refresh reloads once more for a change this run already picked up.
            try { _dataSignature = BuildDataSignature(); } catch { }
        }

        if (_loadPending)
        {
            _loadPending = false;
            await LoadChartAsync();
        }
    }

    private async Task LoadChartCoreAsync()
    {
        if (!_initialized || _currentSymbol == null)
            return;

        if (!Enum.TryParse<CryptoIntervalPeriod>(_selectedInterval, out var period))
        {
            SetEmptyReason($"\"{_selectedInterval}\" is not an interval this scanner knows, "
                + "so there is nothing to load. Pick another one above.", null);
            return;
        }

        // Re-sent on every refresh, so a change on the Chart styles settings tab shows up without
        // having to reopen the chart
        await ApplyChartStylesAsync();

        // The OHLCV read-out rounds to the symbol's own precision ("N8" -> 8 decimals)
        try
        {
            // Precision of this symbol, straight from PriceDecimals (derived from PriceTickSize).
            // Drives the OHLCV read-out AND the price format of the series: without the latter the
            // chart kept the library default of two decimals, so on a coin around 0.1883 every
            // axis label read "0.19" and the scale dropped them all as duplicates.
            await JS.InvokeVoidAsync("ChartWidget.setPriceDecimals", (int)_currentSymbol.PriceDecimals);

            // Same zoom depth as the Avalonia chart's ZoomLast
            await JS.InvokeVoidAsync("ChartWidget.setZoomCandles",
                GlobalData.Settings.Signal.ZonesDlz.CandleCountZoom);

            // Opened from a position: the view has to land on the position, which sits in the
            // middle of the drawn series with margin candles on both sides — zooming to the last
            // candles would put it off screen to the left. Cleared again when the window is left.
            if (_windowStart != null && GlobalData.IntervalListPeriod.TryGetValue(period, out CryptoInterval? zoomInterval))
            {
                var zoom = WindowRange(zoomInterval);
                await JS.InvokeVoidAsync("ChartWidget.zoomToWindow",
                    new { time1 = zoom.ZoomFrom.ToUnixSeconds(), time2 = zoom.ZoomTo.ToUnixSeconds() });
            }
            else
                await JS.InvokeVoidAsync("ChartWidget.zoomToWindow", null);
        }
        catch (JSException) { }

        try
        {
            var symbolInterval = _currentSymbol.GetSymbolInterval(period);

            // Which candles this chart runs on: the scanner's live list, or the window read from
            // candles.db when the chart was opened from a position. Everything below — indicators,
            // overlays, the zone/signal/position bounds — works off candleSource and rawCandles, so
            // the two cases differ in exactly one place: here.
            CryptoCandleList candleSource = symbolInterval.CandleList;

            // Bounds for the still-running candle(s) below. The live chart has no edges, a position
            // window does - and one built past DrawTo would stick out beyond the range it draws.
            CandleTime runningFrom = CandleTime.MinValue;
            CandleTime runningTo = CandleTime.MaxValue;
            if (_windowStart != null)
            {
                var range = WindowRange(symbolInterval.Interval);
                candleSource = LoadWindowCandles(_currentSymbol, symbolInterval.Interval, range.Load, range.DrawTo)
                    ?? symbolInterval.CandleList;
                runningFrom = range.DrawFrom;
                runningTo = range.DrawTo;
            }

            var snapshot = candleSource.GetSnapshot();

            var rawCandles = snapshot.Select(kv => kv.Value).ToList();
            var quotes = rawCandles.AsQuotes();

            UpdateEmptyReason(_currentSymbol, symbolInterval.Interval, rawCandles.Count);

            var candles = new List<object>(rawCandles.Count + 1);
            foreach (var candle in rawCandles)
            {
                candles.Add(new
                {
                    time = candle.OpenTime.ToUnixSeconds(),
                    open = (double)candle.Open,
                    high = (double)candle.High,
                    low = (double)candle.Low,
                    close = (double)candle.Close,
                    volume = (double)candle.Volume,
                });
            }

            // The interval that is STILL RUNNING has no candle of its own yet - one is only written
            // when the interval closes - so without this the chart stops at the last completed candle
            // and trails the market by up to a full interval. On 30m that hid a dca filling on a spike
            // halfway through the candle, marker and all, while the position grid already showed it.
            // Appended to the drawn series only, not to rawCandles: the indicators keep running on
            // finished candles, exactly as the Avalonia chart does.
            if (rawCandles.Count > 0)
            {
                foreach (CryptoCandle candle in CandleTools.BuildRunningCandles(_currentSymbol,
                    symbolInterval.Interval, rawCandles[^1].OpenTime, runningFrom, runningTo))
                {
                    candles.Add(new
                    {
                        time = candle.OpenTime.ToUnixSeconds(),
                        open = (double)candle.Open,
                        high = (double)candle.High,
                        low = (double)candle.Low,
                        close = (double)candle.Close,
                        volume = (double)candle.Volume,
                    });
                }
            }

            // Overlays on main chart
            var overlays = new Dictionary<string, object>();
            var markers = new List<ChartDataService.ChartMarker>();
            var priceLines = new List<ChartDataService.ChartPriceLine>();
            var segments = new List<ChartDataService.ChartSegment>();
            var dots = new List<ChartDataService.ChartDot>();
            var verticals = new List<ChartDataService.ChartVertical>();
            var overlayLabels = new List<object>();
            _dtbZones.Clear();

            if (_showBB)
            {
                int bbLen = GlobalData.Settings.General.SettingsBb.Length;
                double bbDev = (double)GlobalData.Settings.General.SettingsBb.Deviation;
                var bb = quotes.ToBollingerBands(bbLen, bbDev).ToList();
                overlays["bbUpper"] = BuildLineSeries(rawCandles, bb, r => ((BollingerBandsResult)r).UpperBand);
                overlays["bbMiddle"] = BuildLineSeries(rawCandles, bb, r => ((BollingerBandsResult)r).Sma);
                overlays["bbLower"] = BuildLineSeries(rawCandles, bb, r => ((BollingerBandsResult)r).LowerBand);
            }

            // "SBM SMA lines" draws the 200/50/20 trio in one go, same as the Avalonia chart
            if (_showSma200 || _showSmaLinesSbm)
                overlays["sma200"] = BuildSmaSeries(rawCandles, quotes, 200);
            if (_showSma50 || _showSmaLinesSbm)
                overlays["sma50"] = BuildSmaSeries(rawCandles, quotes, 50);
            if (_showSma20 || _showSmaLinesSbm)
                overlays["sma20"] = BuildSmaSeries(rawCandles, quotes, 20);

            if (_showPSar)
            {
                var psar = quotes.ToParabolicSar().ToList();
                overlays["psar"] = BuildLineSeries(rawCandles, psar, r => ((ParabolicSarResult)r).Sar);
            }

            if (_showKeltner)
            {
                var kc = quotes.ToKeltner().ToList();
                overlays["keltnerUpper"] = BuildLineSeries(rawCandles, kc, r => ((KeltnerResult)r).UpperBand);
                overlays["keltnerMiddle"] = BuildLineSeries(rawCandles, kc, r => ((KeltnerResult)r).Centerline);
                overlays["keltnerLower"] = BuildLineSeries(rawCandles, kc, r => ((KeltnerResult)r).LowerBand);
            }

            if (_showNwe)
                AddNweOverlays(overlays, candleSource, smoothRepainting: false, prefix: "nwe");
            if (_showNweRepainting)
                AddNweOverlays(overlays, candleSource, smoothRepainting: true, prefix: "nweRepaint");

            if (_showZigZag || _showPivots || _showFib || _showDtb || _showFibZigZag)
            {
                await BuildZigZagIndicatorsAsync(symbolInterval, candleSource);
                AddZigZagOverlays(overlays, symbolInterval, priceLines, markers);
            }

            // Plugin bands (BBMA, ATR reversal bands, VBS, DBR) expose their lines
            // through the renderer-agnostic GetSeries so this chart can draw them too
            foreach (var overlay in PluginManager.ChartOverlays)
            {
                if (!_pluginOverlayStates.TryGetValue(overlay.GroupKey, out bool enabled) || !enabled)
                    continue;

                foreach (var series in overlay.GetSeries(_currentSymbol, symbolInterval.Interval, rawCandles))
                {
                    if (series.Points.Count == 0)
                        continue;

                    overlays[series.Key] = series.Points
                        .Select(p => (object)new { time = p.Time, value = p.Value })
                        .ToList();
                }

                // Stop-loss / take-profit texts at the band breaks. Not markers: those are placed
                // per bar with no thinning, so at every break the captions piled up on each other.
                // The overlay renderer drops any that would collide, which makes them readable
                // again and lets zooming in reveal more.
                foreach (var label in overlay.GetLabels(_currentSymbol, symbolInterval.Interval, rawCandles))
                {
                    overlayLabels.Add(new
                    {
                        time = label.Time,
                        price = label.Price,
                        above = label.Above,
                        color = label.Color,
                        text = label.Text,
                    });
                }
            }

            // Sub-panel data
            var panels = new Dictionary<string, object>();

            if (_showVolume)
            {
                panels["volume"] = candles;
            }

            if (_showRsi)
            {
                var rsiOversold = (double)GlobalData.Settings.General.SettingsRsi.Oversold;
                var rsiOverbought = (double)GlobalData.Settings.General.SettingsRsi.Overbought;
                var rsi = quotes.ToRsi(14).ToList();
                panels["rsi"] = new
                {
                    data = BuildLineSeries(rawCandles, rsi, r => ((RsiResult)r).Rsi),
                    oversold = rsiOversold,
                    overbought = rsiOverbought,
                };
            }

            if (_showStoch)
            {
                var stochOversold = (double)GlobalData.Settings.General.SettingsStoch.Oversold;
                var stochOverbought = (double)GlobalData.Settings.General.SettingsStoch.Overbought;
                var stoch = quotes.ToStoch(14, 3, 3).ToList();
                panels["stoch"] = new
                {
                    k = BuildLineSeries(rawCandles, stoch, r => ((StochResult)r).K),
                    d = BuildLineSeries(rawCandles, stoch, r => ((StochResult)r).D),
                    oversold = stochOversold,
                    overbought = stochOverbought,
                };
            }

            if (_showMacd)
            {
                var macd = quotes.ToMacd().ToList();
                panels["macd"] = new
                {
                    macdLine = BuildLineSeries(rawCandles, macd, r => ((MacdResult)r).Macd),
                    signal = BuildLineSeries(rawCandles, macd, r => ((MacdResult)r).Signal),
                    histogram = BuildHistogramSeries(rawCandles, macd),
                };
            }

            // Lux is the one indicator that reads symbolInterval.CandleList itself instead of taking
            // the candles it is given (LuxIndicator.CalculateRange), so in a position window it
            // would compute over the live candles and paste the result onto history. Left out
            // there, and the window banner says so, rather than drawing something that is wrong.
            if (_showLux && rawCandles.Count > 0 && _windowStart == null)
            {
                // Computed on the interval the chart is SHOWING, the same way the Avalonia chart does
                // it (CryptoScanner.Chart Lux.Draw passes interval.IntervalPeriod). This used to be
                // pinned to 5m whatever the chart showed, and the resulting values were then pasted
                // onto the chart's candles one for one - so on a 15m chart, three hours of 5m readings
                // were stretched across nine hours of candles. The numbers were right, the time axis
                // under them was not.
                int luxCount = rawCandles.Count;
                CandleTime endTime = rawCandles[^1].OpenTime;

                LuxIndicator.CalculateRange(_currentSymbol, period,
                    endTime, luxCount, out int[] overSoldHistory, out int[] overBoughtHistory);

                // CalculateRange writes output[i] for the candle endTime - (count-1-i) steps back, so
                // it lines up with rawCandles[i] only while those are consecutive. Checked per point
                // rather than assumed: one missing candle would otherwise shift the whole indicator
                // sideways without anything looking wrong.
                uint luxDuration = symbolInterval.Interval.Duration;
                CandleTime luxStart = endTime - (uint)(luxCount - 1) * luxDuration;

                var luxData = new List<object>();
                for (int i = 0; i < luxCount; i++)
                {
                    if (rawCandles[i].OpenTime != luxStart + (uint)i * luxDuration)
                        continue;
                    luxData.Add(new
                    {
                        time = rawCandles[i].OpenTime.ToUnixSeconds(),
                        oversold = overSoldHistory[i],
                        overbought = overBoughtHistory[i],
                    });
                }
                panels["lux"] = luxData;
            }

            // Zones, signals and positions
            var zones = new List<ChartDataService.ChartRect>();

            if (rawCandles.Count > 0)
            {
                CandleTime from = rawCandles[0].OpenTime;

                // End of the last candle, not its start. Positions and signals carry a real
                // timestamp somewhere INSIDE the running candle, so bounding on the open time
                // dropped everything created after it - on an hourly chart that is up to an hour
                // of the most recent activity, which is exactly what you want to see.
                CandleTime to = rawCandles[^1].OpenTime + symbolInterval.Interval.Duration;

                zones = ChartDataService.BuildZones(_currentSymbol,
                    _showDlzZones, _showFvgZones, _showSmcZones, from, to);

                if (_showSignals)
                    dots.AddRange(ChartDataService.BuildSignalDots(_currentSymbol, symbolInterval.Interval, from, to));

                if (_showPositions)
                    ChartDataService.BuildPositionOverlays(_currentSymbol, symbolInterval.Interval, from, to,
                        segments, dots, verticals);
            }

            if (_dtbZones.Count > 0)
                zones = zones.Concat(_dtbZones).ToList();

            var extras = new
            {
                zones,
                markers,
                priceLines,
                segments,
                dots,
                verticals,
                labels = overlayLabels,
            };

            // The Avalonia chart can hide the candles and only show the overlays
            var mainCandles = _showCandles ? candles : new List<object>();

            await JS.InvokeVoidAsync("ChartWidget.setData", mainCandles, overlays, panels, extras);
        }
        catch (Exception ex)
        {
            GlobalData.AddTextToLogTab($"Chart load error: {ex.Message}");
        }
    }

    /// <summary>
    /// Decide what the overlay on an empty chart says, and clear it again as soon as there are
    /// candles. The chart draws from memory only (CandleList), and the scanner releases the candles
    /// of a symbol it has no use for, so "no candles" is a normal state with several distinct
    /// causes — each of which the user can act on once it is named.
    /// </summary>
    private void UpdateEmptyReason(CryptoSymbol symbol, CryptoInterval interval, int candleCount)
    {
        string? reason = null;
        string? window = null;

        if (candleCount == 0 && _windowStart != null)
        {
            // In a position window the candles come from candles.db, not from memory, so none of
            // the reasons below apply. Empty here means the file does not reach back that far —
            // the cleanup keeps the standard window per interval plus the lifetime of every pivot
            // zone, and this position falls outside both.
            var range = WindowRange(interval);
            SetEmptyReason(
                $"candles.db holds no {interval.Name} candles for {symbol.Name} around this position. "
                + "The cleanup keeps recent history plus whatever a pivot zone still needs, and this "
                + "stretch is older than both.",
                $"Looked for {interval.Name} candles between "
                + $"{range.DrawFrom.ToDateTime().ToLocalTime():dd-MM-yyyy HH:mm} and "
                + $"{range.DrawTo.ToDateTime().ToLocalTime():dd-MM-yyyy HH:mm}.");
            return;
        }

        if (candleCount == 0)
        {
            // Does the symbol have nothing at all, or only nothing on THIS interval? The two have
            // different causes: released candles versus an interval not built up yet.
            int total = 0;
            foreach (var si in symbol.Data.SymbolIntervalList)
                total += si.CandleList.Count;

            if (total > 0)
                reason = $"{symbol.Name} has no {interval.Name} candles in memory yet, "
                    + "while other intervals do. The scanner builds this one up from the interval below it.";
            else if (symbol.QuoteData == null || !symbol.QuoteData.FetchCandles)
                reason = $"Candles for the quote coin {symbol.Quote} are switched off, "
                    + $"so the scanner never fetches any for {symbol.Name}.";
            else if (symbol.Status != 1)
                reason = $"{symbol.Name} is no longer trading on {symbol.Exchange?.Name}, "
                    + "so the scanner released its candles.";
            else if (!symbol.EnoughVolume() && !symbol.IsTrading())
                reason = $"{symbol.Name} is below the minimum volume for {symbol.Quote} "
                    + $"({symbol.Volume:N0} against {symbol.QuoteData.MinimalVolume:N0}), "
                    + "so the scanner released its candles to save memory.";
            else
                reason = $"The scanner is holding no candles for {symbol.Name} — it may still be "
                    + "starting up, or this symbol was only just added.";

            // The window itself is worth naming whatever the cause: it is also the answer to
            // "why does my position from last week not show up", which is the same story one
            // step further along.
            CandleTime start = CandleTools.GetCandleFetchStart(symbol, interval, GlobalData.Clock.UtcNow);
            window = $"The chart only draws what the scanner keeps in memory: "
                + $"{interval.Name} candles from {start.ToDateTime().ToLocalTime():dd-MM-yyyy HH:mm} onwards. "
                + "Anything older stays in candles.db and is not drawn here.";
        }

        SetEmptyReason(reason, window);
    }

    /// <summary>
    /// The stretch of history the active position window covers, on this interval.
    /// <para>
    /// draw = what ends up on screen, the position's lifetime plus WindowMarginCandles of context
    /// on each side. load = that plus WindowCalcWarmupCandles in front of it, read purely so
    /// SMA(200) and everything shorter is warmed up at the left edge instead of starting from
    /// nothing there. zoom = the part the view lands on, a much tighter margin around the position
    /// itself; the rest is context to scroll into.
    /// </para>
    /// </summary>
    private (CandleTime Load, CandleTime DrawFrom, CandleTime DrawTo, CandleTime ZoomFrom, CandleTime ZoomTo)
        WindowRange(CryptoInterval interval)
    {
        uint duration = interval.Duration;

        // An open position (_windowEnd null) runs up to now, so its window follows the clock and
        // keeps growing while you watch it.
        CandleTime start = CandleTime.AlignFromDateTime(_windowStart!.Value, duration);
        CandleTime end = CandleTime.AlignFromDateTime(_windowEnd ?? GlobalData.Clock.UtcNow, duration);

        CandleTime drawFrom = start - WindowMarginCandles * duration;
        CandleTime drawTo = end + WindowMarginCandles * duration;
        return (
            drawFrom - WindowCalcWarmupCandles * duration,
            drawFrom,
            drawTo,
            start - WindowZoomMarginCandles * duration,
            end + WindowZoomMarginCandles * duration);
    }

    /// <summary>
    /// Read the candles the active window covers straight from candles.db, into a list belonging to
    /// this screen.
    /// <para>
    /// Deliberately NOT added to symbolInterval.CandleList, which is what the Avalonia chart does —
    /// there it only ever runs in the emulator. Here the live scanner is running underneath: it
    /// trims that list back to GetCandleFetchStart on every candle boundary (CleanCandleDataAsync)
    /// and TrendCalculator builds the trend over whatever it finds in it, clamping the window only
    /// when IsEmulatorMode is set. Pushing weeks of old candles in would widen what the scanner's
    /// own ZigZag sees — and the cleanup would throw them out again on the next boundary, so the
    /// chart would have to re-read them every refresh anyway. A private list has neither problem.
    /// </para>
    /// </summary>
    private CryptoCandleList? LoadWindowCandles(CryptoSymbol symbol, CryptoInterval interval,
        CandleTime from, CandleTime to)
    {
        string key = $"{symbol.Name}|{interval.Name}|{from.Minutes}|{to.Minutes}";
        if (key == _windowCandlesBuiltFor && _windowCandles != null)
            return _windowCandles;

        try
        {
            using var db = new CandleDatabase(symbol.Exchange);
            db.Open();
            var candles = CandleDatabase.LoadCandlesInRange(db.Connection, symbol, interval,
                from.Minutes, to.Minutes);

            var list = new CryptoCandleList();
            foreach (CryptoCandle candle in candles)
                list.TryAdd(candle.OpenTime, candle);

            // An open position runs up to now, and the newest candles are still forming: those live
            // in memory and have not been written to candles.db yet. Top the window up from the
            // scanner's own list so the right edge is current instead of stopping at the last save.
            foreach (var pair in symbol.GetSymbolInterval(interval.IntervalPeriod).CandleList.GetSnapshot())
            {
                if (pair.Key >= from && pair.Key <= to)
                    list.TryAdd(pair.Key, pair.Value);
            }

            _windowCandles = list;
            _windowCandlesBuiltFor = key;
            return list;
        }
        catch (Exception error)
        {
            GlobalData.AddTextToLogTab($"chart window candle load failed for {symbol.Name} {interval.Name}: {error.Message}");
            _windowCandles = null;
            _windowCandlesBuiltFor = "";
            return null;
        }
    }

    /// <summary>
    /// Put the overlay up, change its text, or take it down again (both arguments null). Kept apart
    /// from <see cref="UpdateEmptyReason"/> so the paths that never reach the candles — no symbol,
    /// an interval that does not parse — can say something too instead of leaving a black pane.
    /// </summary>
    private void SetEmptyReason(string? reason, string? window)
    {
        if (reason == _emptyReason && window == _emptyWindow)
            return;

        _emptyReason = reason;
        _emptyWindow = window;

        // The refresh timer calls this outside an event handler, so Blazor does not re-render by
        // itself. Only on a real change — see the comparison above.
        StateHasChanged();
    }

    private void AddNweOverlays(Dictionary<string, object> overlays, CryptoCandleList candleSource,
        bool smoothRepainting, string prefix)
    {
        var settings = NwePlugin.Settings;
        var indicator = new NweIndicator(
            bandwidth: settings.BandWidth,
            multiplier: settings.Multiplication,
            smoothRepainting: smoothRepainting);

        var results = indicator.Calculate(candleSource);

        var upper = new List<object>();
        var middle = new List<object>();
        var lower = new List<object>();

        foreach (var result in results)
        {
            long time = result.OpenTime.ToUnixSeconds();
            if (result.Upper.HasValue)
                upper.Add(new { time, value = (double)result.Upper.Value });
            if (result.Center.HasValue)
                middle.Add(new { time, value = (double)result.Center.Value });
            if (result.Lower.HasValue)
                lower.Add(new { time, value = (double)result.Lower.Value });
        }

        if (upper.Count > 0)
            overlays[prefix + "Upper"] = upper;
        if (middle.Count > 0)
            overlays[prefix + "Middle"] = middle;
        if (lower.Count > 0)
            overlays[prefix + "Lower"] = lower;
    }

    // ZigZag indicators owned by this screen, one per (trend type, use high/low) combination.
    // The scanner's symbolInterval.ZigZagIndicators is a lazily filled cache that only ever holds
    // the one or two keys the scanner itself used, so reading it left the overlays empty for the
    // secondary trend and for any interval the scanner had not processed. The Avalonia chart has
    // its own set for exactly this reason (ChartWindowViewModel.ClearOptions).
    private TrendZigZagIndicatorList _zigZagIndicators = [];
    private string _zigZagBuiltFor = "";

    /// <summary>
    /// Rebuild and feed the zigzag indicators for the current symbol/interval window, the same
    /// way the Avalonia chart does through ZoneDlz.CalculatePivots. FinishBatch (inside that call)
    /// is what makes LastSwingHigh/LastSwingLow — and therefore the FIB levels — valid.
    /// </summary>
    private async Task BuildZigZagIndicatorsAsync(CryptoSymbolInterval symbolInterval, CryptoCandleList candleSource)
    {
        var interval = symbolInterval.Interval;

        CandleTime minDate;
        CandleTime maxDate;
        if (_windowStart != null)
        {
            // Over the window, warmup prefix included — the pivots have to be settled by the time
            // the drawn stretch starts, exactly as they are on the live path.
            var range = WindowRange(interval);
            minDate = range.Load;
            maxDate = range.DrawTo;
        }
        else
        {
            maxDate = CandleTime.AlignFromDateTime(GlobalData.Clock.UtcNow, interval.Duration);
            minDate = maxDate - CandleTools.CandleCountFetch * interval.Duration;
        }

        string key = $"{_currentSymbol!.Name}|{interval.Name}|{minDate.Minutes}|{maxDate.Minutes}";
        if (key == _zigZagBuiltFor && _zigZagIndicators.Count > 0)
            return;

        _zigZagIndicators = [];
        _zigZagIndicators[(TrendType.Primary, false)] = new(TrendType.Primary, false);
        _zigZagIndicators[(TrendType.Primary, true)] = new(TrendType.Primary, true);
        _zigZagIndicators[(TrendType.Secondary, false)] = new(TrendType.Secondary, false);
        _zigZagIndicators[(TrendType.Secondary, true)] = new(TrendType.Secondary, true);

        if (_windowStart != null)
            FeedZigZagIndicators(interval, candleSource, minDate, maxDate);
        else
            await ZoneDlz.CalculatePivots(_currentSymbol, interval, minDate, maxDate, _zigZagIndicators);

        _zigZagBuiltFor = key;
    }

    /// <summary>
    /// Feed this screen's zigzag indicators over the window, the way ZoneDlz.CalculatePivots feeds
    /// them over the live one. Not that method itself: besides feeding, it writes the last swing
    /// point and the swing range onto the scanner's CryptoSymbolInterval, and re-seeds the zone
    /// trigger range from them. Calling it from a chart parked in last week's candles would hand
    /// the live zone calculation swing levels from a moment that has nothing to do with now.
    /// </summary>
    private void FeedZigZagIndicators(CryptoInterval interval, CryptoCandleList candles,
        CandleTime from, CandleTime to)
    {
        var indicators = _zigZagIndicators.Values;

        for (CandleTime loop = from; loop <= to; loop += interval.Duration)
        {
            if (candles.TryGetValue(loop, out CryptoCandle candle))
            {
                foreach (var indicator in indicators)
                    indicator.Calculate(candle, true);
            }
        }

        // What makes LastSwingHigh/LastSwingLow — and with them the FIB levels — valid.
        foreach (var indicator in indicators)
            indicator.FinishBatch();
    }

    private void AddZigZagOverlays(Dictionary<string, object> overlays, CryptoSymbolInterval symbolInterval,
        List<ChartDataService.ChartPriceLine> priceLines, List<ChartDataService.ChartMarker> markers)
    {
        // The Trend and FIB groups can each point at the primary or the secondary trend.
        var trendSettings = _trendType == TrendType.Primary
            ? GlobalData.Settings.Trend.Primary
            : GlobalData.Settings.Trend.Secondary;
        if (!_zigZagIndicators.TryGetValue((trendSettings.TrendType, trendSettings.UseHighLow), out var indicator))
            return;

        // The FIB group always works on the high/low variant, same as the Avalonia chart
        var fibTrendType = _fibTrendType == TrendType.Primary ? TrendType.Primary : TrendType.Secondary;
        if (!_zigZagIndicators.TryGetValue((fibTrendType, true), out var fibIndicator))
            fibIndicator = indicator;

        if (_showZigZag)
        {
            // Dummy points included: they carry the last, not yet confirmed leg of the zigzag,
            // which the Avalonia chart draws as well
            var points = indicator.ZigZagList
                .Select(z => (object)new { time = z.Candle.OpenTime.ToUnixSeconds(), value = (double)z.Value })
                .ToList();
            if (points.Count > 0)
                overlays["zigzag"] = points;
        }

        if (_showPivots)
        {
            foreach (var pivot in indicator.PivotList)
            {
                bool isHigh = pivot.PointType == 'H';
                markers.Add(new ChartDataService.ChartMarker
                {
                    time = pivot.Candle.OpenTime.ToUnixSeconds(),
                    position = isHigh ? "aboveBar" : "belowBar",
                    color = isHigh ? "#e53935" : "#ffeb3b",
                    shape = "square",
                    text = "",
                });
            }
        }

        if (_showDtb)
        {
            // Double top / double bottom: the Avalonia chart paints a triangle over the three
            // zigzag points; the lightweight chart only knows rectangles, so draw the bounding
            // box of those three points in the same green (bottom) / orange (top) tint.
            foreach (var (first, second, third) in DoubleTopAndBottom.CalculateDoubleTopBottom(indicator))
            {
                double p1 = first.Value;
                double p2 = second.Value;
                double p3 = (double)third.Value;
                bool isBottom = first.PointType == 'L';

                _dtbZones.Add(new ChartDataService.ChartRect
                {
                    time1 = first.Candle.OpenTime.ToUnixSeconds(),
                    time2 = third.Candle.OpenTime.ToUnixSeconds(),
                    price1 = Math.Max(p1, Math.Max(p2, p3)),
                    price2 = Math.Min(p1, Math.Min(p2, p3)),
                    fill = isBottom ? "rgba(0,128,0,0.29)" : "rgba(255,165,0,0.29)",
                    border = isBottom ? "rgba(0,128,0,0.60)" : "rgba(255,165,0,0.60)",
                    text = isBottom ? "DB" : "DT",
                });
            }
        }

        // Drawn on its own toggle. Previously this was skipped whenever the FIB trend equalled the
        // main trend, which is the default, so the checkbox appeared to do nothing.
        if (_showFibZigZag)
        {
            var fibPoints = fibIndicator.ZigZagList
                .Select(z => (object)new { time = z.Candle.OpenTime.ToUnixSeconds(), value = (double)z.Value })
                .ToList();
            if (fibPoints.Count > 0)
                overlays["fibZigzag"] = fibPoints;
        }

        if (_showFib && fibIndicator.LastSwingHigh != null && fibIndicator.LastSwingLow != null)
        {
            double high = fibIndicator.LastSwingHigh.Value;
            double low = fibIndicator.LastSwingLow.Value;
            double range = high - low;

            // Which swing came last decides the direction of the retracement, exactly as
            // FibRetracement.RetracementX does: for a move up, 0.000 sits at the high.
            bool isLong = fibIndicator.LastSwingHigh.Candle.OpenTime >= fibIndicator.LastSwingLow.Candle.OpenTime;

            (double level, string color)[] fibLevels =
            [
                (0.000, "#9e9e9e"),
                (0.236, "#ffffff"),
                (0.382, "#ffffff"),
                (0.500, "#ffeb3b"),
                (0.618, "#ffeb3b"),
                (0.786, "#ffffff"),
                (1.000, "#9e9e9e"),
            ];

            foreach (var (level, color) in fibLevels)
            {
                priceLines.Add(new ChartDataService.ChartPriceLine
                {
                    price = isLong ? high - range * level : low + range * level,
                    color = color,
                    lineStyle = 1,
                    title = level.ToString("0.000"),
                });
            }
        }
    }

    private static List<object> BuildSmaSeries(List<CryptoCandle> rawCandles, IReadOnlyList<IQuote> quotes, int length)
    {
        var sma = quotes.ToSma(length).ToList();
        return BuildLineSeries(rawCandles, sma, r => ((SmaResult)r).Sma);
    }

    private static List<object> BuildLineSeries<T>(List<CryptoCandle> rawCandles, List<T> results, Func<T, double?> getValue)
    {
        var data = new List<object>();
        for (int i = 0; i < rawCandles.Count && i < results.Count; i++)
        {
            var val = getValue(results[i]);
            if (val.HasValue)
            {
                data.Add(new
                {
                    time = rawCandles[i].OpenTime.ToUnixSeconds(),
                    value = val.Value,
                });
            }
        }
        return data;
    }

    private static List<object> BuildHistogramSeries(List<CryptoCandle> rawCandles, List<MacdResult> results)
    {
        // Colour per bar, so both directions follow their own configured colour
        var stored = ChartStyleSettings.Current;
        string up = stored.Get("macdHistUp").ToCssColor();
        string down = stored.Get("macdHistDown").ToCssColor();

        var data = new List<object>();
        for (int i = 0; i < rawCandles.Count && i < results.Count; i++)
        {
            var val = results[i].Histogram;
            if (val.HasValue)
            {
                data.Add(new
                {
                    time = rawCandles[i].OpenTime.ToUnixSeconds(),
                    value = val.Value,
                    color = val.Value >= 0 ? up : down,
                });
            }
        }
        return data;
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _autoRefreshTimer?.Dispose();
        _autoRefreshTimer = null;

        try { SaveSession(); } catch { }
        SymbolService.SelectedSymbolChanged -= OnSelectedSymbolChanged;
        try
        {
            _ = JS.InvokeVoidAsync("ChartWidget.dispose");
        }
        catch { }
    }
}
