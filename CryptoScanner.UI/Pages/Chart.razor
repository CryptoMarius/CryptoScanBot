@page "/chart"
@using CryptoScanner.Analyzers.Nwe
@using CryptoScanner.Analyzers.Nwe.Signal
@using CryptoScanner.Core.Context
@using CryptoScanner.Core.Contracts
@using CryptoScanner.Core.Core
@using CryptoScanner.Core.Enums
@using CryptoScanner.Core.Model
@using CryptoScanner.Core.Signal.Indicators
@using CryptoScanner.Core.Trend
@using CryptoScanner.Core.Zones
@using CryptoScanner.UI.Models
@using CryptoScanner.UI.Services
@using Skender.Stock.Indicators
@inject SymbolService SymbolService
@inject PositionService PositionService
@inject IJSRuntime JS
@implements IDisposable

@* Avalonia puts all of this in a panel on the LEFT of the chart (ScrollViewer Grid.Column="0"
   Width="220"). Here it lives in the bar above the chart instead: the pickers straight on the bar,
   everything that was a group in that panel (Trend, FIB, Display, Overlays, Indicators) behind the
   one Indicators button, and the two actions as icons. That is 220 pixels of width back for the
   chart itself, which is what you are actually looking at. *@
<div class="chart-layout">
<div class="chart-panels">
    @* The symbol, quote and interval pickers themselves, moved here out of the side panel *@
    <div class="chart-header-bar">
        <select class="input-select chart-header-select chart-header-base"
                @bind="_selectedBase" @bind:after="OnSymbolSelectionChanged">
            @foreach (var b in _baseOptions)
            {
                <option value="@b">@b</option>
            }
        </select>
        <select class="input-select chart-header-select"
                @bind="_selectedQuote" @bind:after="OnSymbolSelectionChanged">
            @foreach (var q in _quoteOptions)
            {
                <option value="@q">@q</option>
            }
        </select>
        <select class="input-select chart-header-select"
                @bind="_selectedInterval" @bind:after="OnIntervalChanged">
            @foreach (var iv in _intervalOptions)
            {
                <option value="@iv.Key">@iv.Value</option>
            }
        </select>

        @* Everything the side panel used to hold, behind one button, the way TradingView does it *@
        <div class="chart-header-menu">
            <button class="btn btn-secondary chart-header-button"
                    title="Trend, FIB, overlays, indicators and what is displayed"
                    @onclick="() => _indicatorMenuOpen = !_indicatorMenuOpen">
                Indicators @(_indicatorMenuOpen ? "▲" : "▼")
            </button>
        </div>

        <button class="chart-icon-button" @onclick="LoadChart"
                title="Reload the chart with the latest candles, signals and positions, and put the price axis back on the candles">&#10227;</button>
        <button class="chart-icon-button" @onclick="Calculate"
                title="Force a full recalculation of the liquidity zones">&#8721;</button>

        @* Opened from a position: say so, and give the way back. Without this the chart silently
           sits in the past — every refresh looks frozen and picking another coin is the only exit
           anyone would find. *@
        @if (_windowStart != null)
        {
            <span class="chart-window-banner" title="@WindowBannerTooltip">
                @WindowBannerText
                <button class="chart-window-close" @onclick="OnLeaveWindow" title="Back to the live chart">&times;</button>
            </span>
        }

        @* Open/high/low/close/volume of the candle under the mouse. Filled by the chart widget
           itself — the crosshair fires on every mouse move, which is far too often to route
           through Blazor. *@
        <span id="chart-ohlcv" class="chart-ohlcv"></span>
    </div>

    @if (_indicatorMenuOpen)
    {
        <div class="chart-indicator-overlay" @onclick="() => _indicatorMenuOpen = false"></div>
        <div class="chart-indicator-menu" @onclick:stopPropagation="true">

            @* Same groups the Avalonia side panel has. Display is the odd one out and sits at the
               bottom here: it switches whole layers on and off rather than adding an indicator. *@
            <div class="chart-indicator-heading">Trend</div>
            <div class="chart-indicator-row">
                <select class="input-select chart-indicator-select" @bind="_trendType" @bind:after="LoadChart">
                    <option value="@TrendType.Primary">Primary trend</option>
                    <option value="@TrendType.Secondary">Secondary trend</option>
                </select>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showZigZag" @bind:after="LoadChart" /> Show zigzag</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog(ZigZagStyleKey, "ZigZag"))">&#9881;</button>
            </div>

            <div class="chart-indicator-heading">FIB</div>
            <div class="chart-indicator-row">
                <select class="input-select chart-indicator-select" @bind="_fibTrendType" @bind:after="LoadChart">
                    <option value="@TrendType.Primary">Primary trend</option>
                    <option value="@TrendType.Secondary">Secondary trend</option>
                </select>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showFib" @bind:after="LoadChart" /> Show fib retracement</label>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showFibZigZag" @bind:after="LoadChart" /> Show zigzag</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog(FibZigZagStyleKey, "FIB ZigZag"))">&#9881;</button>
            </div>

            <div class="chart-indicator-heading">Overlays</div>
            @foreach (var overlay in _allOverlays)
            {
                var key = overlay.Key;
                var styleDefinitions = ChartStyleSettings.DefinitionsForOverlay(key).ToList();
                <div class="chart-indicator-row">
                    <label class="chart-toggle">
                        <input type="checkbox" checked="@IsOverlayEnabled(key)"
                               @onchange="e => OnOverlayToggled(key, e)" /> @overlay.Label
                    </label>
                    @if (styleDefinitions.Count > 0)
                    {
                        <button class="chart-style-button" title="Colours and lines"
                                @onclick="() => OpenStyleDialog(key, overlay.Label)">⚙</button>
                    }
                </div>
            }

            <div class="chart-indicator-heading">Indicators</div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showLux" @bind:after="LoadChart" /> Lux</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("lux", "Lux"))">&#9881;</button>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showMacd" @bind:after="LoadChart" /> MACD</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("macd", "MACD"))">&#9881;</button>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showRsi" @bind:after="LoadChart" /> RSI</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("rsi", "RSI"))">&#9881;</button>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showStoch" @bind:after="LoadChart" /> Stochastic</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("stoch", "Stochastic"))">&#9881;</button>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showVolume" @bind:after="LoadChart" /> Volume</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("volume", "Volume"))">&#9881;</button>
            </div>

            <div class="chart-indicator-heading">Display</div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showCandles" @bind:after="LoadChart" /> Candles</label>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showPivots" @bind:after="LoadChart" /> Pivot points</label>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showSignals" @bind:after="LoadChart" /> Signals</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("signals", "Signals"))">&#9881;</button>
            </div>
            <div class="chart-indicator-row">
                <label class="chart-toggle"><input type="checkbox" @bind="_showPositions" @bind:after="LoadChart" /> Positions</label>
                <button class="chart-style-button" title="Colours and lines" @onclick="@(() => OpenStyleDialog("positions", "Positions"))">&#9881;</button>
            </div>
        </div>
    }
    @* An empty chart used to be an empty chart: a black pane with no explanation, which reads as a
       defect while it is nearly always a symbol whose candles the scanner does not hold. Sibling of
       the panes rather than a child of #chart-main, because the chart widget owns that element and
       Blazor must not diff its canvases. pointer-events:none keeps the header bar usable. *@
    @if (_emptyReason != null)
    {
        <div class="chart-empty-overlay">
            <div class="chart-empty-box">
                <div class="chart-empty-title">Nothing to draw here</div>
                <div class="chart-empty-text">@_emptyReason</div>
                @if (_emptyWindow != null)
                {
                    <div class="chart-empty-note">@_emptyWindow</div>
                }
            </div>
        </div>
    }
    @* The bottom pane carries the time axis (ChartWidget._applyBottomTimeScale), so it needs the
       height for it on top of its own — otherwise the axis eats into the indicator it belongs to. *@
    <div id="chart-main" class="chart-panel chart-panel-main"></div>
    <div id="chart-volume" class="chart-panel chart-panel-sub" style="display:@(_showVolume ? "block" : "none"); height:@(PanelHeight(80, "volume"))px;"></div>
    <div id="chart-oscillator" class="chart-panel chart-panel-sub" style="display:@(ShowOscillatorPanel ? "block" : "none"); height:@(PanelHeight(120, "oscillator"))px;"></div>
    <div id="chart-macd" class="chart-panel chart-panel-sub" style="display:@(_showMacd ? "block" : "none"); height:@(PanelHeight(120, "macd"))px;"></div>
</div>
</div>

<ChartStyleDialog Visible="_styleDialogVisible"
                  VisibleChanged="OnStyleDialogVisibleChanged"
                  Title="@_styleDialogTitle"
                  Definitions="_styleDialogDefinitions"
                  Styles="_chartStyles"
                  Changed="OnChartStyleChanged" />

@code {
    private string? _currentSymbolName;
    private CryptoSymbol? _currentSymbol;
    private string _selectedInterval = "interval1h";
    private bool _initialized;

    private ZoneSession _session = new();

    // Text of the overlay shown when the chart has no candles to draw, null while it has. Filled by
    // UpdateEmptyReason on every load.
    private string? _emptyReason;
    private string? _emptyWindow;

    // Lifetime of the position the chart was opened from; null on both = the normal clock window.
    // _windowEnd null while _windowStart is set means "until now" (a position that is still open).
    private DateTime? _windowStart;
    private DateTime? _windowEnd;

    // Candles of context drawn on each side of the position's lifetime, and the extra candles read
    // before that purely to warm up the indicators (the longest lookback drawn is SMA(200)). Same
    // two numbers as ChartWindowViewModel.WindowMarginCandles / WindowCalcWarmupCandles, so both
    // charts show a position with the same amount of surroundings.
    private const int WindowMarginCandles = 200;
    private const int WindowCalcWarmupCandles = 300;

    // Of those 200 margin candles, how many are actually in view: the rest is context you can
    // scroll into. Mirrors the (WindowMarginCandles - 30) the Avalonia chart zooms with.
    private const int WindowZoomMarginCandles = 30;

    // Candles read from candles.db for the active window, kept out of the scanner's own CandleList
    // on purpose — see LoadWindowCandles.
    private CryptoCandleList? _windowCandles;
    private string _windowCandlesBuiltFor = "";

    // Double top/bottom rectangles, filled while building the zigzag overlays
    private readonly List<ChartDataService.ChartRect> _dtbZones = [];

    private bool _showBB = true;
    private bool _showSma200;
    private bool _showSma50;
    private bool _showSma20;
    private bool _showPSar;
    private bool _showKeltner;
    private bool _showNwe;
    private bool _showNweRepainting;
    private bool _showSmaLinesSbm;
    private bool _showDtb;
    private bool _showDlzZones;
    private bool _showFvgZones;
    private bool _showSmcZones;
    private bool _showSignals = true;
    private bool _showPositions = true;
    private bool _showZigZag;
    private bool _showPivots;
    private bool _showFib;
    private bool _showVolume = true;
    private bool _showRsi;
    private bool _showStoch;
    private bool _showMacd;
    private bool _showLux;
    private bool _showCandles = true;
    private bool _showFibZigZag;

    private TrendType _trendType = TrendType.Primary;
    private TrendType _fibTrendType = TrendType.Primary;


    private string _selectedBase = "BTC";
    private string _selectedQuote = "USDT";
    private List<string> _baseOptions = [];
    private List<string> _quoteOptions = [];

    // Static overlays merged with the plugin overlays into one alphabetical list, exactly like
    // the Avalonia ChartOptionsViewModel.AllOverlays.
    private static readonly (string Key, string Label)[] StaticOverlays =
    [
        ("bb", "Bollinger Bands"),
        ("dlz", "DLZ Zones"),
        ("dtb", "DTB"),
        ("fvg", "FVG Zones"),
        ("kc", "Keltner Channel"),
        ("nwe", "NWE (not repainting)"),
        ("nwe.r", "NWE (repainting)"),
        ("psar", "PSar"),
        ("sbm", "SBM SMA lines"),
        ("sma20", "SMA 20"),
        ("sma50", "SMA 50"),
        ("sma200", "SMA 200"),
        ("smc", "SMC Zones"),
    ];

    private List<(string Key, string Label)> _allOverlays = [];

    private bool ShowOscillatorPanel => _showRsi || _showStoch || _showLux;

    // Height the time axis needs. Measured against the axis the main chart used to draw: the labels
    // are 10px, and lightweight-charts puts its own padding and tick marks around them.
    private const int TimeAxisHeight = 26;

    /// <summary>
    /// Which pane sits at the bottom, and so carries the time axis for all of them. Empty when no
    /// sub-panel is switched on and the main chart keeps it. Must stay in step with the pane order
    /// in ChartWidget._applyBottomTimeScale.
    /// </summary>
    private string BottomPanelKey =>
        _showMacd ? "macd"
        : ShowOscillatorPanel ? "oscillator"
        : _showVolume ? "volume"
        : "";

    private int PanelHeight(int height, string key) =>
        BottomPanelKey == key ? height + TimeAxisHeight : height;

    private readonly Dictionary<string, string> _pluginOverlays = [];
    private readonly Dictionary<string, bool> _pluginOverlayStates = [];

    // Every interval the scanner knows, in the order CreateStandardIntervalList defines, same as
    // the Avalonia ChartSymbolSelectorViewModel. This used to be a hardcoded seven, which left out
    // 2m, 3m, 10m, 2h, 3h, 6h, 8h, 12h and 1w — all of them just as available as the rest: what the
    // exchange does not deliver, the scanner builds itself from the interval below it.
    private static Dictionary<string, string> _intervalOptions => GlobalData.IntervalList
        .ToDictionary(i => i.IntervalPeriod.ToString(), i => i.Name);

    protected override void OnInitialized()
    {
        // Restore the chart session (same file the Avalonia chart window uses), otherwise every
        // visit resets all overlay/panel toggles to their hardcoded defaults.
        _session = ZoneSessionStore.Load();
        ApplySessionToFields();
        LoadChartStyles();

        SymbolService.SelectedSymbolChanged += OnSelectedSymbolChanged;
        if (SymbolService.SelectedSymbol != null)
        {
            _currentSymbol = SymbolService.SelectedSymbol;
            _currentSymbolName = _currentSymbol.Name;
            _selectedBase = _currentSymbol.Base;
            _selectedQuote = _currentSymbol.Quote;

            // Interval of the row the chart was opened from. Null means the caller had none to
            // give, and the interval restored from the session above stays as it is.
            if (SymbolService.SelectedInterval != null)
                _selectedInterval = SymbolService.SelectedInterval.IntervalPeriod.ToString();

            _windowStart = SymbolService.SelectedWindowStart;
            _windowEnd = SymbolService.SelectedWindowEnd;
        }
        else if (GlobalData.ActiveExchange != null
            && GlobalData.ActiveExchange.TryGetSymbolByPair(_selectedBase + _selectedQuote, out CryptoSymbol? stored))
        {
            // No grid selection yet: fall back on the symbol stored in the session
            _currentSymbol = stored;
            _currentSymbolName = stored.Name;
        }

        foreach (var overlay in PluginManager.ChartOverlays)
        {
            _pluginOverlays[overlay.GroupKey] = overlay.Label;
            _pluginOverlayStates[overlay.GroupKey] =
                _session.PluginOverlayStates.TryGetValue(overlay.GroupKey, out bool on) && on;
        }

        // One combined list, static and plugin entries together, sorted by label
        var all = new List<(string Key, string Label)>(StaticOverlays);
        all.AddRange(_pluginOverlays.Select(kv => (kv.Key, kv.Value)));
        all.Sort((a, b) => string.Compare(a.Label, b.Label, StringComparison.OrdinalIgnoreCase));
        _allOverlays = all;

        RefreshSymbolOptions();
    }

    /// <summary>Current value of one entry in the combined overlay list.</summary>
    private bool IsOverlayEnabled(string key) => key switch
    {
        "bb" => _showBB,
        "dlz" => _showDlzZones,
        "dtb" => _showDtb,
        "fvg" => _showFvgZones,
        "kc" => _showKeltner,
        "nwe" => _showNwe,
        "nwe.r" => _showNweRepainting,
        "psar" => _showPSar,
        "sbm" => _showSmaLinesSbm,
        "sma20" => _showSma20,
        "sma50" => _showSma50,
        "sma200" => _showSma200,
        "smc" => _showSmcZones,
        _ => _pluginOverlayStates.TryGetValue(key, out bool on) && on,
    };

    private async Task OnOverlayToggled(string key, ChangeEventArgs e)
    {
        bool value = e.Value is bool b && b;
        switch (key)
        {
            case "bb": _showBB = value; break;
            case "dlz": _showDlzZones = value; break;
            case "dtb": _showDtb = value; break;
            case "fvg": _showFvgZones = value; break;
            case "kc": _showKeltner = value; break;
            case "nwe": _showNwe = value; break;
            case "nwe.r": _showNweRepainting = value; break;
            case "psar": _showPSar = value; break;
            case "sbm": _showSmaLinesSbm = value; break;
            case "sma20": _showSma20 = value; break;
            case "sma50": _showSma50 = value; break;
            case "sma200": _showSma200 = value; break;
            case "smc": _showSmcZones = value; break;
            default: _pluginOverlayStates[key] = value; break;
        }

        SaveSession();
        await LoadChartAsync();
    }

    /// <summary>
    /// Fill the base/quote dropdowns from the active exchange, same filter the Avalonia
    /// ChartSymbolSelectorViewModel uses.
    /// </summary>
    private void RefreshSymbolOptions()
    {
        List<string> bases = [];
        List<string> quotes = [];

        var exchange = GlobalData.ActiveExchange;
        if (exchange != null)
        {
            foreach (var symbol in exchange.SymbolListName.Values)
            {
                if (symbol.QuoteData.FetchCandles && symbol.Status == 1 && !symbol.IsBarometerSymbol()
                    && !bases.Contains(symbol.Base))
                    bases.Add(symbol.Base);
            }
            bases.Sort(StringComparer.OrdinalIgnoreCase);
        }

        foreach (var quoteData in GlobalData.Settings.QuoteCoins.Values.OrderBy(x => x.Name))
        {
            if (quoteData.FetchCandles)
                quotes.Add(quoteData.Name);
        }
        if (quotes.Count == 0)
            quotes.Add("USDT");

        _baseOptions = bases;
        _quoteOptions = quotes;

        if (bases.Count > 0 && !bases.Contains(_selectedBase))
            _selectedBase = bases[0];
        if (!quotes.Contains(_selectedQuote))
            _selectedQuote = quotes[0];
    }

    private async Task OnSymbolSelectionChanged()
    {
        // Picking a coin by hand is a fresh start: a position window belongs to the row it came
        // from, and carrying it over to another coin would leave the chart in a past that has
        // nothing to do with what was just asked for. Switching INTERVAL keeps it — that is the
        // same position seen at a different resolution.
        ClearWindow();

        // Base + quote is a bare pair; the symbol list is keyed on the product-suffixed name
        var exchange = GlobalData.ActiveExchange;
        if (exchange != null && exchange.TryGetSymbolByPair(_selectedBase + _selectedQuote, out CryptoSymbol? symbol))
        {
            _currentSymbol = symbol;
            _currentSymbolName = symbol.Name;
            SymbolService.SetSelectedSymbol(symbol);
        }

        SaveSession();
        await ResetChartViewAsync();
        await LoadChartAsync();
    }

    /// <summary>
    /// Back to the live chart. Also clears the window held by the SymbolService, otherwise the
    /// selection there would still carry it and clicking the same position row again would be
    /// seen as "no change" — leaving the chart on "now" with no way back in.
    /// </summary>
    private void ClearWindow()
    {
        _windowStart = null;
        _windowEnd = null;
        _windowCandles = null;
        _windowCandlesBuiltFor = "";
        if (SymbolService.SelectedWindowStart != null || SymbolService.SelectedWindowEnd != null)
            SymbolService.SetSelectedSymbol(SymbolService.SelectedSymbol, SymbolService.SelectedInterval, null, null);
    }

    /// <summary>Caption of the window banner: the stretch of history the chart is parked on.</summary>
    private string WindowBannerText
    {
        get
        {
            if (_windowStart == null)
                return "";

            DateTime start = _windowStart.Value.ToLocalTime();
            if (_windowEnd == null)
                return $"Position from {start:dd-MM HH:mm} (still open)";

            DateTime end = _windowEnd.Value.ToLocalTime();

            // Same day: the date once is enough, the rest is just the two times
            return end.Date == start.Date
                ? $"Position {start:dd-MM HH:mm} → {end:HH:mm}"
                : $"Position {start:dd-MM HH:mm} → {end:dd-MM HH:mm}";
        }
    }

    private string WindowBannerTooltip =>
        "The chart is showing this position instead of the live market. Candles come straight from "
        + "candles.db, so history older than the scanner keeps in memory is drawn too. "
        + "Lux is left out here — it computes on the live candles only. Click × to go back to now.";

    /// <summary>The "back to now" button next to the window banner.</summary>
    private async Task OnLeaveWindow()
    {
        ClearWindow();
        await ResetChartViewAsync();
        await LoadChartAsync();
    }

    /// <summary>
    /// "Calc": force a full recalculation of the liquidity zones for this symbol and redraw,
    /// same as the Avalonia CalculateCommand (which sets Session.ForceCalculation).
    /// </summary>
    private async Task Calculate()
    {
        if (_currentSymbol != null)
        {
            foreach (string intervalName in GlobalData.Settings.Signal.ZonesDlz.IntervalList)
            {
                if (GlobalData.IntervalListPeriodName.TryGetValue(intervalName, out CryptoInterval? intervalX))
                    GlobalData.ThreadZoneCalculate?.AddToQueue(_currentSymbol, intervalX);
            }
            GlobalData.AddTextToLogTab($"{_currentSymbol.Name} liquidity zone recalculation queued");
        }
        await LoadChartAsync();
    }

    private void ApplySessionToFields()
    {
        _selectedInterval = _session.ActiveInterval.ToString();

        _showBB = _session.ShowBollingerBand;
        _showKeltner = _session.ShowKeltnerChannel;
        _showPSar = _session.ShowPSar;
        _showNwe = _session.ShowNwe;
        _showNweRepainting = _session.ShowNweRepainting;
        _showSmaLinesSbm = _session.ShowSmaLinesSbm;
        _showDlzZones = _session.ShowDlzZones;
        _showFvgZones = _session.ShowFvgZones;
        _showSmcZones = _session.ShowSmcZones;
        _showDtb = _session.ShowDtb;
        _showSignals = _session.ShowSignals;
        _showPositions = _session.ShowPositions;
        _showPivots = _session.ShowPoints;
        _showZigZag = _session.TrendShowZigZag;
        _showFib = _session.ShowFibRetracement;
        _showFibZigZag = _session.ShowFibZigZag;
        _showCandles = _session.ShowCandles;
        _trendType = _session.TrendType;
        _fibTrendType = _session.FibTrend;
        _selectedBase = string.IsNullOrEmpty(_session.SymbolBase) ? "BTC" : _session.SymbolBase.Trim().ToUpperInvariant();
        _selectedQuote = string.IsNullOrEmpty(_session.SymbolQuote) ? "USDT" : _session.SymbolQuote.Trim().ToUpperInvariant();
        _showVolume = _session.ShowVolume;
        _showRsi = _session.ShowRsi;
        _showStoch = _session.ShowStoch;
        _showLux = _session.ShowLux;
        _showMacd = _session.ShowMacd;
    }

    private void SaveSession()
    {
        if (Enum.TryParse<CryptoIntervalPeriod>(_selectedInterval, out var period))
        {
            _session.ActiveInterval = period;
            _session.IntervalName = period.ToString().Replace("interval", "");
        }
        _session.SymbolBase = _selectedBase;
        _session.SymbolQuote = _selectedQuote;

        _session.ShowBollingerBand = _showBB;
        _session.ShowKeltnerChannel = _showKeltner;
        _session.ShowPSar = _showPSar;
        _session.ShowNwe = _showNwe;
        _session.ShowNweRepainting = _showNweRepainting;
        _session.ShowSmaLinesSbm = _showSmaLinesSbm;
        _session.ShowDlzZones = _showDlzZones;
        _session.ShowFvgZones = _showFvgZones;
        _session.ShowSmcZones = _showSmcZones;
        _session.ShowDtb = _showDtb;
        _session.ShowSignals = _showSignals;
        _session.ShowPositions = _showPositions;
        _session.ShowPoints = _showPivots;
        _session.TrendShowZigZag = _showZigZag;
        _session.ShowFibRetracement = _showFib;
        _session.ShowFibZigZag = _showFibZigZag;
        _session.ShowCandles = _showCandles;
        _session.TrendType = _trendType;
        _session.FibTrend = _fibTrendType;
        _session.ShowVolume = _showVolume;
        _session.ShowRsi = _showRsi;
        _session.ShowStoch = _showStoch;
        _session.ShowLux = _showLux;
        _session.ShowMacd = _showMacd;

