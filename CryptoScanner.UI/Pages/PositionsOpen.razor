    protected override void OnInitialized()
    {
        _rowCallbacks = new(vm => new RowCallbacks
        {
            Click = e => OnRowClick(e, vm),
            DoubleClick = () => OnDoubleClick(vm),
            ContextMenu = e => OnRowContextMenu(e, vm),
        });
        _headerCallbacks = new(col => new HeaderCallbacks
        {
            Sort = () => OnSort(col.Column),
            DragStart = () => OnHeaderDragStart(col.Column),
            DragOver = () => OnHeaderDragOver(col.Column),
            Drop = () => OnHeaderDrop(col.Column),
        });

        _columnState = new GridColumnState<PositionColumnEnum>(
            GridNames.PositionOpen, StateService, PositionOpenColumnDefs,
            PositionColumnEnum.UpdateTime, System.ComponentModel.ListSortDirection.Descending);

        PositionService.OpenPositionsChanged += OnPositionsChanged;

        // Profit and profit percentage moved on while this tab was away, so put the rows back in
        // the order the user sorted them in before reading them.
        PositionService.ResortOpen();
        _positions = PositionService.OpenPositions.ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A menu opened on the last row of a grid ran off the bottom of the screen. Move it back
        // inside the window once it has been laid out, the way Avalonia shifts its menu up.
        if (_contextMenuVisible && !_contextMenuPositioned)
        {
            _contextMenuPositioned = true;
            try
            {
                await JS.InvokeVoidAsync("cryptoScannerPopup.keepInViewport", _contextMenuRef);
            }
            catch (JSException)
            {
            }
        }
        else if (!_contextMenuVisible)
            _contextMenuPositioned = false;

        if (!_jsInitialized)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("GridInterop.initAllResizeHandles", _tableRef, _dotNetRef);
                _jsInitialized = true;
            }
            catch (JSException)
            {
            }
        }
    }

    [JSInvokable]
    public void OnColumnResized(string columnName, double newWidth)
    {
        if (Enum.TryParse<PositionColumnEnum>(columnName, out var col))
        {
            var runtime = _columnState?.Columns.FirstOrDefault(c => c.Column.Equals(col));
            if (runtime != null)
            {
                runtime.Width = newWidth;
                _columnState?.SaveColumnState();
                InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnPositionsChanged()
    {
        if (_disposed)
            return;
        _positions = PositionService.OpenPositions.ToList();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSort(PositionColumnEnum column)
    {
        PositionService.SortOpen(column);
    }

    private static string GetCellClass(ColumnRuntimeState<PositionColumnEnum> col, PositionViewModel vm)
    {
        var baseClass = col.CssClass;
        var colorClass = vm.GetCellColorClass(col.Column);
        if (string.IsNullOrEmpty(colorClass))
            return baseClass;
        return string.IsNullOrEmpty(baseClass) ? colorClass : $"{baseClass} {colorClass}";
    }

    private void OnRowClick(MouseEventArgs e, PositionViewModel vm)
    {
        if (e.CtrlKey)
        {
            if (SelectedPositions.Contains(vm))
                SelectedPositions.Remove(vm);
            else
                SelectedPositions.Add(vm);
            SelectedPosition = vm;
        }
        else if (e.ShiftKey && SelectedPosition != null)
        {
            int startIdx = _positions.IndexOf(SelectedPosition);
            int endIdx = _positions.IndexOf(vm);
            if (startIdx >= 0 && endIdx >= 0)
            {
                int from = Math.Min(startIdx, endIdx);
                int to = Math.Max(startIdx, endIdx);
                SelectedPositions.Clear();
                for (int i = from; i <= to; i++)
                    SelectedPositions.Add(_positions[i]);
            }
        }
        else
        {
            SelectedPositions.Clear();
            SelectedPositions.Add(vm);
            SelectedPosition = vm;
        }
    }

    private void OnDoubleClick(PositionViewModel vm)
    {
        SelectedPosition = vm;
        if (vm.Object.Symbol != null)
            GridCommandService.HandleDoubleClick(vm.Object.Symbol, vm.Object.Interval);
    }

    private void OnRowContextMenu(MouseEventArgs e, PositionViewModel vm)
    {
        SelectedPosition = vm;
        _contextMenuPosition = vm;
        _contextMenuType = ContextMenuType.Row;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuVisible = true;
    }

    private void OnHeaderContextMenu(MouseEventArgs e)
    {
        _contextMenuType = ContextMenuType.Header;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _contextMenuVisible = false;
        _contextMenuPosition = null;
        _contextMenuType = ContextMenuType.None;
    }

    private void OnMenuOpenChart()
    {
        // CloseTime is null here by definition, so the window runs from the entry up to now — a
        // position opened days ago still starts on screen where it was entered.
        if (_contextMenuPosition?.Object.Symbol != null)
        {
            var position = _contextMenuPosition.Object;
            GridCommandService.OpenChart(position.Symbol, position.Interval,
                position.CreateTime, position.CloseTime);
        }
        CloseContextMenu();
    }

    private void OnMenuOpenTradingApp()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.OpenTradingApp(_contextMenuPosition.Object.Symbol, _contextMenuPosition.Object.Interval);
        CloseContextMenu();
    }

    private void OnMenuOpenTradingViewInternal()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.OpenTradingViewInternal(_contextMenuPosition.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuOpenTradingViewExternal()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.OpenTradingViewExternal(_contextMenuPosition.Object.Symbol, _contextMenuPosition.Object.Interval);
        CloseContextMenu();
    }

    private void OnMenuOpenExchange()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.OpenExchange(_contextMenuPosition.Object.Symbol, _contextMenuPosition.Object.Interval);
        CloseContextMenu();
    }

    private async Task OnMenuCopySymbolName()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            await GridCommandService.CopySymbolNameAsync(_contextMenuPosition.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuCalculateZones()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.CalculateLiquidityZones(_contextMenuPosition.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuPositionRecalculate()
    {
        if (_contextMenuPosition?.Object != null)
            GridCommandService.PositionRecalculate(_contextMenuPosition.Object);
        CloseContextMenu();
    }

    private void OnMenuPositionDelete()
    {
        if (_contextMenuPosition?.Object != null)
            GridCommandService.PositionDelete(_contextMenuPosition.Object);
        CloseContextMenu();
    }

    private void OnMenuPositionAddDca()
    {
        if (_contextMenuPosition?.Object != null && _contextMenuPosition.Object.CloseTime == null)
            GridCommandService.PositionAddDca(_contextMenuPosition.Object);
        CloseContextMenu();
    }

    private void OnMenuPositionCancelDca()
    {
        if (_contextMenuPosition?.Object != null && _contextMenuPosition.Object.CloseTime == null)
            GridCommandService.PositionCancelDca(_contextMenuPosition.Object);
        CloseContextMenu();
    }

    private async Task OnMenuCopyDataCells()
    {
        if (_contextMenuPosition != null)
        {
            var cells = string.Join("\t", _columnState!.VisibleColumns.Select(c => _contextMenuPosition.GetCellValue(c.Column)));
            await GridCommandService.CopyDataCellsAsync(cells);
        }
        CloseContextMenu();
    }

    private void OnMenuExportTrend()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.ExportTrendToLog(_contextMenuPosition.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuExportSymbolToExcel()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.ExportSymbolToExcel(_contextMenuPosition.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuExportBarometerToExcel()
    {
        if (_contextMenuPosition?.Object.Symbol != null)
            GridCommandService.ExportBarometerToExcel(_contextMenuPosition.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuExportPositionToExcel()
    {
        if (_contextMenuPosition?.Object != null)
            GridCommandService.ExportPositionToExcel(_contextMenuPosition.Object);
        CloseContextMenu();
    }

    private void OnMenuExportAllPositionsToExcel()
    {
        Task.Run(() => new CryptoScanner.Core.Excel.ExcelPostionsDump().ExportToExcel());
        CloseContextMenu();
    }

    private void OnMenuDeleteAllPositions()
    {
        CloseContextMenu();
        _confirmDeleteAllVisible = true;
    }

    private void OnConfirmDeleteAll()
    {
        GridCommandService.PositionDeleteAll();
    }

    private void OnMenuHideSelection()
    {
        SelectedPosition = null;
        SelectedPositions.Clear();
        CloseContextMenu();
    }

    private void OnMenuAdjustColumns()
    {
        CloseContextMenu();
        _columnDialogVisible = true;
    }

    private void OnColumnsVisibilityChanged()
    {
        _jsInitialized = false;
        StateHasChanged();
    }

    private void OnHeaderDragStart(PositionColumnEnum column) => _dragSourceColumn = column;

    private void OnHeaderDragOver(PositionColumnEnum column)
    {
        if (_dragSourceColumn.HasValue && !_dragSourceColumn.Value.Equals(column))
            _dragOverColumn = column;
    }

    private void OnHeaderDrop(PositionColumnEnum targetColumn)
    {
        _dragOverColumn = null;
        if (!_dragSourceColumn.HasValue || _dragSourceColumn.Value.Equals(targetColumn))
            return;

        var source = _columnState?.Columns.FirstOrDefault(c => c.Column.Equals(_dragSourceColumn.Value));
        var target = _columnState?.Columns.FirstOrDefault(c => c.Column.Equals(targetColumn));
        if (source == null || target == null)
            return;

        int sourceIdx = source.DisplayIndex;
        int targetIdx = target.DisplayIndex;
        foreach (var c in _columnState!.Columns)
        {
            if (sourceIdx < targetIdx)
            {
                if (c.DisplayIndex > sourceIdx && c.DisplayIndex <= targetIdx)
                    c.DisplayIndex--;
            }
            else
            {
                if (c.DisplayIndex >= targetIdx && c.DisplayIndex < sourceIdx)
                    c.DisplayIndex++;
            }
        }
        source.DisplayIndex = targetIdx;
        _columnState.SaveColumnState();
        _dragSourceColumn = null;
        _jsInitialized = false;
    }

    private void OnHeaderDragEnd()
    {
        _dragSourceColumn = null;
        _dragOverColumn = null;
    }

    public void Dispose()
    {
        _disposed = true;
        _dotNetRef?.Dispose();
        PositionService.OpenPositionsChanged -= OnPositionsChanged;
    }
}
