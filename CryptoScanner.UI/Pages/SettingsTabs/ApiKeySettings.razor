@using CryptoScanner.Core.Core
@using CryptoScanner.Core.Enums
@using CryptoScanner.Core.Settings
@using CryptoScanner.Core.Telegram

<div class="settings-wrap">

    @* Captions, order and the "first three .. last three" hint next to every key are the ones of
       ApiTelegramView / ApiAltradyView. The Dutch captions are copied verbatim from that view,
       so both applications say the same thing. *@
    <!-- Telegram -->
    <div class="settings-group">
        <div class="settings-group-header">Telegram</div>
        <div class="settings-group-body">
            <div class="field">
                <label>Token</label>
                <span class="field-control">
                    <input type="password" class="input-text" style="width:230px;" @bind="_telegramToken" />
                    <span class="key-hint">@Hint(_telegramToken)</span>
                </span>
            </div>
            <div class="field">
                <label>ChatId</label>
                <span class="field-control">
                    <input type="password" class="input-text" style="width:230px;" @bind="_telegramChatId" />
                    <span class="key-hint">@Hint(_telegramChatId)</span>
                </span>
            </div>
            <div class="field">
                <input type="checkbox" class="input-checkbox" @bind="_telegramEnabled" />
                <label>Telegram gebruiken</label>
                <span class="field-control">
                    <button class="btn btn-secondary" @onclick="StartStopTelegram">@(ThreadTelegramBot.IsRunning ? "Stop" : "Start")</button>
                    <button class="btn btn-secondary" @onclick="TestTelegram">Test</button>
                </span>
            </div>
            @* Per category, so the trader can be silenced without losing the signals *@
            <div class="field">
                <label>Verstuur naar telegram</label>
            </div>
            <div class="field" style="margin-left:16px;">
                <input type="checkbox" class="input-checkbox" @bind="_telegramSendSignals" />
                <label>Signalen</label>
            </div>
            <div class="field" style="margin-left:16px;">
                <input type="checkbox" class="input-checkbox" @bind="_telegramSendOrders" />
                <label>Geplaatste orders (entry, dca, take profit, annuleren)</label>
            </div>
            <div class="field" style="margin-left:16px;">
                <input type="checkbox" class="input-checkbox" @bind="_telegramSendFilledOrders" />
                <label>Gevulde orders</label>
            </div>
            <div class="field" style="margin-left:16px;">
                <input type="checkbox" class="input-checkbox" @bind="_telegramSendSystemMessages" />
                <label>Systeemmeldingen (opstarten, herstarten, pauzeregels)</label>
            </div>
            <div class="field">
                <input type="checkbox" class="input-checkbox" @bind="_telegramEmoji" />
                <label>Gebruik Emoji's in de trend</label>
            </div>
        </div>
    </div>

    <!-- Altrady -->
    <div class="settings-group">
        <div class="settings-group-header">Altrady API key</div>
        <div class="settings-group-body">
            <div class="field">
                <label>API key</label>
                <span class="field-control">
                    <input type="password" class="input-text" style="width:230px;" @bind="_altradyKey" />
                    <span class="key-hint">@Hint(_altradyKey)</span>
                </span>
            </div>
            <div class="field">
                <label>API secret</label>
                <span class="field-control">
                    <input type="password" class="input-text" style="width:230px;" @bind="_altradySecret" />
                    <span class="key-hint">@Hint(_altradySecret)</span>
                </span>
            </div>
        </div>
    </div>

    @* The Avalonia API keys tab has Telegram, Altrady and a hidden Alpaca — an exchange key screen
       does not exist there at all. Hidden rather than removed, so the values keep loading and
       saving exactly as before. *@
    <!-- Exchange API keys -->
    <div class="settings-group" style="display:none;">
        <div class="settings-group-header">Exchange API Keys</div>
        <div class="settings-group-body">
            <div class="field">
                <label>Exchange</label>
                <span class="field-value">@(GlobalData.ActiveExchange?.Name ?? "None")</span>
            </div>
            <div class="field">
                <label>API Key</label>
                <input type="password" class="input-text" style="width:300px;" @bind="_apiKey" />
            </div>
            <div class="field">
                <label>API Secret</label>
                <input type="password" class="input-text" style="width:300px;" @bind="_apiSecret" />
            </div>
        </div>
    </div>

</div>

@code {
    private string _telegramToken = "";
    private string _telegramChatId = "";
    private bool _telegramEnabled = true;
    private bool _telegramEmoji;
    private bool _telegramSendSignals;
    private bool _telegramSendOrders = true;
    private bool _telegramSendFilledOrders = true;
    private bool _telegramSendSystemMessages = true;
    private string _apiKey = "";
    private string _apiSecret = "";
    private string _altradyKey = "";
    private string _altradySecret = "";

    /// <summary>
    /// Same as GetDisplayApiKey in the Avalonia viewmodels: the first three and the last three
    /// characters, so you can tell which key is filled in without showing it.
    /// </summary>
    private static string Hint(string text)
    {
        return string.IsNullOrEmpty(text) || text.Length < 4 ? "" : $"{text[..3]}.. {text[^3..]}";
    }

    /// <summary>
    /// Stop the bot, or start it with the token that is typed in the screen at this moment. That is
    /// the point of the button: trying out a changed token without restarting the scanner. The
    /// settings themselves are only written by SaveInto.
    /// </summary>
    private async Task StartStopTelegram()
    {
        if (ThreadTelegramBot.IsRunning)
        {
            await ThreadTelegramBot.StopAsync();
            GlobalData.AddTextToLogTab("Telegram bot stopped");
        }
        else
        {
            if (await ThreadTelegramBot.Start(_telegramToken.Trim(), _telegramChatId.Trim()))
                GlobalData.AddTextToLogTab("Telegram bot started");
            // A refused token is reported by Start itself, on the same log tab
        }
    }

    private void TestTelegram()
    {
        ThreadTelegramBot.ChatId = _telegramChatId.Trim();
        if (!ThreadTelegramBot.IsRunning)
        {
            // Without this the button did nothing at all and said nothing either
            GlobalData.AddTextToLogTab("Telegram bot is not running, press Start first");
            return;
        }
        GlobalData.AddTextToTelegram("This is a test message", CryptoTelegramCategory.Test);
    }

    protected override void OnInitialized()
    {
        LoadFrom(GlobalData.Settings);
    }

    public void LoadFrom(SettingsBasic settings)
    {
        _telegramToken = GlobalData.Telegram.Token;
        _telegramChatId = GlobalData.Telegram.ChatId;
        _telegramEnabled = GlobalData.Telegram.Enabled;
        _telegramEmoji = GlobalData.Telegram.EmojiInTrend;
        _telegramSendSignals = GlobalData.Telegram.SendSignalsToTelegram;
        _telegramSendOrders = GlobalData.Telegram.SendOrdersToTelegram;
        _telegramSendFilledOrders = GlobalData.Telegram.SendFilledOrdersToTelegram;
        _telegramSendSystemMessages = GlobalData.Telegram.SendSystemMessagesToTelegram;
        _apiKey = GlobalData.TradingApi.Key;
        _apiSecret = GlobalData.TradingApi.Secret;
        _altradyKey = GlobalData.AltradyApi.Key;
        _altradySecret = GlobalData.AltradyApi.Secret;
    }

    public void SaveTo(SettingsBasic settings)
    {
        GlobalData.Telegram.Token = _telegramToken;
        GlobalData.Telegram.ChatId = _telegramChatId;
        GlobalData.Telegram.Enabled = _telegramEnabled;
        GlobalData.Telegram.EmojiInTrend = _telegramEmoji;
        GlobalData.Telegram.SendSignalsToTelegram = _telegramSendSignals;
        GlobalData.Telegram.SendOrdersToTelegram = _telegramSendOrders;
        GlobalData.Telegram.SendFilledOrdersToTelegram = _telegramSendFilledOrders;
        GlobalData.Telegram.SendSystemMessagesToTelegram = _telegramSendSystemMessages;
        GlobalData.TradingApi.Key = _apiKey;
        GlobalData.TradingApi.Secret = _apiSecret;
        GlobalData.AltradyApi.Key = _altradyKey;
        GlobalData.AltradyApi.Secret = _altradySecret;
    }
}
