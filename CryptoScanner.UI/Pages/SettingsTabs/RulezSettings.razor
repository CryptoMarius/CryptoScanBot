@using CryptoScanner.Core.Core
@using CryptoScanner.Core.Enums
@using CryptoScanner.Core.Settings

<div class="settings-wrap" style="flex-direction: column;">

    <div class="settings-group" style="max-width: none; width: 100%;">
        <div class="settings-group-header">Trading rules</div>
        <div class="settings-group-body" style="flex-direction: column;">
            <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                <button class="btn btn-secondary" @onclick="AddRule">Add rule</button>
                <button class="btn btn-secondary" @onclick="RemoveLastRule" disabled="@(_rules.Count == 0)">Remove rule</button>
            </div>

            @if (_rules.Count == 0)
            {
                <div class="text-muted">No trading rules defined.</div>
            }
            else
            {
                @* One line per rule with the captions once, as a header above the columns, and the
                   rule number in front — the per-rule "Trading rule 1" caption above every block
                   took a line of its own for no information.
                   Avalonia puts no limits on these TextBoxes at all; the bounds below are what the
                   values can sensibly be, so the dialog does at least some validating of its own. *@
                <div class="rule-row rule-header">
                    <span class="rule-number"></span>
                    <span style="width: 120px;">Symbol</span>
                    <span style="width: 60px;">Candles</span>
                    <span style="width: 80px;">Interval</span>
                    <span style="width: 80px;">Percentage</span>
                    <span style="width: 70px;" title="Counted in candles of the BASE interval, not in minutes and not in candles of the rule's own interval. Live the base interval is 1m so it equals minutes there, but an emulator run on a 5m or 15m base multiplies it by that.">Cooldown (candles)</span>
                </div>

                @for (int idx = 0; idx < _rules.Count; idx++)
                {
                    var rule = _rules[idx];
                    var ruleIndex = idx + 1;
                    <div class="rule-row">
                        <span class="rule-number">#@ruleIndex</span>
                        <input type="text" class="input-text" @bind="rule.Symbol" style="width:120px;" />
                        <input type="number" class="input-number" min="1" max="1000" @bind="rule.Candles" style="width:60px;" />
                        <select class="input-select" @bind="rule.Interval" style="width:80px;">
                            @foreach (var kv in _intervalOptions)
                            {
                                <option value="@kv.Value">@kv.Key</option>
                            }
                        </select>
                        <input type="number" class="input-number" step="0.01" min="0" max="100" @bind="rule.Percentage" style="width:80px;" />
                        <input type="number" class="input-number" min="0" max="1440" @bind="rule.CoolDown" style="width:70px;" />
                    </div>
                }
            }
        </div>
    </div>

</div>

@code {
    private List<RuleItem> _rules = [];
    private Dictionary<string, CryptoIntervalPeriod> _intervalOptions = [];

    protected override void OnInitialized()
    {
        foreach (var interval in GlobalData.IntervalList)
            _intervalOptions[interval.Name] = interval.IntervalPeriod;

        LoadFrom(GlobalData.Settings);
    }

    public void LoadFrom(SettingsBasic settings)
    {
        _rules.Clear();
        foreach (var rule in settings.Trading.PauseTradingRules)
        {
            _rules.Add(new RuleItem
            {
                Symbol = rule.Symbol,
                Candles = rule.Candles,
                Interval = rule.Interval,
                Percentage = rule.Percentage,
                CoolDown = rule.CoolDown,
            });
        }
    }

    public void SaveTo(SettingsBasic settings)
    {
        settings.Trading.PauseTradingRules.Clear();
        foreach (var item in _rules)
        {
            settings.Trading.PauseTradingRules.Add(new CryptoScanner.Core.Settings.PauseTradingRule
            {
                Symbol = item.Symbol,
                Candles = item.Candles,
                Interval = item.Interval,
                Percentage = item.Percentage,
                CoolDown = item.CoolDown,
            });
        }
    }

    private void AddRule()
    {
        _rules.Add(new RuleItem
        {
            Symbol = "BTCUSDT",
            Candles = 5,
            Interval = CryptoIntervalPeriod.interval5m,
            Percentage = 4.0,
            CoolDown = 20,
        });
    }

    private void RemoveLastRule()
    {
        if (_rules.Count > 0)
            _rules.RemoveAt(_rules.Count - 1);
    }

    private class RuleItem
    {
        public string Symbol { get; set; } = "BTCUSDT";
        public int Candles { get; set; } = 5;
        public CryptoIntervalPeriod Interval { get; set; } = CryptoIntervalPeriod.interval5m;
        public double Percentage { get; set; } = 4.0;
        public int CoolDown { get; set; } = 20;
    }
}
