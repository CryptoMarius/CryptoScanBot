@page "/"
@using CryptoScanner.Core.Core
@using CryptoScanner.Core.Enums
@using CryptoScanner.Core.Model
@using CryptoScanner.UI.Services
@using CryptoScanner.UI.ViewModels
@using CryptoScanner.UI.Components
@using CryptoScanner.Core.Services
@inject SignalService SignalService
@inject GridCommandService GridCommandService
@inject ApplicationStateService StateService
@inject IJSRuntime JS
@implements IDisposable

<div class="signal-grid-wrapper">
    <table class="data-table" @ref="_tableRef">
        <thead @oncontextmenu="OnHeaderContextMenu" @oncontextmenu:preventDefault="true">
            <tr>
                @foreach (var col in _columnState!.VisibleColumns)
                {
                    var header = _headerCallbacks.Get(col);
                    <th class="@col.CssClass @(_dragOverColumn?.Equals(col.Column) == true ? "drag-over" : "")"
                        data-col="@col.Column"
                        draggable="true"
                        @onclick="header.Sort"
                        @ondragstart="header.DragStart"
                        @ondragover="header.DragOver"
                        @ondragover:preventDefault="true"
                        @ondrop="header.Drop"
                        @ondragend="OnHeaderDragEnd"
                        style="@(col.Width > 0 ? $"width:{col.Width}px" : "")">
                        @col.Header@(SignalService.SortState.GetSortIndicator(col.Column))
                        <div class="col-resize-handle" @onmousedown:stopPropagation="true"></div>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (_signals.Count > 0)
            {
                @foreach (var vm in _signals)
                {
                    var row = _rowCallbacks.Get(vm);
                    <tr class="@(vm.IsInvalid ? "row-invalid" : "") @(_selectedSignals.Contains(vm) ? "selected" : "")"
                        @key="vm"
                        @onclick="row.Click"
                        @ondblclick="row.DoubleClick"
                        @oncontextmenu="row.ContextMenu"
                        @oncontextmenu:preventDefault="true">
                        @foreach (var col in _columnState!.VisibleColumns)
                        {
                            <td class="@GetCellClass(col, vm)" style="@vm.GetBackgroundStyle(col.Column)">@vm.GetCellValue(col.Column)</td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@_columnState!.VisibleColumns.Count()" class="empty-state">
                        @if (GlobalData.ActiveExchange == null)
                        {
                            <text>No exchange active. Start the scanner first.</text>
                        }
                        else
                        {
                            <text>No signals found.</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_contextMenuVisible)
{
    <div class="context-menu-overlay" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="context-menu" @ref="_contextMenuRef" style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;">
        @if (_contextMenuType == ContextMenuType.Row && _contextMenuSignal != null)
        {
            <div class="context-menu-item" @onclick="OnMenuOpenChart">Open symbol chart</div>
            <div class="context-menu-item" @onclick="OnMenuOpenTradingApp">Open trading app</div>
            <div class="context-menu-item" @onclick="OnMenuOpenTradingViewInternal">Open TradingView internal</div>
            <div class="context-menu-item" @onclick="OnMenuOpenTradingViewExternal">Open TradingView external</div>
            <div class="context-menu-item" @onclick="OnMenuOpenExchange">Open the exchange</div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item" @onclick="OnMenuCopySymbolName">Copy symbol name</div>
            <div class="context-menu-item" @onclick="OnMenuCopyDataCells">Copy all data cells</div>
            <div class="context-menu-item" @onclick="OnMenuCalculateZones">Calculate liquidity zones</div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item" @onclick="OnMenuExportTrend">Export trend information to log</div>
            <div class="context-menu-item" @onclick="OnMenuExportSignalToExcel">Export signal information to Excel</div>
            <div class="context-menu-item" @onclick="OnMenuExportSymbolToExcel">Export symbol information to Excel</div>
            <div class="context-menu-item" @onclick="OnMenuExportBarometerToExcel">Export barometer information to Excel</div>
            <div class="context-menu-item" @onclick="OnMenuExportAllSignalsToExcel">Export all signals to Excel</div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item" @onclick="OnMenuDeleteAll">Delete all signals</div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item" @onclick="OnMenuHideSelection">Hide grid selection</div>
        }
        else if (_contextMenuType == ContextMenuType.Header)
        {
            <div class="context-menu-item" @onclick="OnMenuAdjustColumns">Adjust Columns...</div>
        }
    </div>
}

<ColumnVisibilityDialog TEnum="SignalColumnEnum"
                        @bind-Visible="_columnDialogVisible"
                        ColumnState="_columnState"
                        OnColumnsChanged="OnColumnsVisibilityChanged" />

<CryptoScanner.UI.Components.ConfirmDialog @bind-Visible="_confirmDeleteAllVisible"
    Title="Delete all signals"
    Message="Are you sure you want to delete all signals?"
    OnConfirmed="OnConfirmDeleteAll" />

@code {
    private enum ContextMenuType { None, Row, Header }

    private List<SignalViewModel> _signals = [];
    private bool _disposed;
    private bool _confirmDeleteAllVisible;

    private GridColumnState<SignalColumnEnum>? _columnState;

    // Event handlers per row and per column header, created once and handed to Blazor unchanged on
    // every render. See GridCallbackCache for what that saves. Built in OnInitialized because the
    // factories capture this.
    private GridCallbackCache<SignalViewModel, RowCallbacks> _rowCallbacks = null!;
    private GridCallbackCache<ColumnRuntimeState<SignalColumnEnum>, HeaderCallbacks> _headerCallbacks = null!;
    private ElementReference _tableRef;
    private DotNetObjectReference<Signals>? _dotNetRef;
    private bool _jsInitialized;

    private SignalColumnEnum? _dragSourceColumn;
    private SignalColumnEnum? _dragOverColumn;

    private SignalViewModel? _selectedSignal;
    private readonly HashSet<SignalViewModel> _selectedSignals = [];
    private bool _contextMenuVisible;
    private ElementReference _contextMenuRef;
    private bool _contextMenuPositioned;
    private double _contextMenuX;
    private double _contextMenuY;
    private ContextMenuType _contextMenuType;
    private SignalViewModel? _contextMenuSignal;
    private bool _columnDialogVisible;

    private static readonly GridColumnDef<SignalColumnEnum>[] SignalColumnDefs =
    [
        new() { Column = SignalColumnEnum.Id, Header = "Id", CssClass = "text-right", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 0 },
        new() { Column = SignalColumnEnum.Date, Header = "Date", CssClass = "mono", DefaultWidth = 145, DefaultVisible = true, DefaultDisplayIndex = 1 },
        new() { Column = SignalColumnEnum.Exchange, Header = "Exchange", CssClass = "", DefaultWidth = 110, DefaultVisible = false, DefaultDisplayIndex = 2 },
        new() { Column = SignalColumnEnum.Symbol, Header = "Symbol", CssClass = "symbol-name", DefaultWidth = 100, DefaultVisible = true, DefaultDisplayIndex = 3 },
        new() { Column = SignalColumnEnum.SignalVolume, Header = "Volume", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = true, DefaultDisplayIndex = 4 },
        new() { Column = SignalColumnEnum.Side, Header = "Side", CssClass = "text-center", DefaultWidth = 50, DefaultVisible = true, DefaultDisplayIndex = 5 },
        new() { Column = SignalColumnEnum.Interval, Header = "Interval", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = true, DefaultDisplayIndex = 6 },
        new() { Column = SignalColumnEnum.Strategy, Header = "Strategy", CssClass = "", DefaultWidth = 60, DefaultVisible = true, DefaultDisplayIndex = 7 },
        new() { Column = SignalColumnEnum.EventText, Header = "Text", CssClass = "event-text", DefaultWidth = 150, DefaultVisible = false, DefaultDisplayIndex = 8 },
        new() { Column = SignalColumnEnum.SignalPrice, Header = "Price", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = true, DefaultDisplayIndex = 9 },
        new() { Column = SignalColumnEnum.PriceChange, Header = "Change", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = true, DefaultDisplayIndex = 10 },
        new() { Column = SignalColumnEnum.TrendInterval, Header = "TF trend", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = true, DefaultDisplayIndex = 11 },
        new() { Column = SignalColumnEnum.TrendPercentagePrimary, Header = "Marketprimtrend", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 12 },
        new() { Column = SignalColumnEnum.TrendPercentageSecondary, Header = "Marketsectrend", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 13 },
        new() { Column = SignalColumnEnum.Last24HoursChange, Header = "24h Change", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 14 },
        new() { Column = SignalColumnEnum.LastXDaysEffective, Header = "X day's move", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 15 },
        new() { Column = SignalColumnEnum.BB, Header = "BB%", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = true, DefaultDisplayIndex = 16 },
        new() { Column = SignalColumnEnum.BbLower, Header = "BbLower", CssClass = "text-right mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 17 },
        new() { Column = SignalColumnEnum.BbUpper, Header = "BbUpper", CssClass = "text-right mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 18 },
        new() { Column = SignalColumnEnum.AvgBB, Header = "Avg BB%", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 19 },
        new() { Column = SignalColumnEnum.Rsi, Header = "Rsi", CssClass = "text-right mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 20 },
        new() { Column = SignalColumnEnum.LuxIndicator5m, Header = "Lux 5m", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 21 },
        new() { Column = SignalColumnEnum.MacdValue, Header = "Macd Value", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 22 },
        new() { Column = SignalColumnEnum.MacdSignal, Header = "Macd Signal", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 23 },
        new() { Column = SignalColumnEnum.MacdHistogram, Header = "Macd Histo", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 24 },
        new() { Column = SignalColumnEnum.StochOscillator, Header = "Stoch Oscillator", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 25 },
        new() { Column = SignalColumnEnum.StochSignal, Header = "Stoch Signal", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 26 },
        new() { Column = SignalColumnEnum.Sma200, Header = "Sma200", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 27 },
        new() { Column = SignalColumnEnum.Sma50, Header = "Sma50", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 28 },
        new() { Column = SignalColumnEnum.Sma20, Header = "Sma20", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 29 },
        new() { Column = SignalColumnEnum.PSar, Header = "PSar", CssClass = "text-right mono", DefaultWidth = 75, DefaultVisible = false, DefaultDisplayIndex = 30 },
        new() { Column = SignalColumnEnum.Trend15m, Header = "Trend 15m", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 31 },
        new() { Column = SignalColumnEnum.Trend30m, Header = "Trend 30m", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 32 },
        new() { Column = SignalColumnEnum.Trend1h, Header = "Trend 1h", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 33 },
        new() { Column = SignalColumnEnum.Trend4h, Header = "Trend 4h", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 34 },
        new() { Column = SignalColumnEnum.Trend1d, Header = "Trend 1d", CssClass = "text-center", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 35 },
        new() { Column = SignalColumnEnum.Barometer15m, Header = "Bm 15m", CssClass = "text-center mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 36 },
        new() { Column = SignalColumnEnum.Barometer30m, Header = "Bm 30m", CssClass = "text-center mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 37 },
        new() { Column = SignalColumnEnum.Barometer1h, Header = "Bm 1h", CssClass = "text-center mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 38 },
        new() { Column = SignalColumnEnum.Barometer4h, Header = "Bm 4h", CssClass = "text-center mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 39 },
        new() { Column = SignalColumnEnum.Barometer1d, Header = "Bm 1d", CssClass = "text-center mono", DefaultWidth = 60, DefaultVisible = false, DefaultDisplayIndex = 40 },
        new() { Column = SignalColumnEnum.MinimumEntry, Header = "Min Entry", CssClass = "text-right mono", DefaultWidth = 60, DefaultVisible = true, DefaultDisplayIndex = 41 },
    ];

    protected override void OnInitialized()
    {
        _rowCallbacks = new(vm => new RowCallbacks
        {
            Click = e => OnRowClick(e, vm),
            DoubleClick = () => OnDoubleClick(vm),
            ContextMenu = e => OnRowContextMenu(e, vm),
        });
        _headerCallbacks = new(col => new HeaderCallbacks
        {
            Sort = () => OnSort(col.Column),
            DragStart = () => OnHeaderDragStart(col.Column),
            DragOver = () => OnHeaderDragOver(col.Column),
            Drop = () => OnHeaderDrop(col.Column),
        });

        _columnState = new GridColumnState<SignalColumnEnum>(
            "Signal", StateService, SignalColumnDefs,
            SignalColumnEnum.Date, System.ComponentModel.ListSortDirection.Descending);

        SignalService.SignalsChanged += OnSignalsChanged;
        _signals = SignalService.Signals.ToList();
        // The queue pump and the expiration cleanup run in SignalService itself so they keep
        // going while this tab is closed (same as the Avalonia DispatcherTimers).
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A menu opened on the last row of a grid ran off the bottom of the screen. Move it back
        // inside the window once it has been laid out, the way Avalonia shifts its menu up.
        if (_contextMenuVisible && !_contextMenuPositioned)
        {
            _contextMenuPositioned = true;
            try
            {
                await JS.InvokeVoidAsync("cryptoScannerPopup.keepInViewport", _contextMenuRef);
            }
            catch (JSException)
            {
            }
        }
        else if (!_contextMenuVisible)
            _contextMenuPositioned = false;

        if (!_jsInitialized)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("GridInterop.initAllResizeHandles", _tableRef, _dotNetRef);
                _jsInitialized = true;
            }
            catch (JSException)
            {
            }
        }
    }

    [JSInvokable]
    public void OnColumnResized(string columnName, double newWidth)
    {
        if (Enum.TryParse<SignalColumnEnum>(columnName, out var col))
        {
            var runtime = _columnState?.Columns.FirstOrDefault(c => c.Column.Equals(col));
            if (runtime != null)
            {
                runtime.Width = newWidth;
                _columnState?.SaveColumnState();
                InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnSignalsChanged()
    {
        if (_disposed)
            return;
        _signals = SignalService.Signals.ToList();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSort(SignalColumnEnum column)
    {
        SignalService.Sort(column);
    }

    private static string GetCellClass(ColumnRuntimeState<SignalColumnEnum> col, SignalViewModel vm)
    {
        var baseClass = col.CssClass;
        var colorClass = vm.GetCellColorClass(col.Column);
        if (string.IsNullOrEmpty(colorClass))
            return baseClass;
        return string.IsNullOrEmpty(baseClass) ? colorClass : $"{baseClass} {colorClass}";
    }

    private void OnRowClick(MouseEventArgs e, SignalViewModel vm)
    {
        if (e.CtrlKey)
        {
            if (_selectedSignals.Contains(vm))
                _selectedSignals.Remove(vm);
            else
                _selectedSignals.Add(vm);
            _selectedSignal = vm;
        }
        else if (e.ShiftKey && _selectedSignal != null)
        {
            int startIdx = _signals.IndexOf(_selectedSignal);
            int endIdx = _signals.IndexOf(vm);
            if (startIdx >= 0 && endIdx >= 0)
            {
                int from = Math.Min(startIdx, endIdx);
                int to = Math.Max(startIdx, endIdx);
                _selectedSignals.Clear();
                for (int i = from; i <= to; i++)
                    _selectedSignals.Add(_signals[i]);
            }
        }
        else
        {
            _selectedSignals.Clear();
            _selectedSignals.Add(vm);
            _selectedSignal = vm;
        }
    }

    private void OnDoubleClick(SignalViewModel vm)
    {
        _selectedSignal = vm;
        if (vm.Object.Symbol != null)
            GridCommandService.HandleDoubleClick(vm.Object.Symbol, vm.Object.Interval);
    }

    private void OnRowContextMenu(MouseEventArgs e, SignalViewModel vm)
    {
        _selectedSignal = vm;
        _contextMenuSignal = vm;
        _contextMenuType = ContextMenuType.Row;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuVisible = true;
    }

    private void OnHeaderContextMenu(MouseEventArgs e)
    {
        _contextMenuType = ContextMenuType.Header;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _contextMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _contextMenuVisible = false;
        _contextMenuSignal = null;
        _contextMenuType = ContextMenuType.None;
    }

    private void OnMenuOpenChart()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.OpenChart(_contextMenuSignal.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuOpenTradingApp()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.OpenTradingApp(_contextMenuSignal.Object.Symbol, _contextMenuSignal.Object.Interval);
        CloseContextMenu();
    }

    private void OnMenuOpenTradingViewInternal()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.OpenTradingViewInternal(_contextMenuSignal.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuOpenTradingViewExternal()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.OpenTradingViewExternal(_contextMenuSignal.Object.Symbol, _contextMenuSignal.Object.Interval);
        CloseContextMenu();
    }

    private void OnMenuOpenExchange()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.OpenExchange(_contextMenuSignal.Object.Symbol, _contextMenuSignal.Object.Interval);
        CloseContextMenu();
    }

    private async Task OnMenuCopySymbolName()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            await GridCommandService.CopySymbolNameAsync(_contextMenuSignal.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuCalculateZones()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.CalculateLiquidityZones(_contextMenuSignal.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuExportTrend()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
        {
            var symbol = _contextMenuSignal.Object.Symbol;
            GlobalData.AddTextToLogTab($"Calculating market trend for {symbol.Name}...");
            _ = Task.Run(async () =>
            {
                try
                {
                    var trend = GlobalData.Settings.Trend.Primary;
                    var log = new System.Text.StringBuilder();
                    log.AppendLine($"Markettrend {symbol.Name}");

                    await CryptoScanner.Core.Trend.MarketTrend.CalculateMarketTrendAsync(symbol, trend, log);

                    foreach (var interval in GlobalData.IntervalList)
                    {
                        var symbolInterval = symbol.GetSymbolInterval(interval.IntervalPeriod);
                        var intervalTrend = trend.TrendType == CryptoScanner.Core.Core.TrendType.Primary
                            ? symbolInterval.TrendPrimary
                            : symbolInterval.TrendSecondary;

                        string s = intervalTrend.Trend switch
                        {
                            CryptoTrendIndicator.Bullish => $"{symbol.Name} {interval.Name} trend=bullish",
                            CryptoTrendIndicator.Bearish => $"{symbol.Name} {interval.Name} trend=bearish",
                            _ => $"{symbol.Name} {interval.Name} trend=sideways",
                        };
                        GlobalData.AddTextToLogTab(s);
                        log.AppendLine(s);
                    }

                    string filename = Path.Combine(GlobalData.AppDataFolder, "Trend information.txt");
                    File.WriteAllText(filename, log.ToString());
                }
                catch (Exception ex)
                {
                    GlobalData.AddTextToLogTab($"Error calculating trend: {ex.Message}");
                }
            });
        }
        CloseContextMenu();
    }

    private async Task OnMenuCopyDataCells()
    {
        if (_contextMenuSignal != null)
        {
            var cells = string.Join("\t", _columnState!.VisibleColumns.Select(c => _contextMenuSignal.GetCellValue(c.Column)));
            await GridCommandService.CopyDataCellsAsync(cells);
        }
        CloseContextMenu();
    }

    private void OnMenuExportSignalToExcel()
    {
        if (_contextMenuSignal?.Object != null)
            GridCommandService.ExportSignalToExcel(_contextMenuSignal.Object);
        CloseContextMenu();
    }

    private void OnMenuExportSymbolToExcel()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.ExportSymbolToExcel(_contextMenuSignal.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuExportBarometerToExcel()
    {
        if (_contextMenuSignal?.Object.Symbol != null)
            GridCommandService.ExportBarometerToExcel(_contextMenuSignal.Object.Symbol);
        CloseContextMenu();
    }

    private void OnMenuExportAllSignalsToExcel()
    {
        Task.Run(() =>
        {
            var dump = new CryptoScanner.Core.Excel.ExcelSignalsDump();
            dump.LoadSignals();
            dump.ExportToExcel();
        });
        CloseContextMenu();
    }

    private void OnMenuDeleteAll()
    {
        CloseContextMenu();
        _confirmDeleteAllVisible = true;
    }

    private void OnConfirmDeleteAll()
    {
        SignalService.DeleteAll();
    }

    private void OnMenuHideSelection()
    {
        _selectedSignal = null;
        _selectedSignals.Clear();
        CloseContextMenu();
    }

    private void OnMenuAdjustColumns()
    {
        CloseContextMenu();
        _columnDialogVisible = true;
    }

    private void OnColumnsVisibilityChanged()
    {
        _jsInitialized = false;
        StateHasChanged();
    }

    private void OnHeaderDragStart(SignalColumnEnum column) => _dragSourceColumn = column;

    private void OnHeaderDragOver(SignalColumnEnum column)
    {
        if (_dragSourceColumn.HasValue && !_dragSourceColumn.Value.Equals(column))
            _dragOverColumn = column;
    }

    private void OnHeaderDrop(SignalColumnEnum targetColumn)
    {
        _dragOverColumn = null;
        if (!_dragSourceColumn.HasValue || _dragSourceColumn.Value.Equals(targetColumn))
            return;

        var source = _columnState?.Columns.FirstOrDefault(c => c.Column.Equals(_dragSourceColumn.Value));
        var target = _columnState?.Columns.FirstOrDefault(c => c.Column.Equals(targetColumn));
        if (source == null || target == null)
            return;

        int sourceIdx = source.DisplayIndex;
        int targetIdx = target.DisplayIndex;
        foreach (var c in _columnState!.Columns)
        {
            if (sourceIdx < targetIdx)
            {
                if (c.DisplayIndex > sourceIdx && c.DisplayIndex <= targetIdx)
                    c.DisplayIndex--;
            }
            else
            {
                if (c.DisplayIndex >= targetIdx && c.DisplayIndex < sourceIdx)
                    c.DisplayIndex++;
            }
        }
        source.DisplayIndex = targetIdx;
        _columnState.SaveColumnState();
        _dragSourceColumn = null;
        _jsInitialized = false;
    }

    private void OnHeaderDragEnd()
    {
        _dragSourceColumn = null;
        _dragOverColumn = null;
    }

    public void Dispose()
    {
        _disposed = true;
        _dotNetRef?.Dispose();
        SignalService.SignalsChanged -= OnSignalsChanged;
    }
}
