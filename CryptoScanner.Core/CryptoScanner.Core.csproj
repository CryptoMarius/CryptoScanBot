<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net8.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CryptoScanner.Core</RootNamespace>
    <Configurations>Debug;Release;MaxOS-X-Debug</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CryptoScanner.CoreTests" />
    <!--
      The concrete exchanges moved to CryptoScanner.Exchanges but keep deriving from the base
      classes here (SymbolBase, CandleBase, ...). Those bases share a fair amount of internal
      plumbing (SaveExchangeInfo, ParseSymbol, SymbolInfo, ...) with their subclasses, which used
      to be free because everything sat in one assembly. Making all of that public would widen the
      api for everyone; this keeps it visible to the exchange implementations only.
    -->
    <InternalsVisibleTo Include="CryptoScanner.Exchanges" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

