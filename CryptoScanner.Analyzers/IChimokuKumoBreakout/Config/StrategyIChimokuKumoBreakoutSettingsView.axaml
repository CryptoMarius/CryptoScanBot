<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="80"
             xmlns:vm="using:CryptoScanner.Analyzers.IChimokuKumoBreakout.Config"
             x:DataType="vm:StrategyIChimokuKumoBreakoutSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.IChimokuKumoBreakout.Config.StrategyIChimokuKumoBreakoutSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- Filter on BB% (own pair since 26-09-2026, open point 109) -->
            <Grid ColumnDefinitions="Auto,80,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Filter on BB%:" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1" Text="{Binding BbMinPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBox Grid.Column="2" Text="{Binding BbMaxPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
