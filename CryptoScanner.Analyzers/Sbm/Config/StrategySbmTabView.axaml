<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:vm="using:CryptoScanner.Analyzers.Sbm.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategySbmTabViewModel"
             x:Class="CryptoScanner.Analyzers.Sbm.Config.StrategySbmTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="SBM – Signal Bollinger/MA" FontWeight="SemiBold"/>
                    <Run Text=" — Signals based on Bollinger Band and Moving Average alignment" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
                <TextBlock Text="Wiki ↗" FontSize="12" Cursor="Hand"
                           Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                           TextDecorations="Underline" Tapped="OnWikiTapped"/>
            </StackPanel>
            <WrapPanel>
                <configviews:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategySbmSettingsView DataContext="{Binding StrategySbmSettingsViewModel}" />
                <vm:StrategySbmSettingsMethodsView DataContext="{Binding StrategySbmSettingsMethodsViewModel}" />
                <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
