<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="520"
             xmlns:vm="using:CryptoScanner.Analyzers.Bre.Config"
             x:DataType="vm:StrategyBreSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Bre.Config.StrategyBreSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- Donchian band lookback -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Donchian lookback for the outer bands, computed over the PREVIOUS N candles (Pine default 20).">
                <TextBlock Grid.Column="0" Text="Band length:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BandLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Outer band multiplier -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Outer band multiplier: middle ± halfRange × (mult / 2.5) (Pine default 3.2). Higher = wider bands = fewer signals.">
                <TextBlock Grid.Column="0" Text="Band multiplier:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding OuterMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- WGHM trend filter -->
            <CheckBox IsChecked="{Binding UseTrendFilter, Mode=TwoWay}"
                      Content="Use WGHM trend filter (Hull MA)" FontSize="12"
                      ToolTip.Tip="When on, a long also requires close above the Hull MA and a short requires close below it. The WGHM line is drawn on the chart when enabled."/>

            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Hull MA length for the WGHM trend filter (Pine default 55).">
                <TextBlock Grid.Column="0" Text="WGHM (HMA) length:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding HmaLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- RSI confluence (overbought/oversold LEVELS come from the Indicators tab → RSI) -->
            <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                      Content="Require RSI overbought/oversold" FontSize="12"
                      ToolTip.Tip="Only fire a short on an upper-band break when RSI ≥ overbought, and a long on a lower-band break when RSI ≤ oversold. The overbought/oversold levels are taken from the Indicators tab (RSI settings)."/>

            <!-- Stochastic OS/OB gate -->
            <CheckBox IsChecked="{Binding RequireStochOsOb, Mode=TwoWay}"
                      Content="Require Stochastic oversold/overbought" FontSize="12"
                      ToolTip.Tip="When on, a long signal also requires Stochastic to be oversold and a short signal requires Stochastic to be overbought (uses the global Stoch thresholds)."/>

            <!-- Stacking rule -->
            <CheckBox IsChecked="{Binding AllowStack, Mode=TwoWay}"
                      Content="Allow stacked signals on a stronger break (HYPE style)" FontSize="12"
                      ToolTip.Tip="When on, a new signal fires on every higher High / lower Low while price keeps stretching beyond the band. When off only the first candle of a break run fires."/>

            <!-- Hand the signal's own (percentage based) stop-loss to the trader -->
            <CheckBox IsChecked="{Binding UseStopLoss, Mode=TwoWay}"
                      Content="Use stop-loss" FontSize="12"
                      ToolTip.Tip="When on, the signal passes the band-width percentage (the chart label) as stop-loss to the trader. When off, no stop-loss is handed over (null) and the trader uses its default percentage stop-loss."/>

            <!-- Multi-timeframe consensus count -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Number of consecutive higher timeframes that must also confirm a band break. 0 = single-timeframe (normal). Example: 1 means the next higher TF must also show a break.">
                <TextBlock Grid.Column="0" Text="TF consensus count:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TimeframeConsensusCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Only if lux 5m at the configured threshold -->
            <Grid ColumnDefinitions="Auto,*,80,Auto" RowDefinitions="Auto"
                  ToolTip.Tip="Long needs Lux5mValue ≤ -threshold; short needs Lux5mValue ≥ +threshold. 50 = previous default; raise toward 100 for stricter signals.">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding OnlyIfLux5m, Mode=TwoWay}"
                          Content="Only if lux 5m at"
                          VerticalAlignment="Center"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Lux5mPercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="8,0,4,0"
                         IsEnabled="{Binding OnlyIfLux5m}"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                <CheckBox IsChecked="{Binding CheckTrendPrimaryDirection, Mode=TwoWay}"
                          Content="Trade with the primary trend"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding TrendPrimaryDirectionCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         IsEnabled="{Binding CheckTrendPrimaryDirection}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                <CheckBox IsChecked="{Binding CheckTrendSecondaryDirection, Mode=TwoWay}"
                          Content="Trade with the secondary trend"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding TrendSecondaryDirectionCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         IsEnabled="{Binding CheckTrendSecondaryDirection}"/>
            </Grid>

            <CheckBox IsChecked="{Binding CheckPriceAboveMa200, Mode=TwoWay}"
                      Content="Check price above/below MA200"
                      FontSize="12"
                      ToolTip.Tip="Long: only fire when price is above MA200. Short: only fire when price is below MA200."/>
            <Grid ColumnDefinitions="Auto,8,80,16,Auto,8,80" Margin="24,0,0,0"
                  IsEnabled="{Binding CheckPriceAboveMa200}">
                <TextBlock Grid.Column="0" Text="Min distance %"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Ma200MinDistancePercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         ToolTip.Tip="Minimum distance from MA200 as percentage (0 = disabled)."/>
                <TextBlock Grid.Column="4" Text="Confirm candles"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="6"
                         Text="{Binding Ma200ConfirmationCandles, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         ToolTip.Tip="Number of preceding candles that must also close on the correct side of MA200 (0 = disabled)."/>
            </Grid>

            <!-- Zone confirmation (OR over enabled types) -->
            <CheckBox IsChecked="{Binding UseDlzZone, Mode=TwoWay}"
                      Content="Require DLZ zone rejection"
                      FontSize="12"
                      ToolTip.Tip="Only fire when the candle was rejected at a DLZ zone."/>
            <CheckBox IsChecked="{Binding UseFvgZone, Mode=TwoWay}"
                      Content="Require FVG zone rejection"
                      FontSize="12"
                      ToolTip.Tip="Only fire when the candle was rejected at an FVG zone."/>
            <CheckBox IsChecked="{Binding UseSmcZone, Mode=TwoWay}"
                      Content="Require SMC zone rejection"
                      FontSize="12"
                      ToolTip.Tip="Only fire when the candle was rejected at an SMC order block."/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
