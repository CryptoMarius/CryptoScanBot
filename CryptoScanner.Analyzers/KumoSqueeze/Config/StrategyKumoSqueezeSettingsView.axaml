<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.KumoSqueeze.Config"
             x:DataType="vm:StrategyKumoSqueezeSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.KumoSqueeze.Config.StrategyKumoSqueezeSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- Squeeze settings -->
            <TextBlock Text="Bollinger Squeeze" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="BB squeeze max %:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BbSqueezeMaxPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Squeeze min candles:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SqueezeMinCandles, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Separator Margin="0,4"/>

            <!-- Ichimoku settings -->
            <TextBlock Text="Ichimoku Cloud" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Tenkan period:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TenkanPeriod, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Kijun period:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding KijunPeriod, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Senkou Span B period:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SenkouBPeriod, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Separator Margin="0,4"/>

            <!-- Optional filters -->
            <TextBlock Text="Optional Filters" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                      Content="RSI direction filter (above/below 50)"
                      FontSize="12"/>

            <CheckBox IsChecked="{Binding UseTenkanKijunFilter, Mode=TwoWay}"
                      Content="Tenkan/Kijun cross filter"
                      FontSize="12"/>

            <CheckBox IsChecked="{Binding UseVolumeFilter, Mode=TwoWay}"
                      Content="Volume spike filter"
                      FontSize="12"/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto" IsVisible="{Binding UseVolumeFilter}">
                <TextBlock Grid.Column="0" Text="Volume multiplier:" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding VolumeMultiplier, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto" IsVisible="{Binding UseVolumeFilter}">
                <TextBlock Grid.Column="0" Text="Volume SMA length:" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding VolumeSmaLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <CheckBox IsChecked="{Binding UseMacdFilter, Mode=TwoWay}"
                      Content="MACD histogram direction filter"
                      FontSize="12"/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto" IsVisible="{Binding UseMacdFilter}">
                <TextBlock Grid.Column="0" Text="MACD confirm candles:" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding MacdConfirmCandles, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
