<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="260"
             xmlns:vm="using:CryptoScanner.Analyzers.AtrRb.Config"
             x:DataType="vm:StrategyAtrRbSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.AtrRb.Config.StrategyAtrRbSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- EMA/ATR length (band basis) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="EMA/ATR length used for the band basis (Pine default 20).">
                <TextBlock Grid.Column="0" Text="Length (EMA/ATR):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Length, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Macro outer-band multiplier -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Macro outer-band multiplier: basis ± ATR × OuterMult (the wide cloud; Pine ≈ 4.2). Higher = wider bands = fewer signals.">
                <TextBlock Grid.Column="0" Text="Outer mult:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding OuterMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Inner ribbon multiplier (chart only) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Inner ribbon multiplier: basis ± ATR × InnerMult. Affects only the chart ribbon, not the signal (default 1.0).">
                <TextBlock Grid.Column="0" Text="Inner mult (chart):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding InnerMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Break lookback -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="The break must be the lowest Low (long) / highest High (short) within this trailing number of bars (avoids label/signal spam). Pine default 5.">
                <TextBlock Grid.Column="0" Text="Break lookback (bars):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BreakLookback, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Hand the signal's own (percentage based) stop-loss to the trader -->
            <CheckBox IsChecked="{Binding UseStopLoss, Mode=TwoWay}"
                      Content="Use stop-loss" FontSize="12"
                      ToolTip.Tip="When on, the signal passes its own percentage based stop-loss to the trader. When off, no stop-loss is handed over (null) and the trader uses its default percentage stop-loss."/>

            <!-- Stop-loss ATR factor -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Multiplier on the ATR for the stop-loss distance: SL distance = factor × ATR(Length). Default 2.0 (the original 2× ATR). Typical values: 1, 2, 2.5, 3.">
                <TextBlock Grid.Column="0" Text="Stop-loss ATR factor:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding StopLossAtrFactor, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Bollinger-band width gate (min) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Minimum Bollinger-band width (BB% = 100 × (upper/lower − 1)) for a break to be flagged. 0 disables the lower bound. Applies to both the signal and the chart labels.">
                <TextBlock Grid.Column="0" Text="BB width min %:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BBMinPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Bollinger-band width gate (max) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Maximum Bollinger-band width (BB% = 100 × (upper/lower − 1)) for a break to be flagged. 0 disables the upper bound. Applies to both the signal and the chart labels.">
                <TextBlock Grid.Column="0" Text="BB width max %:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BBMaxPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- RSI OS/OB gate -->
            <CheckBox IsChecked="{Binding RequireRsiOsOb, Mode=TwoWay}"
                      Content="Require RSI oversold/overbought" FontSize="12"
                      ToolTip.Tip="When on, a long signal also requires RSI to be oversold and a short signal requires RSI to be overbought (uses the global RSI thresholds)."/>

            <!-- Stochastic OS/OB gate -->
            <CheckBox IsChecked="{Binding RequireStochOsOb, Mode=TwoWay}"
                      Content="Require Stochastic oversold/overbought" FontSize="12"
                      ToolTip.Tip="When on, a long signal also requires Stochastic to be oversold and a short signal requires Stochastic to be overbought (uses the global Stoch thresholds)."/>

            <!-- Multi-timeframe consensus count -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Number of consecutive higher timeframes that must also confirm a band break. 0 = single-timeframe (normal). Example: 1 means the next higher TF must also show a break.">
                <TextBlock Grid.Column="0" Text="TF consensus count:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TimeframeConsensusCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Only if lux 5m at the configured threshold -->
            <Grid ColumnDefinitions="Auto,*,80,Auto" RowDefinitions="Auto"
                  ToolTip.Tip="Long needs Lux5mValue ≤ -threshold; short needs Lux5mValue ≥ +threshold. 50 = previous default; raise toward 100 for stricter signals.">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding OnlyIfLux5m, Mode=TwoWay}"
                          Content="Only if lux 5m at"
                          VerticalAlignment="Center"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Lux5mPercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="8,0,4,0"
                         IsEnabled="{Binding OnlyIfLux5m}"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                <CheckBox IsChecked="{Binding CheckTrendPrimaryDirection, Mode=TwoWay}"
                          Content="Trade with the primary trend"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding TrendPrimaryDirectionCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         IsEnabled="{Binding CheckTrendPrimaryDirection}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
                <CheckBox IsChecked="{Binding CheckTrendSecondaryDirection, Mode=TwoWay}"
                          Content="Trade with the secondary trend"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding TrendSecondaryDirectionCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         IsEnabled="{Binding CheckTrendSecondaryDirection}"/>
            </Grid>

            <CheckBox IsChecked="{Binding CheckPriceAboveMa200, Mode=TwoWay}"
                      Content="Check price above/below MA200"
                      FontSize="12"
                      ToolTip.Tip="Long: only fire when price is above MA200. Short: only fire when price is below MA200."/>
            <Grid ColumnDefinitions="Auto,8,80,16,Auto,8,80" Margin="24,0,0,0"
                  IsEnabled="{Binding CheckPriceAboveMa200}">
                <TextBlock Grid.Column="0" Text="Min distance %"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Ma200MinDistancePercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         ToolTip.Tip="Minimum distance from MA200 as percentage (0 = disabled)."/>
                <TextBlock Grid.Column="4" Text="Confirm candles"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="6"
                         Text="{Binding Ma200ConfirmationCandles, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
                         ToolTip.Tip="Number of preceding candles that must also close on the correct side of MA200 (0 = disabled)."/>
            </Grid>

            <!-- Zone confirmation (OR over enabled types) -->
            <CheckBox IsChecked="{Binding UseDlzZone, Mode=TwoWay}"
                      Content="Require DLZ zone rejection"
                      FontSize="12"
                      ToolTip.Tip="Only fire when the candle was rejected at a DLZ zone."/>
            <CheckBox IsChecked="{Binding UseFvgZone, Mode=TwoWay}"
                      Content="Require FVG zone rejection"
                      FontSize="12"
                      ToolTip.Tip="Only fire when the candle was rejected at an FVG zone."/>
            <CheckBox IsChecked="{Binding UseSmcZone, Mode=TwoWay}"
                      Content="Require SMC zone rejection"
                      FontSize="12"
                      ToolTip.Tip="Only fire when the candle was rejected at an SMC order block."/>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
