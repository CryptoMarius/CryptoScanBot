<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="260"
             xmlns:vm="using:CryptoScanner.Analyzers.AtrRb.Config"
             x:DataType="vm:StrategyAtrRbSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.AtrRb.Config.StrategyAtrRbSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- EMA/ATR length (band basis) -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="EMA/ATR length used for the band basis (Pine default 20).">
                <TextBlock Grid.Column="0" Text="Length (EMA/ATR):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Length, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Macro outer-band multiplier -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Macro outer-band multiplier: basis ± ATR × OuterMult (the wide cloud; Pine ≈ 4.2). Higher = wider bands = fewer signals.">
                <TextBlock Grid.Column="0" Text="Outer mult:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding OuterMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Break lookback -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="The break must be the lowest Low (long) / highest High (short) within this trailing number of bars (avoids label/signal spam). Pine default 5.">
                <TextBlock Grid.Column="0" Text="Break lookback (bars):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BreakLookback, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Hand the signal's own (percentage based) stop-loss to the trader -->
            <CheckBox IsChecked="{Binding UseStopLoss, Mode=TwoWay}"
                      Content="Use stop-loss" FontSize="12"
                      ToolTip.Tip="When on, the signal passes its own percentage based stop-loss to the trader. When off, no stop-loss is handed over (null) and the trader uses its default percentage stop-loss."/>

            <!-- Stop-loss ATR factor -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Multiplier on the ATR for the stop-loss distance: SL distance = factor × ATR(Length). Default 2.0 (the original 2× ATR). Typical values: 1, 2, 2.5, 3.">
                <TextBlock Grid.Column="0" Text="Stop-loss ATR factor:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding StopLossAtrFactor, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Filter on BB% (minimum and maximum band width, 0 disables that side) -->
            <Grid ColumnDefinitions="Auto,80,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Minimum and maximum Bollinger-band width (BB% = 100 × (upper/lower − 1)) for a break to be flagged. A bound of 0 disables that side. Applies to both the signal and the chart labels.">
                <TextBlock Grid.Column="0" Text="Filter on BB%:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BBMinPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding BBMaxPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- RSI OS/OB gate -->
            <CheckBox IsChecked="{Binding RequireRsiOsOb, Mode=TwoWay}"
                      Content="Require RSI oversold/overbought" FontSize="12"
                      ToolTip.Tip="When on, a long signal also requires RSI to be oversold and a short signal requires RSI to be overbought (uses the global RSI thresholds)."/>

            <!-- Stochastic OS/OB gate -->
            <CheckBox IsChecked="{Binding RequireStochOsOb, Mode=TwoWay}"
                      Content="Require Stochastic oversold/overbought" FontSize="12"
                      ToolTip.Tip="When on, a long signal also requires Stochastic to be oversold and a short signal requires Stochastic to be overbought (uses the global Stoch thresholds)."/>

            <!-- Band break confirmation on higher timeframes -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Number of consecutive higher timeframes that must show the same band break. 0 = this timeframe only. Example: 1 means the next higher timeframe has to break its band as well. Missing indicator data on a higher timeframe counts as no confirmation.">
                <TextBlock Grid.Column="0" Text="Band break confirmation on higher timeframes:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BandBreakConfirmationCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Separator Margin="0,4"/>

            <!-- The candle that breaks the band: how big and how busy it may be (the rule of dbr) -->
            <TextBlock Text="Candle limits" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Skip the signal when the candle that breaks the band is more than N times as tall (high minus low) as the average of the previous candles. 0 = no limit.">
                <TextBlock Grid.Column="0" Text="Maximum candle size (times the average):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding MaxCandleSizeRatio, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Skip the signal when the candle that breaks the band has more than N times the average volume of the previous candles. 0 = no limit.">
                <TextBlock Grid.Column="0" Text="Maximum candle volume (times the average):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding MaxCandleVolumeRatio, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="The number of candles before the breaking one that the maximum size and volume are measured against. 20 is the default measured on dbr.">
                <TextBlock Grid.Column="0" Text="Average over N candles:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding CandleAverageLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="What to do when the candle is over the maximum size: 0 skips the signal, 1.0 keeps it and places the entry one whole candle height beyond the close (a long buys lower, a short sells higher). Needs the entry order type to be Limit.">
                <TextBlock Grid.Column="0" Text="Entry retracement on a large candle:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding LargeCandleRetracementPart, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
