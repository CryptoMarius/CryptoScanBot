<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.AtrRb.Config"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyAtrRbTabViewModel"
             x:Class="CryptoScanner.Analyzers.AtrRb.Config.StrategyAtrRbTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="ATR-RB – ATR Range Breakout" FontWeight="SemiBold"/>
                    <Run Text=" — Breakout signals when price pierces ATR-based bands" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
                <TextBlock Text="Wiki ↗" FontSize="12" Cursor="Hand"
                           Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                           TextDecorations="Underline" Tapped="OnWikiTapped"/>
            </StackPanel>
            <WrapPanel>
                <settings:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategyAtrRbSettingsView DataContext="{Binding StrategyAtrRbSettingsViewModel}" />
                <settings:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
