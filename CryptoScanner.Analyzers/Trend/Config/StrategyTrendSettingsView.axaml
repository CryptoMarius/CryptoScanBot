<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="200"
             xmlns:vm="using:CryptoScanner.Analyzers.Trend.Config"
             x:DataType="vm:StrategyTrendSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Trend.Config.StrategyTrendSettingsView">

    <StackPanel Spacing="8">

        <HeaderedContentControl Classes="groupbox" Header="Entry">
            <StackPanel Margin="4" Spacing="4">

                <CheckBox IsChecked="{Binding InvertDirection, Mode=TwoWay}"
                          Content="Invert the direction" FontSize="12"
                          ToolTip.Tip="Arm the long on a flip to bearish and the short on a flip to bullish. The pullback entry after that is unchanged, so an inverted long buys the bounce."/>

            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Exit">
            <StackPanel Margin="4" Spacing="4">

                <CheckBox IsChecked="{Binding ExitOnTrendRevert, Mode=TwoWay}"
                          Content="Exit when the trend reverts" FontSize="12"
                          ToolTip.Tip="Leave as soon as the trend stands against the position: bearish under a long, bullish under a short. Off leaves the position to the global stop loss and take profit."/>

            </StackPanel>
        </HeaderedContentControl>

    </StackPanel>

</UserControl>
