<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="520"
             xmlns:vm="using:CryptoScanner.Analyzers.FvgLadder.Config"
             x:DataType="vm:StrategyFvgLadderSettingsViewModel"
             x:CompileBindings="True"
             x:Class="CryptoScanner.Analyzers.FvgLadder.Config.StrategyFvgLadderSettingsView">

    <!-- The groups and captions of FvgLadderSettings, in the same order (the Photino tab is built from that class). -->
    <WrapPanel>

        <HeaderedContentControl Classes="groupbox" Header="General">
            <StackPanel Margin="4" Spacing="4">
                <Grid ColumnDefinitions="180,110,*" RowDefinitions="Auto"
                      ToolTip.Tip="The coins the strategy trades (base asset), separated by a comma, e.g. BTC, ETH. Empty means every coin the strategy is switched on for.">
                    <TextBlock Grid.Column="0" Text="Coins:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding Coins, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <!-- Max positions per coin is a Trader setting since 24-10-2026 (Trading.MaxPositionsPerCoin) -->
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Trend">
            <StackPanel Margin="4" Spacing="4">
                <CheckBox IsChecked="{Binding UseKalmanFilter, Mode=TwoWay}" Content="Use Kalman filter" FontSize="12"
                          ToolTip.Tip="Off: a new position only while the day close is above the EMA200 (1d). On: only while the Kalman filter on the strategy's interval (normally 1h) points up."/>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Entry">
            <StackPanel Margin="4" Spacing="4">
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Gaps narrower than this, (top - bottom) / bottom, are ignored. The scanner zones have to be calculated with a minimum at or below this (FVG configuration).">
                    <TextBlock Grid.Column="0" Text="Minimum gap %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding MinimumGapPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Only the nearest this many gaps below the price can get the entry order, the rest is ignored.">
                    <TextBlock Grid.Column="0" Text="Gaps in view:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding GapsInView, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The buy limit on the gap top is placed once the price is at most this far above it. It stays until it fills, the trend goes, the gap closes or a higher gap becomes the target.">
                    <TextBlock Grid.Column="0" Text="Place order within %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding PlaceOrderWithinPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="DCA">
            <StackPanel Margin="4" Spacing="4">
                <CheckBox IsChecked="{Binding UseDca, Mode=TwoWay}" Content="Use DCA" FontSize="12"
                          ToolTip.Tip="Buy more when the price falls further. Off: every position is one buy."/>
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Number of DCA's:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding MaxDca, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="A DCA lies at least this far under the previous buy. A new position lies at least this far under the last buy of the lowest open position (also without DCA).">
                    <TextBlock Grid.Column="0" Text="DCA step %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding DcaStepPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="When a gap top lies between the step and this far under the previous buy, the DCA goes on that top.">
                    <TextBlock Grid.Column="0" Text="DCA on a gap up to %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding DcaFvgMaxPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Each DCA is this many times the previous buy: 2 gives 100 / 200 / 400.">
                    <TextBlock Grid.Column="0" Text="DCA size factor:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding DcaFactor, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Take profit">
            <StackPanel Margin="4" Spacing="4">
                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Above the break-even price of the whole position, fees included. Moves with every DCA.">
                    <TextBlock Grid.Column="0" Text="Take profit %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding TakeProfitPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>
            </StackPanel>
        </HeaderedContentControl>

    </WrapPanel>
</UserControl>
