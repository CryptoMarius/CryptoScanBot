<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="280"
             xmlns:vm="using:CryptoScanner.Analyzers.Stobb.Config"
             x:DataType="vm:StrategyStobbSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Stobb.Config.StrategyStobbSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">
            
            <!-- Filter on BB% -->
            <Grid ColumnDefinitions="Auto,80,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Filter on BB%:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                
                <TextBox Grid.Column="1" 
                         Text="{Binding BbMinPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" 
                         FontSize="12" 
                         Padding="6,2" 
                         CornerRadius="4"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,8,0"/>
                
                <TextBox Grid.Column="2" 
                         Text="{Binding BbMaxPercentage, Mode=TwoWay, StringFormat=N2}" 
                         Height="26" 
                         FontSize="12" 
                         Padding="6,2" 
                         CornerRadius="4"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Calculate BB oversold/overbought via low/high -->
            <CheckBox IsChecked="{Binding UseLowHigh, Mode=TwoWay}"
                      Content="Calculate BB oversold/overbought via low/high instead of open/close"
                      FontSize="12"/>

            <!-- With RSI oversold/overbought conditions -->
            <CheckBox IsChecked="{Binding IncludeRsi, Mode=TwoWay}"
                      Content="With RSI oversold/overbought conditions"
                      FontSize="12"/>

            <!-- With SBM conditions MA-lines -->
            <CheckBox IsChecked="{Binding IncludeSbmMaLines, Mode=TwoWay}"
                      Content="With SBM conditions MA-lines"
                      FontSize="12"/>

            <!-- With SBM conditions percentages/crossings -->
            <CheckBox IsChecked="{Binding IncludeSbmPercAndCrossing, Mode=TwoWay}"
                      Content="With SBM conditions percentages/crossings"
                      FontSize="12"/>

            <!-- Only if a previous signal exists -->
            <CheckBox IsChecked="{Binding OnlyIfPreviousStobb, Mode=TwoWay}"
                      Content="Only if a previous signal exists"
                      FontSize="12"/>

            <!-- Only if lux 5m at the configured threshold -->
            <Grid ColumnDefinitions="Auto,*,80,Auto" RowDefinitions="Auto"
                  ToolTip.Tip="Long needs Lux5mValue ≤ -threshold; short needs Lux5mValue ≥ +threshold. 50 = previous default; raise toward 100 for stricter signals.">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding OnlyIfLux5m, Mode=TwoWay}"
                          Content="Only if lux 5m at"
                          VerticalAlignment="Center"
                          FontSize="12"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Lux5mPercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="8,0,4,0"
                         IsEnabled="{Binding OnlyIfLux5m}"/>
                <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center" FontSize="12"/>
            </Grid>

			<Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
				<CheckBox IsChecked="{Binding CheckTrendPrimaryDirection, Mode=TwoWay}"
						  Content="Trade with the primary trend"
						  FontSize="12"/>
				<TextBox Grid.Column="2"
						 Text="{Binding TrendPrimaryDirectionCount, Mode=TwoWay}"
						 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
						 IsEnabled="{Binding CheckTrendPrimaryDirection}"/>
			</Grid>

			<Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto">
				<CheckBox IsChecked="{Binding CheckTrendSecondaryDirection, Mode=TwoWay}"
						  Content="Trade with the secondary trend"
						  FontSize="12"/>
				<TextBox Grid.Column="2"
						 Text="{Binding TrendSecondaryDirectionCount, Mode=TwoWay}"
						 Height="26" FontSize="12" Padding="6,2" CornerRadius="4"
						 IsEnabled="{Binding CheckTrendSecondaryDirection}"/>
			</Grid>

			<!-- Zone confirmation (OR over enabled types) -->
			<CheckBox IsChecked="{Binding UseDlzZone, Mode=TwoWay}"
					  Content="Require DLZ zone rejection"
					  FontSize="12"
					  ToolTip.Tip="Only fire when the candle was rejected at a DLZ zone (same logic as the StobbDlz strategy)."/>
			<CheckBox IsChecked="{Binding UseFvgZone, Mode=TwoWay}"
					  Content="Require FVG zone rejection"
					  FontSize="12"
					  ToolTip.Tip="Only fire when the candle was rejected at an FVG zone (same logic as the StobbFvg strategy)."/>
			<CheckBox IsChecked="{Binding UseSmcZone, Mode=TwoWay}"
					  Content="Require SMC zone rejection"
					  FontSize="12"
					  ToolTip.Tip="Only fire when the candle was rejected at an SMC order block (same logic as the StobbSmc strategy)."/>

		</StackPanel>
    </HeaderedContentControl>

</UserControl>
