<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.Stobb.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyStobbTabViewModel"
             x:Class="CryptoScanner.Analyzers.Stobb.Config.StrategyStobbTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <TextBlock Margin="4,2,4,4" FontSize="13">
                <Run Text="STOBB – Stochastic + Bollinger Bands" FontWeight="SemiBold"/>
                <Run Text=" — Mean reversion signals combining Stochastic with Bollinger Band position" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </TextBlock>
            <configviews:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
            <vm:StrategyStobbSettingsView DataContext="{Binding StrategyStobbSettingsViewModel}" />
            <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
