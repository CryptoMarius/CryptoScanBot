<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             xmlns:vm="using:CryptoScanner.Analyzers.Choch.Config"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyChochTabViewModel"
             x:Class="CryptoScanner.Analyzers.Choch.Config.StrategyChochTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="CHOCH - Change of Character" FontWeight="SemiBold"/>
                    <Run Text=" &#8212; Fires when the ZigZag structure changes character; the pullback variants wait for an opposite pivot and a break through it" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
            </StackPanel>
            <WrapPanel>
                <settings:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategyChochSettingsView DataContext="{Binding StrategyChochSettingsViewModel}" />
                <settings:IntervalView DataContext="{Binding IntervalViewModel}" />
                <settings:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
