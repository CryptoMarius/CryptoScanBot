<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="620"
             xmlns:vm="using:CryptoScanner.Analyzers.Mac.Config"
             x:DataType="vm:StrategyMacSettingsViewModel"
             x:CompileBindings="True"
             x:Class="CryptoScanner.Analyzers.Mac.Config.StrategyMacSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <!-- Two columns: seventeen settings under each other made the box taller than the window.
             The split sits where the subject changes - the cloud on the left, everything that
             filters or ends a trade on the right. -->
        <Grid ColumnDefinitions="Auto,16,Auto" RowDefinitions="Auto">
            <StackPanel Grid.Column="0" Margin="4" Spacing="4" VerticalAlignment="Top">

                <!-- The four entries, each a different idea: a level that gives way, the turn of the
                     cloud itself, a pullback to the fast line, and the second line crossing the
                     third, which happens before the cloud turns. -->
                <TextBlock Text="Entry trigger" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <!-- The four markers the strategy draws, and whether each one opens a position.
                     Only the first is on: it is the one the indicator itself calls an entry. The
                     other three are reproduced on the candle but what they EARN is unmeasured. -->
                <CheckBox IsChecked="{Binding EntryOnOpenMarker, Mode=TwoWay}"
                          Content="Entry on Open Long / Open Short" FontSize="12"
                          ToolTip.Tip="The fast line crossing the second. This is the marker the strategy draws as the entry itself."/>

                <CheckBox IsChecked="{Binding EntryOnCrossMarker, Mode=TwoWay}"
                          Content="Entry on Cross Up / Cross Down" FontSize="12"
                          ToolTip.Tip="The second line crossing the third. It fires before the cloud has turned, so it is earlier than the entry marker and not confirmed by it."/>

                <CheckBox IsChecked="{Binding EntryOnCloseMarker, Mode=TwoWay}"
                          Content="Entry on Close Long / Close Short" FontSize="12"
                          ToolTip.Tip="The close crossing back through the second line. the strategy draws it to close the opposite position, so as an entry it is deliberately counter-trend."/>

                <CheckBox IsChecked="{Binding EntryOnBreakMarker, Mode=TwoWay}"
                          Content="Entry on Breakout / Breakdown" FontSize="12"
                          ToolTip.Tip="The close beyond the level with the wick past the hundred candles before it. A follow-through marker rather than an entry of its own."/>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="At most this many break entries between one entry and the next. three is the most this ever draws.">
                    <TextBlock Grid.Column="0" Text="Breakout entries per position:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding BreakoutEntriesPerRun, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Separator Margin="0,4"/>

                <!-- The cloud: four moving averages give the direction (fast above second is up) and
                     the strength (how far the outer two are apart). -->
                <TextBlock Text="Cloud" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <!-- the strategy has exactly one setting and all it does is move three
                     of the four lengths. The four numbers below count only on Custom; choosing a
                     speed does not write them. -->
                <Grid ColumnDefinitions="180,110,*" RowDefinitions="Auto"
                      ToolTip.Tip="The three speeds. Standard is 20/40/50/150, Fast is 20/30/40/80, Slow is 20/50/100/200. Choose Custom to use the four numbers below.">
                    <TextBlock Grid.Column="0" Text="Line speed:" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Speeds}"
                              SelectedItem="{Binding Speed, Mode=TwoWay}"
                              Height="26" FontSize="12" HorizontalAlignment="Stretch"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The fast line, EMA(20) on the close. Counts only when the speed is Custom. The four lengths belong together.">
                    <TextBlock Grid.Column="0" Text="Fast EMA:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding FastEmaLength, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The second line, EMA(40) on the close. The fast line crossing this one is the cross trigger.">
                    <TextBlock Grid.Column="0" Text="Second EMA:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SecondEmaLength, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The third line, SMA(50) on the close.">
                    <TextBlock Grid.Column="0" Text="Medium SMA:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MediumSmaLength, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The slow line, SMA(150) on the close, whose slope drives the trend filter.">
                    <TextBlock Grid.Column="0" Text="Slow SMA:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SlowSmaLength, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <CheckBox IsChecked="{Binding RequirePriceOutsideCloud, Mode=TwoWay}"
                          Content="Price outside the cloud" FontSize="12"
                          ToolTip.Tip="The candle has to close above all four lines for a long, under all four for a short. Applies to the breakout trigger only - at a cross the price is on the cloud."/>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="How far the top and bottom of the cloud have to be apart at the signal candle, as a percentage of the price. Zero accepts any width, including a flat market.">
                    <TextBlock Grid.Column="0" Text="Minimum cloud width %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MinimumCloudWidthPercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <CheckBox IsChecked="{Binding RequireCloudWidening, Mode=TwoWay}"
                          Content="Cloud must be widening" FontSize="12"
                          ToolTip.Tip="The cloud has to be wider than on the candle before, so the trend is gaining strength rather than running out of it."/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="4" Spacing="4" VerticalAlignment="Top">

                <!-- The slow line says how much weight the other signals deserve, so it is a filter
                     and not a trigger of its own. -->
                <TextBlock Text="Slow line" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,2"/>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="How far the slow line has to have moved over the lookback, as a percentage of its own value, in the direction of the trade. Zero switches the check off.">
                    <TextBlock Grid.Column="0" Text="Minimum slope %:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MinimumSlowLineSlopePercentage, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="160,80,*" RowDefinitions="Auto" Margin="20,0,0,0"
                      ToolTip.Tip="Over how many candles the movement of the slow line is measured. Changing this rebuilds the indicator, like the line lengths do.">
                    <TextBlock Grid.Column="0" Text="Lookback candles:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SlowLineLookbackCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Separator Margin="0,4"/>

                <!-- Support and resistance: the pivots the break is measured against. A pivot is only
                     confirmed once its right-hand candles are in, so the level always predates the break. -->
                <TextBlock Text="Support and resistance" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="How many candles to the left have to be lower than the pivot candle.">
                    <TextBlock Grid.Column="0" Text="Pivot candles left:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding PivotLeftCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="How many candles to the right have to be lower. Also the delay before the level is confirmed, so a break is always against a level that was already there.">
                    <TextBlock Grid.Column="0" Text="Pivot candles right:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding PivotRightCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Length of the RSI the levels are taken from.">
                    <TextBlock Grid.Column="0" Text="RSI length for levels:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding RsiLevelLength, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The RSI level that has to be crossed upwards for the candle's low to become the support.">
                    <TextBlock Grid.Column="0" Text="RSI cross for support:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding RsiLevelSupportCross, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The RSI level that has to be crossed downwards for the candle's high to become the resistance.">
                    <TextBlock Grid.Column="0" Text="RSI cross for resistance:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding RsiLevelResistanceCross, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Separator Margin="0,4"/>

                <!-- The RSI filter the Pro version of the indicator adds. -->
                <TextBlock Text="RSI filter" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                          Content="Use RSI filter" FontSize="12"
                          ToolTip.Tip="Ask the RSI to agree with the entry: at or above the minimum for a long, at or below the maximum for a short."/>

                <Grid ColumnDefinitions="160,80,*" RowDefinitions="Auto" Margin="20,0,0,0"
                      IsVisible="{Binding UseRsiFilter}"
                      ToolTip.Tip="The RSI a long needs at least, on the 0..100 scale.">
                    <TextBlock Grid.Column="0" Text="RSI minimum (long):" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding RsiLongMinimum, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="160,80,*" RowDefinitions="Auto" Margin="20,0,0,0"
                      IsVisible="{Binding UseRsiFilter}"
                      ToolTip.Tip="The RSI a short may have at most, on the 0..100 scale.">
                    <TextBlock Grid.Column="0" Text="RSI maximum (short):" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding RsiShortMaximum, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Separator Margin="0,4"/>

                <!-- Volume against the average before the signal candle: a break nobody trades is a
                     break that does not hold. -->
                <TextBlock Text="Volume" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <CheckBox IsChecked="{Binding UseVolumeFilter, Mode=TwoWay}"
                          Content="Use volume filter" FontSize="12"
                          ToolTip.Tip="The signal candle has to trade at a multiple of the average volume before it."/>

                <Grid ColumnDefinitions="160,80,*" RowDefinitions="Auto" Margin="20,0,0,0"
                      IsVisible="{Binding UseVolumeFilter}"
                      ToolTip.Tip="How many times the average volume the signal candle has to trade.">
                    <TextBlock Grid.Column="0" Text="Volume multiplier:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding VolumeMultiplier, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="160,80,*" RowDefinitions="Auto" Margin="20,0,0,0"
                      IsVisible="{Binding UseVolumeFilter}"
                      ToolTip.Tip="How many candles before the signal candle the average volume is taken over. The signal candle is left out of it.">
                    <TextBlock Grid.Column="0" Text="Average candles:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding VolumeAverageCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Separator Margin="0,4"/>

                <!-- The exit of the idea itself, off by default: the position is left to the stop loss
                     and the take profit first. -->
                <TextBlock Text="Exit" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <CheckBox IsChecked="{Binding ExitOnSecondLineCross, Mode=TwoWay}"
                          Content="Exit on second line cross" FontSize="12"
                          ToolTip.Tip="Leave when the close crosses back through the second line against the position."/>

                <CheckBox IsChecked="{Binding ExitOnCloudFlip, Mode=TwoWay}"
                          Content="Exit on cloud flip" FontSize="12"
                          ToolTip.Tip="Leave when the cloud turns against the position. Stop loss and take profit keep working next to it."/>

                <Grid ColumnDefinitions="160,80,*" RowDefinitions="Auto" Margin="20,0,0,0"
                      IsEnabled="{Binding ExitOnCloudFlip}"
                      ToolTip.Tip="How many closed candles the cloud has to be against the position before it leaves. Zero leaves on the first candle the EMAs cross back.">
                    <TextBlock Grid.Column="0" Text="Exit confirmation candles:" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ExitConfirmationCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

            </StackPanel>
        </Grid>
    </HeaderedContentControl>

</UserControl>
