<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.SrFlip.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategySrFlipTabViewModel"
             x:CompileBindings="True"
             x:Class="CryptoScanner.Analyzers.SrFlip.Config.StrategySrFlipTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="SRFLIP – The support/resistance flip" FontWeight="SemiBold"/>
                    <Run Text=" — A broken level or line is retested from the other side and holds" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
            </StackPanel>
            <WrapPanel>
                <configviews:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategySrFlipSettingsView DataContext="{Binding StrategySrFlipSettingsViewModel}" />
                <configviews:IntervalView DataContext="{Binding IntervalViewModel}" />
                <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
