<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.BbSqueeze.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyBbSqueezeTabViewModel"
             x:Class="CryptoScanner.Analyzers.BbSqueeze.Config.StrategyBbSqueezeTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="BBSQUEEZE – Bollinger Bands Squeeze Breakout" FontWeight="SemiBold"/>
                    <Run Text=" — Breakout after a period of low volatility (BB squeeze), confirmed by MACD/volume" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
            </StackPanel>
            <configviews:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
            <vm:StrategyBbSqueezeSettingsView DataContext="{Binding StrategyBbSqueezeSettingsViewModel}" />
            <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
