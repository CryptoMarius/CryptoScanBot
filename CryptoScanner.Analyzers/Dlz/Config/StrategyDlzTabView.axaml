<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="1000"
             xmlns:vm="using:CryptoScanner.Analyzers.Dlz.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyDlzTabViewModel"
             x:Class="CryptoScanner.Analyzers.Dlz.Config.StrategyDlzTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="5">
        <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
            <TextBlock FontSize="13">
                <Run Text="DLZ – Dominant Liquidity Zones" FontWeight="SemiBold"/>
                <Run Text=" — Signals near historically dominant support/resistance zones" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </TextBlock>
            <TextBlock Text="Wiki ↗" FontSize="12" Cursor="Hand"
                       Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                       TextDecorations="Underline" Tapped="OnWikiTapped"/>
        </StackPanel>
        <WrapPanel>
            <configviews:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
            <HeaderedContentControl Classes="groupbox" Header="Zone calculation" HorizontalAlignment="Left"
									 IsVisible="false">
                <configviews:IndicatorZigZagView DataContext="{Binding IndicatorZigZagViewModel}" />
            </HeaderedContentControl>
            <vm:StrategyDlzSettingsView DataContext="{Binding StrategyDlzSettingsViewModel}" />
            <vm:StrategyDlzSettingsZoneStrengthView DataContext="{Binding StrategyDlzSettingsViewModel}" />
            <vm:StrategyDlzSettingsZoneFilterView DataContext="{Binding StrategyDlzSettingsZoneFilterViewModel}" />
            <vm:StrategyDlzSettingsUnzoomedBoxView DataContext="{Binding StrategyDlzSettingsUnzoomedBoxViewModel}" />
            <vm:StrategyDlzSettingsZoomedBoxView DataContext="{Binding StrategyDlzSettingsZoomedBoxViewModel}" />
            <configviews:IntervalView DataContext="{Binding IntervalViewModel}" />
            <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </WrapPanel>
    </StackPanel>
    </ScrollViewer>

</UserControl>
