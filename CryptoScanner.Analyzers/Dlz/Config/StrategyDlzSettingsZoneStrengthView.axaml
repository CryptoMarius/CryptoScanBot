<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="180"
             xmlns:vm="using:CryptoScanner.Analyzers.Dlz.Config"
             x:DataType="vm:StrategyDlzSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Dlz.Config.StrategyDlzSettingsZoneStrengthView">

    <HeaderedContentControl Classes="groupbox" Header="Zone strength filter">
        <StackPanel Margin="8" Spacing="8">

            <!-- Near zone percentage (Stobb/StoRsi + DLZ) -->
            <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Near zone percentage:" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" Text="{Binding NearZonePercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Max touches before zone is considered exhausted (0 = disabled) -->
            <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Max touches (0=off):" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" Text="{Binding MaxTouches, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- How far price has to come in before it counts as a visit; the one knob that differs
                 per zone kind - see CryptoZoneTouchLevel. -->
            <Grid ColumnDefinitions="Auto,*,110" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Touch level:" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding TouchLevels}"
                          SelectedItem="{Binding TouchLevel, Mode=TwoWay}"
                          Height="26" FontSize="12" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Rejection lookback (candles) -->
            <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Rejection lookback:" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" Text="{Binding RejectionLookback, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Disqualify zones after they crossed the 50% midpoint (ICT CE) -->
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Close zones past the midpoint:" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding CloseZonesPastMidpoint, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
