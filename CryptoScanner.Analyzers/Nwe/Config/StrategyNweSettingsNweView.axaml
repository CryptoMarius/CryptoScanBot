<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="290" d:DesignHeight="120"
             xmlns:vm="using:CryptoScanner.Analyzers.Nwe.Config"
             x:DataType="vm:StrategyNweSettingsNweViewModel"
             x:Class="CryptoScanner.Analyzers.Nwe.Config.StrategyNweSettingsNweView">

    <HeaderedContentControl Classes="groupbox" Header="Settings Nadaraya Watson Envelope">
        <StackPanel Margin="8" Spacing="8">

            <!-- Filter on BB% (own pair since 26-09-2026, open point 109) -->
            <Grid ColumnDefinitions="Auto,80,80,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" Text="Filter on BB%:" VerticalAlignment="Center"
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1" Text="{Binding BbMinPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBox Grid.Column="2" Text="{Binding BbMaxPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Was hard-wired until 26-09-2026 (open point 75c) -->
            <CheckBox IsChecked="{Binding RequireRecentStobbOrStorsi, Mode=TwoWay}"
                      Content="Require a stobb or storsi condition in the last 10 candles" FontSize="12"
                      ToolTip.Tip="On is what every run so far measured: a nwe signal only fires when a stobb or storsi condition occurred somewhere in the last ten candles. Off drops that requirement."/>

            <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto, Auto" RowSpacing="2">
                <!-- BandWidth -->
                <TextBlock Grid.Column="0" Text="BandWidth:" VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="2" Text="{Binding BandWidth, Mode=TwoWay}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                
                <!-- Multiplication -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Multiplication:" VerticalAlignment="Center" 
                           Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Multiplication, Mode=TwoWay}" 
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
