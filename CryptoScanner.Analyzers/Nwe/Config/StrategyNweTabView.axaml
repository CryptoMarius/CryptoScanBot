<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.Nwe.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyNweTabViewModel"
             x:Class="CryptoScanner.Analyzers.Nwe.Config.StrategyNweTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="NWE – Nadaraya-Watson Envelope" FontWeight="SemiBold"/>
                    <Run Text=" — Counter-trend reversal signals at statistical price extremes" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
                <TextBlock Text="Wiki ↗" FontSize="12" Cursor="Hand"
                           Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                           TextDecorations="Underline" Tapped="OnWikiTapped"/>
            </StackPanel>
            <WrapPanel>
                <configviews:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategyNweSettingsNweView DataContext="{Binding StrategyNweSettingsNweViewModel}" />
                <vm:StrategyNweSettingsView DataContext="{Binding StrategyNweSettingsViewModel}" />
                <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
