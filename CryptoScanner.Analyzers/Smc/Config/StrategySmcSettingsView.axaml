<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="560"
             xmlns:vm="using:CryptoScanner.Analyzers.Smc.Config"
             x:DataType="vm:StrategySmcSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Smc.Config.StrategySmcSettingsView">

    <StackPanel Orientation="Horizontal" Spacing="8">

        <HeaderedContentControl Classes="groupbox" Header="Detector (base + expansion)" VerticalAlignment="Top">
            <StackPanel Margin="8" Spacing="8">

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Average window (candles):" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding AverageWindow, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Base max range factor:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding BaseMaxRangeFactor, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Expansion min range factor:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding ExpansionMinRangeFactor, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Expansion body fraction:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding ExpansionBodyFraction, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Strong expansion factor:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding StrongExpansionFactor, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Base max candles:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding BaseMaxCandles, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Max blocks per interval:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding MaxBlocksPerInterval, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto"
                      ToolTip.Tip="Tightens the detector toward classical ICT/SMC: the last base candle must have the opposite color of the impulse (bearish before a bullish BOS for a long zone). Default off keeps the broader supply/demand behaviour.">
                    <TextBlock Grid.Column="0" Text="Require opposite base colour:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <CheckBox Grid.Column="2" IsChecked="{Binding RequireOppositeBaseColor, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Classes="groupbox" Header="Signal (entry)" VerticalAlignment="Top">
            <StackPanel Margin="8" Spacing="8">

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Max touches (0=off):" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding MaxTouches, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- How far price has to come in before it counts as a visit; the one knob that differs
                     per zone kind - see CryptoZoneTouchLevel. -->
                <Grid ColumnDefinitions="Auto,*,110" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Touch level:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding TouchLevels}"
                              SelectedItem="{Binding TouchLevel, Mode=TwoWay}"
                              Height="26" FontSize="12" HorizontalAlignment="Stretch"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Close zones past the midpoint:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <CheckBox Grid.Column="2" IsChecked="{Binding CloseZonesPastMidpoint, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,80" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Rejection lookback (smc.rejection):" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding RejectionLookback, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0" Text="Only strong zones:" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontSize="12"/>
                    <CheckBox Grid.Column="2" IsChecked="{Binding OnlyStrong, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </HeaderedContentControl>

    </StackPanel>

</UserControl>
