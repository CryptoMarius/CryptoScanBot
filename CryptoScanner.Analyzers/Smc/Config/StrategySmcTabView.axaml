<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             xmlns:vm="using:CryptoScanner.Analyzers.Smc.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategySmcTabViewModel"
             x:Class="CryptoScanner.Analyzers.Smc.Config.StrategySmcTabView">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="5">
            <TextBlock Margin="4,2,4,4" FontSize="13">
                <Run Text="SMC – Smart Money Concepts" FontWeight="SemiBold"/>
                <Run Text=" — Supply/demand zone entry signals based on base + expansion detection" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </TextBlock>
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="5" HorizontalAlignment="Left">
                <configviews:SoundAndColorsView Grid.Row="0" Grid.Column="0" DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategySmcSettingsView Grid.Row="1" Grid.Column="0" DataContext="{Binding StrategySmcSettingsViewModel}" />
                <configviews:IntervalView Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" DataContext="{Binding IntervalViewModel}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            </Grid>
            <configviews:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
