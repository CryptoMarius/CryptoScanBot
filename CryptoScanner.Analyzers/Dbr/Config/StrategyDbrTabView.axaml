<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             xmlns:vm="using:CryptoScanner.Analyzers.Dbr.Config"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyDbrTabViewModel"
             x:Class="CryptoScanner.Analyzers.Dbr.Config.StrategyDbrTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <TextBlock Margin="4,2,4,4" FontSize="13">
                <Run Text="DBR – Donchian Band Reversion" FontWeight="SemiBold"/>
                <Run Text=" — Mean reversion signals at Donchian channel extremes" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </TextBlock>
            <settings:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
            <vm:StrategyDbrSettingsView DataContext="{Binding StrategyDbrSettingsViewModel}" />
            <settings:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
