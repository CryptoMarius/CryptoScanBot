<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="520"
             xmlns:vm="using:CryptoScanner.Analyzers.Dbr.Config"
             x:DataType="vm:StrategyDbrSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Dbr.Config.StrategyDbrSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- Donchian band lookback -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Donchian lookback for the outer bands, computed over the PREVIOUS N candles (Pine default 20).">
                <TextBlock Grid.Column="0" Text="Band length:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BandLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Outer band multiplier -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Outer band multiplier: middle ± halfRange × (mult / 2.5) (Pine default 3.2). Higher = wider bands = fewer signals.">
                <TextBlock Grid.Column="0" Text="Band multiplier:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding OuterMult, Mode=TwoWay, StringFormat=N1}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- Filter on BB% (minimum and maximum band width, 0 disables that side) -->
            <Grid ColumnDefinitions="Auto,80,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Minimum and maximum Bollinger-band width (BB% = 100 × (upper/lower − 1)) for a break to be flagged. A bound of 0 disables that side.">
                <TextBlock Grid.Column="0" Text="Filter on BB%:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BbMinPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding BbMaxPercentage, Mode=TwoWay, StringFormat=N2}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <!-- RSI confluence (overbought/oversold LEVELS come from the Indicators tab → RSI) -->
            <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                      Content="Require RSI overbought/oversold" FontSize="12"
                      ToolTip.Tip="Only fire a short on an upper-band break when RSI ≥ overbought, and a long on a lower-band break when RSI ≤ oversold. The overbought/oversold levels are taken from the Indicators tab (RSI settings)."/>

            <!-- Stochastic OS/OB gate -->
            <CheckBox IsChecked="{Binding RequireStochOsOb, Mode=TwoWay}"
                      Content="Require Stochastic oversold/overbought" FontSize="12"
                      ToolTip.Tip="When on, a long signal also requires Stochastic to be oversold and a short signal requires Stochastic to be overbought (uses the global Stoch thresholds)."/>

            <!-- Stacking rule -->
            <CheckBox IsChecked="{Binding AllowStack, Mode=TwoWay}"
                      Content="Allow stacked signals on a stronger break (HYPE style)" FontSize="12"
                      ToolTip.Tip="When on, a new signal fires on every higher High / lower Low while price keeps stretching beyond the band. When off only the first candle of a break run fires."/>

            <!-- Hand the signal's own (percentage based) stop-loss to the trader -->
            <CheckBox IsChecked="{Binding UseStopLoss, Mode=TwoWay}"
                      Content="Use stop-loss" FontSize="12"
                      ToolTip.Tip="When on, the signal passes the band-width percentage (the chart label) as stop-loss to the trader. When off, no stop-loss is handed over (null) and the trader uses its default percentage stop-loss."/>

            <!-- Band break confirmation on higher timeframes -->
            <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Number of consecutive higher timeframes that must show the same band break. 0 = this timeframe only. Example: 1 means the next higher timeframe has to break its band as well. Missing indicator data on a higher timeframe counts as no confirmation.">
                <TextBlock Grid.Column="0" Text="Band break confirmation on higher timeframes:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BandBreakConfirmationCount, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
