<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="320"
             xmlns:vm="using:CryptoScanner.Analyzers.CandlePattern.Config"
             xmlns:configviews="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyCandlePatternSettingsViewModel"
             x:CompileBindings="True"
             x:Class="CryptoScanner.Analyzers.CandlePattern.Config.StrategyCandlePatternSettingsView">

    <HeaderedContentControl Classes="groupbox" Header="Settings">
        <StackPanel Margin="4" Spacing="4">

            <!-- Which shapes to fire on. Several at once is an OR, hence checkboxes and not a
                 dropdown; the order is the order of the enum, which decides which one a candle
                 forming two shapes is reported as. -->
            <TextBlock Text="Patterns" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <configviews:CandlePatternListView DataContext="{Binding PatternListViewModel}"
                          ToolTip.Tip="The reversal shapes this strategy fires on. Ticking several is an OR: any one of them is enough. With nothing ticked the strategy produces no signals."/>

            <Separator Margin="0,4"/>

            <!-- How much the price has to have run the other way before the shape counts -->
            <TextBlock Text="Preceding move" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="How many candles of movement AGAINST the trade have to precede the pattern. A reversal needs something to reverse; zero switches the requirement off.">
                <TextBlock Grid.Column="0" Text="Preceding candles:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding PrecedingCandles, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="How far price has to have moved over those candles. Zero means any move in the right direction counts.">
                <TextBlock Grid.Column="0" Text="Preceding move %:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding PrecedingPercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Separator Margin="0,4"/>

            <!-- How large the decisive candle is against the candles before it, and the trend EMA -->
            <TextBlock Text="Size and trend" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="The body of the decisive candle at least this many times the average body of the 20 candles before it. For three methods the first and the last candle both. Zero switches it off.">
                <TextBlock Grid.Column="0" Text="Min size vs average:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding MinSizeFactor, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBlock Grid.Column="2" Text="x average body" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
            </Grid>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Only fire when the close is above an EMA of this length (long) or below it (short). Zero switches it off. Meant for continuation shapes such as three methods.">
                <TextBlock Grid.Column="0" Text="Trend EMA length:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TrendEmaLength, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

            <Separator Margin="0,4"/>

            <!-- A stop-loss beyond the pattern, with the take profit at a multiple of its distance -->
            <TextBlock Text="Exit" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <CheckBox IsChecked="{Binding StopBeyondPattern, Mode=TwoWay}" Content="Stop-loss beyond the pattern" FontSize="12"
                      ToolTip.Tip="Hand the trader a stop-loss beyond the pattern: under its lowest low (long) or above its highest high (short); for three methods beyond the first candle. Off keeps the stop-loss and take profit of the trader settings."/>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                  IsEnabled="{Binding StopBeyondPattern}"
                  ToolTip.Tip="The take profit at this many times the stop-loss distance. Zero keeps the take profit of the trader settings.">
                <TextBlock Grid.Column="0" Text="Risk/reward:" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding RiskReward, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                <TextBlock Grid.Column="2" Text="x the stop distance" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
            </Grid>

            <Separator Margin="0,4"/>

            <!-- Only fire when the pattern candle touches a zone. Ticking several is an OR, so the
                 boxes sit on one row: three of them do not need a column of their own. -->
            <TextBlock Text="Zone" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

            <StackPanel Orientation="Horizontal" Spacing="12"
                        ToolTip.Tip="Only fire when the pattern candle touches a zone of the same side. Tick nothing to switch the requirement off. The zone intervals under Signal.Zones* must be filled, otherwise there are no zones and nothing fires.">
                <TextBlock Text="Require zone:" VerticalAlignment="Center" FontSize="12" Width="168"/>
                <CheckBox IsChecked="{Binding RequireDlz, Mode=TwoWay}" Content="Dlz" FontSize="12"/>
                <CheckBox IsChecked="{Binding RequireFvg, Mode=TwoWay}" Content="Fvg" FontSize="12"/>
                <CheckBox IsChecked="{Binding RequireSmc, Mode=TwoWay}" Content="Smc" FontSize="12"/>
            </StackPanel>

            <Grid ColumnDefinitions="180,80,*" RowDefinitions="Auto"
                  ToolTip.Tip="Room around the zone, as a percentage. Zero means strictly between Bottom and Top.">
                <TextBlock Grid.Column="0" Text="Zone tolerance %:" VerticalAlignment="Center" FontSize="12"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ZoneTolerancePercentage, Mode=TwoWay}"
                         Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
            </Grid>

        </StackPanel>
    </HeaderedContentControl>

</UserControl>
