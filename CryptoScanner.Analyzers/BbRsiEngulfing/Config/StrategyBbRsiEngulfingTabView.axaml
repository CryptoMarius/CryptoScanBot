<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             xmlns:vm="using:CryptoScanner.Analyzers.BbRsiEngulfing.Config"
             xmlns:settings="using:CryptoScanner.Config.Views"
             x:DataType="vm:StrategyBbRsiEngulfingTabViewModel"
             x:Class="CryptoScanner.Analyzers.BbRsiEngulfing.Config.StrategyBbRsiEngulfingTabView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Margin="4,2,4,4" Spacing="8">
                <TextBlock FontSize="13">
                    <Run Text="BBRSIENGULFING - Bollinger Band + RSI + engulfing candle" FontWeight="SemiBold"/>
                    <Run Text=" &#8212; The previous candle closes outside the Bollinger band with RSI at its extreme, and the next one engulfs it" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </TextBlock>
            </StackPanel>
            <WrapPanel>
                <settings:SoundAndColorsView DataContext="{Binding SoundAndColorsViewModel}" />
                <vm:StrategyBbRsiEngulfingSettingsView DataContext="{Binding StrategyBbRsiEngulfingSettingsViewModel}" />
                <settings:IntervalView DataContext="{Binding IntervalViewModel}" />
                <settings:StrategyEntryConditionsView DataContext="{Binding StrategyEntryConditionsViewModel}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
