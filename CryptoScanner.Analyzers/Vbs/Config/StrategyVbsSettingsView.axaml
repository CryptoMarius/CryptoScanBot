<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="540"
             xmlns:vm="using:CryptoScanner.Analyzers.Vbs.Config"
             x:DataType="vm:StrategyVbsSettingsViewModel"
             x:Class="CryptoScanner.Analyzers.Vbs.Config.StrategyVbsSettingsView">

    <StackPanel Spacing="8">

        <HeaderedContentControl Classes="groupbox" Header="Mean Reversion Bands (VWAP volume-weighted)">
            <StackPanel Margin="4" Spacing="4">

                <!-- VWMA / vw-stdev length -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="VWMA / volume-weighted-stdev window for the VWAP basis (fit ≈ 50).">
                    <TextBlock Grid.Column="0" Text="Length (VWAP/vw-stdev):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding Length, Mode=TwoWay}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- vw-stdev multiplier -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Volume-weighted-stdev multiplier: basis ± Mult × vwStdev (the VWAP-band width; fit ≈ 2.5). Higher = wider band = fewer signals.">
                    <TextBlock Grid.Column="0" Text="Multiplier (vw-stdev):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding Mult, Mode=TwoWay, StringFormat=N2}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- Filter on BB% (minimum and maximum band width, 0 disables that side) -->
                <Grid ColumnDefinitions="Auto,80,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Minimum and maximum Bollinger-band width (BB% = 100 × (upper/lower − 1)) for a signal to fire. A bound of 0 disables that side.">
                    <TextBlock Grid.Column="0" Text="Filter on BB%:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding BbMinPercentage, Mode=TwoWay, StringFormat=N2}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="2" Text="{Binding BbMaxPercentage, Mode=TwoWay, StringFormat=N2}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <!-- RSI confluence (overbought/oversold LEVELS come from the Indicators tab → RSI) -->
                <CheckBox IsChecked="{Binding UseRsiFilter, Mode=TwoWay}"
                          Content="Require RSI overbought/oversold" FontSize="12"
                          ToolTip.Tip="Only fire a short on an upper-band break when RSI ≥ overbought, and a long on a lower-band break when RSI ≤ oversold. The overbought/oversold levels are taken from the Indicators tab (RSI settings)."/>

                <!-- Stochastic OS/OB gate -->
                <CheckBox IsChecked="{Binding RequireStochOsOb, Mode=TwoWay}"
                          Content="Require Stochastic oversold/overbought" FontSize="12"
                          ToolTip.Tip="When on, a long signal also requires Stochastic to be oversold and a short signal requires Stochastic to be overbought (uses the global Stoch thresholds)."/>

                <!-- Band break confirmation on higher timeframes -->
                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Number of consecutive higher timeframes that must show the same band break. 0 = this timeframe only. Example: 1 means the next higher timeframe has to break its band as well. Missing indicator data on a higher timeframe counts as no confirmation.">
                    <TextBlock Grid.Column="0" Text="Band break confirmation on higher timeframes:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding BandBreakConfirmationCount, Mode=TwoWay}" Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Separator Margin="0,4"/>

                <!-- The candle that breaks the band: how big and how busy it may be (the rule of dbr) -->
                <TextBlock Text="Candle limits" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>

                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Skip the signal when the candle that breaks the band is more than N times as tall (high minus low) as the average of the previous candles. 0 = no limit.">
                    <TextBlock Grid.Column="0" Text="Maximum candle size (times the average):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MaxCandleSizeRatio, Mode=TwoWay, StringFormat=N1}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="Skip the signal when the candle that breaks the band has more than N times the average volume of the previous candles. 0 = no limit.">
                    <TextBlock Grid.Column="0" Text="Maximum candle volume (times the average):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MaxCandleVolumeRatio, Mode=TwoWay, StringFormat=N1}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="The number of candles before the breaking one that the maximum size and volume are measured against. 20 is the default measured on dbr.">
                    <TextBlock Grid.Column="0" Text="Average over N candles:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding CandleAverageLength, Mode=TwoWay}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,80,*" RowDefinitions="Auto"
                      ToolTip.Tip="What to do when the candle is over the maximum size: 0 skips the signal, 1.0 keeps it and places the entry one whole candle height beyond the close (a long buys lower, a short sells higher). Needs the entry order type to be Limit.">
                    <TextBlock Grid.Column="0" Text="Entry retracement on a large candle:" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding LargeCandleRetracementPart, Mode=TwoWay, StringFormat=N2}"
                             Height="26" FontSize="12" Padding="6,2" CornerRadius="4"/>
                </Grid>

            </StackPanel>
        </HeaderedContentControl>

    </StackPanel>

</UserControl>
